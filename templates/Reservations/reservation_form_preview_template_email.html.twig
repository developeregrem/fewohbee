<form id="template-form" role="form"
      data-controller="reservations"
      data-action="submit->reservations#sendEmailAction"
      data-url="{{ path('correspondence.email.send') }}"
      data-refresh-url="{{ path('reservations.get.reservation', {'id': attribute(reservations, 0).id, 'tab': 'correspondence'}) }}">
    <fieldset id="template-form-fieldset-primary-">
        {% set mail = "" %}
        {% for address in attribute(reservations, 0).booker.customerAddresses %}
            {% if address.email|length > 0 %}{% set mail = address.email %}{% endif %}
        {% endfor %}
        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <label for="template-to" class="form-label">{{ 'templates.recipient'|trans }} *</label>
                <input type="email" class="form-control" id="template-to" name="to" value="{{ emailDraft.to|default(mail) }}" required>
            </div>
            <div class="col-12 col-lg-6">
                <label for="template-subject" class="form-label">{{ 'templates.subject'|trans }} *</label>
                <input type="text" class="form-control" id="template-subject" name="subject"
                       value="{{ emailDraft.subject|default(templateSubject|default('')) }}" required>
            </div>
            <div class="col-12">
                <textarea name="msg" id="editor1" rows="10" cols="70">{{ emailDraft.msg is defined and emailDraft.msg is not empty ? emailDraft.msg : templateOutput|raw }}</textarea>
            </div>
        </div>
    </fieldset>
    <div class="d-flex align-items-center mt-4 mb-2">
        <h2 class="small text-uppercase fw-semibold text-body-secondary mb-0 me-auto">{{ 'templates.attachment'|trans }}</h2>
        <a href="#" class="btn btn-sm btn-outline-primary text-nowrap"
           data-action="click->reservations#selectTemplateForReservationsAction"
           data-url="{{ path('reservations.select.template') }}"
           data-template-id="{{ template.id }}"
           data-inprocess="true">
            <i class="fas fa-plus me-1"></i> {{ 'button.add'|trans }}</a>
    </div>
    {% if attachments is not empty %}
        <ul class="list-group">
            {% for attachment in attachments %}
                <li class="list-group-item d-flex align-items-center gap-2" id="aid-{{ attachment.id }}">
                    <i class="fas {{ attachment.template.templateType.icon }} fa-fw text-body-secondary" aria-hidden="true" title="{{ attachment.template.templateType.name|trans }}"></i>
                    <span class="me-auto text-break">{{ attachment.name }}</span>
                    <a href="#" class="btn btn-sm btn-link text-body-secondary"
                       data-action="click->reservations#exportPDFCorrespondenceAction"
                       data-url="{{ path('correspondence.export.pdf', {'id': attachment.id}) }}"
                       title="{{ 'button.download'|trans }}" aria-label="{{ 'button.download'|trans }}"><i class="fas fa-download"></i></a>
                    <a href="#" class="btn btn-sm btn-link text-danger"
                       data-action="click->reservations#deleteAttachmentAction"
                       data-url="{{ path('correspondence.attachment.remove') }}"
                       data-attachment-id="{{ attachment.id }}"
                       title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}"><i class="fas fa-trash-alt"></i></a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    <input name="_csrf_token" value="{{ token }}" type="hidden">
    <input name="templateId" value="{{ template.id }}" type="hidden">
</form>
