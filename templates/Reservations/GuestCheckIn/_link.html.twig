{# Hand out the check-in link: one menu for the link, the QR code and a new link. The link is
   fetched on demand (guest-checkin controller), so it never sits in the page for users who may
   not pass it on. What the entries open is in _link_output.html.twig. #}
<div class="dropdown">
    <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fas fa-link me-1"></i>{{ 'guest_checkin.tab.link_menu'|trans }}
    </button>
    <ul class="dropdown-menu">
        <li><button type="button" class="dropdown-item" data-action="guest-checkin#showLink"><i class="fas fa-link fa-fw me-1"></i>{{ 'guest_checkin.tab.show_link'|trans }}</button></li>
        <li><button type="button" class="dropdown-item" data-action="guest-checkin#showQr"><i class="fas fa-qrcode fa-fw me-1"></i>{{ 'guest_checkin.tab.show_qr'|trans }}</button></li>
        <li><hr class="dropdown-divider"></li>
        <li><button type="button" class="dropdown-item" data-bs-toggle="collapse" data-bs-target="#guest-checkin-regenerate-{{ reservation.id }}"><i class="fas fa-rotate fa-fw me-1"></i>{{ 'guest_checkin.tab.regenerate'|trans }}</button></li>
    </ul>
</div>
