{# Outcome of a check-in: confirmed online (the guest records hold the data now) or done at the desk. #}
<dl class="row small mb-3">
    <dt class="col-sm-4 fw-normal text-body-secondary">{{ 'guest_checkin.tab.room_now'|trans }}</dt>
    <dd class="col-sm-8">
        {{ reservation.customers|map(guest => (guest.firstname ~ ' ' ~ guest.lastname)|trim)|join(', ') ?: '–' }}
        {# The arrival time rides along behind the names, a dash when none is known #}
        <span class="text-body-secondary text-nowrap ms-2" title="{{ 'reservation.arrivalTime'|trans }}"><i class="far fa-clock me-1" aria-hidden="true"></i><span class="visually-hidden">{{ 'reservation.arrivalTime'|trans }} </span>{{ reservation.arrivalTime ? reservation.arrivalTime|date('H:i') : '–' }}</span>
    </dd>
</dl>
<div class="d-flex flex-wrap align-items-center gap-2">
    {% if is_granted('ROLE_RESERVATIONS') or is_granted('ROLE_OPERATIONS') %}
        <a class="btn btn-sm btn-primary" href="{{ path('correspondence.registration.download', {'id': reservation.id}) }}" target="_blank" rel="noopener">
            <i class="fas fa-print me-1"></i>{{ 'guest_checkin.tab.registration_print'|trans }}
        </a>
    {% endif %}
</div>
