{# Prototype: hard-coded origin colors until ReservationOrigin gets its own color field.
   Known portals are matched by name substring; unknown origins fall back to a fixed palette by id. #}
{% macro originColor(origin) %}
{%- if origin is not null -%}
    {%- set name = origin.name|lower -%}
    {%- if 'airbnb' in name -%}
        #FF5A5F
    {%- elseif 'booking' in name -%}
        #003580
    {%- elseif 'expedia' in name -%}
        #FBCC33
    {#- check fewo-direkt before privat/direkt so it does not match as direct booking -#}
    {%- elseif 'fewo-direkt' in name or 'fewo direkt' in name or 'vrbo' in name or 'homeaway' in name -%}
        #245ABC
    {%- elseif 'privat' in name or 'direkt' in name -%}
        #6C757D
    {%- else -%}
        {%- set palette = ['#0D9488', '#7C3AED', '#DB2777', '#D97706', '#65A30D', '#0284C7', '#9F1239', '#4B5563'] -%}
        {{- palette[origin.id % palette|length] -}}
    {%- endif -%}
{%- endif -%}
{% endmacro %}
