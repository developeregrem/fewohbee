<div data-controller="reservations" data-preview-url="{{ path('reservations.create.preview') }}">
<div class="modal-body">
    <div class="px-lg-5">
        <div id="flash-message-overlay">
            <div class="col"></div>
        </div>
        <h2 class="reservation-section-title mb-2">{{ 'reservation.customer'|trans }}</h2>
        {# Field and search side by side; adding a guest below on phones, in the same row on wider screens #}
        <div class="row g-2 align-items-end">
            <div class="col">
                <input type="text" class="form-control" id="lastname" name="lastname"
                       placeholder="{{ 'reservation.select.customer.search.input.placeholder'|trans }}"
                       data-reservations-customer-search="true">
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" type="button" data-action="click->reservations#getCustomersAction" data-page="1"
                        title="{{ 'nav.customer.search'|trans }}">
                    <i class="fas fa-search"></i><span class="d-none d-lg-inline"> {{ 'nav.customer.search'|trans }}</span>
                </button>
            </div>
            <div class="col-12 col-sm-auto">
                <button class="btn btn-outline-primary w-100" type="button" data-action="click->reservations#getFormForNewCustomerAction">
                    <i class="fas fa-plus"></i> {{ 'nav.customer.add'|trans }}
                </button>
            </div>
        </div>
        <div class="mt-4">
            <form id="customer-selection"
                  data-action="submit->reservations#createNewCustomerAction"
                  data-url="{{ path('reservations.get.customer.create') }}">
                <div id="customers"
                     data-customers-url="{{ path('reservations.get.customers') }}"
                     data-customer-new-form-url="{{ path('reservations.get.customer.new.form') }}">
                    {% if customer %}
                        <p class="text-body-secondary">{{ 'reservation.custumer.selected'|trans }} {{ customer.firstname }} {{ customer.lastname }}</p>
                    {% endif %}
                </div>
                <input type="submit" value="{{ 'button.save'|trans }}" class="btn btn-primary float-end mt-3 d-none"/>
            </form>
        </div>
    </div>
</div>
<div id="createNewCustomerFooter" class="modal-footer">
    <a class="btn btn-link me-auto px-0 text-decoration-none" href="#"
       data-action="click->reservations#selectAppartmentAction"
       data-reservations-create-new="false"
       data-url="{{ path('reservations.select.appartment') }}">&larr; {{ 'button.back'|trans }}</a>
    {% if customer %}
        <button type="button" class="btn btn-primary text-truncate mw-100"
                data-action="click->reservations#reservationPreviewAction" data-customer-id="{{ customer.id }}">
            {{ 'button.continue.with'|trans }} {{ customer.firstname }} {{ customer.lastname }} &rarr;
        </button>
    {% endif %}
</div>
</div>
