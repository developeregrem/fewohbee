{# Persons of a reservation split by guest category, e.g. "(2×E, 1×K)"; empty without counts. #}
{% macro guest_counts(reservation, guestCategoriesById) -%}
    {% set counts = reservation.guestCounts %}
    {% if counts is not empty and guestCategoriesById is not empty %}
        {# Iterate categories (already in sortOrder) so the breakdown
           renders in the same order regardless of the JSON key order
           in guestCounts. #}
        {% set parts = [] %}
        {% for catId, cat in guestCategoriesById %}
            {% set count = counts[catId]|default(0) %}
            {% if count > 0 %}
                {% set parts = parts|merge([count ~ '×' ~ cat.acronym]) %}
            {% endif %}
        {% endfor %}
        {% if parts is not empty %}
            <span class="text-muted small">({{ parts|join(', ') }})</span>
        {% endif %}
    {% endif %}
{%- endmacro %}

{# Content of a delete popover (enableDeletePopover in assets/js/utils.js) for routes that check
   the session's _csrf_token rather than a 'delete'-id token: the form is sent as DELETE. #}
{% macro delete_popover_form(url, fields, confirmLabel) -%}
    <form action="{{ url }}">
        <div class="text-center">
            <a class="btn btn-danger btn-sm popover-delete">{{ confirmLabel }}</a>
            <a class="btn btn-secondary btn-sm popover-cancel">{{ 'button.cancel'|trans }}</a>
        </div>
        {% for name, value in fields %}
            <input type="hidden" name="{{ name }}" value="{{ value }}">
        {% endfor %}
    </form>
{%- endmacro %}

{# A phone number as a tel: URL, without the separators people type into it. #}
{% macro tel_href(number) -%}
    tel:{{ number|replace({' ': '', '-': '', '/': '', '(': '', ')': ''}) }}
{%- endmacro %}
