{# Period of the table: first day, paging by the visible days, number of days #}
<div class="input-group flex-nowrap reservations-date">
    <button type="button" class="btn btn-secondary js-shift-date" data-direction="backward"
            title="{{ 'button.back'|trans }}" aria-label="{{ 'button.back'|trans }}">
        <i class="fa-solid fa-arrow-left"></i>
    </button>
    <input type="date" class="form-control" id="start" name="start" value="{{ today|date('Y-m-d') }}"
           aria-label="{{ 'reservation.table.start'|trans }}"/>
    <button type="button" class="btn btn-secondary js-shift-date" data-direction="forward"
            title="{{ 'button.next'|trans }}" aria-label="{{ 'button.next'|trans }}">
        <i class="fa-solid fa-arrow-right"></i>
    </button>
</div>
<div class="input-group flex-nowrap reservations-interval">
    <input type="number" class="form-control" id="interval" name="interval" value="{{ interval }}" min="6" max="180"
           aria-describedby="interval-unit"/>
    <span class="input-group-text" id="interval-unit">{{ 'reservation.days'|trans }}</span>
</div>
{% if is_granted('ROLE_RESERVATIONS') %}
    <button type="button" class="btn btn-icon" data-action="click->reservations#getNewTableAction"
            data-url="{{ path('reservations.get.table') }}"
            title="{{ 'reservation.table.reload'|trans }}" aria-label="{{ 'reservation.table.reload'|trans }}">
        <i class="fas fa-sync-alt" data-reservations-table-spinner></i>
    </button>
{% endif %}
