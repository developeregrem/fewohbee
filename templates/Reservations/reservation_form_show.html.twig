<div data-controller="reservations"
     data-reservations-select-invoice-url="{{ path('invoices.select.reservation') }}">
    <div class="modal-body">
        <div class="container-fluid px-0">
            <div id="flash-message-overlay">
                <div class="col">
                    {% include 'feedback.html.twig' with {'error': error, 'app': app } %}
                </div>
            </div>
            {% include 'Reservations/reservation_form_show_fields.html.twig' with {'mode': 'edit', 'reservationId':  attribute(reservations, 0).id } %}
        </div>
    </div>
    {% if is_granted('ROLE_RESERVATIONS') %}
    {% import 'Reservations/_macros.html.twig' as reservationMacros %}
    {% set reservation = attribute(reservations, 0) %}
    {% set hasBooker = reservation.booker is not null %}
    <div class="modal-footer">
        {% if is_granted('ROLE_INVOICES') %}
        <div class="btn-group dropup">
            <button class="btn btn-secondary dropdown-toggle"
                    type="button"
                    id="dropdownInvoice"
                    {% if hasBooker %}data-bs-toggle="dropdown"{% else %}disabled{% endif %}
                    aria-haspopup="true"
                    aria-expanded="false">
              {{ 'reservation.invoices'|trans }}
            </button>
            <div class="dropdown-menu">
                {% for invoice in reservation.invoices %}
                    <a class="dropdown-item" href="#"
                       data-action="click->reservations#openModalContentAction"
                       data-url="{{ path('invoices.get.invoice', {'id':  invoice.id}) }}"
                       data-title="{{ 'reservation.invoice'|trans }} {{ invoice.number }}">{{ 'reservation.invoice'|trans }} {{ invoice.number }}</a>
                {% endfor %}
                {% if reservation.invoices|length > 0 %}
                <div class="dropdown-divider"></div>
                {% endif %}
                <a class="dropdown-item{% if not hasBooker %} disabled{% endif %}" href="#"
                   {% if hasBooker %}
                   data-action="click->reservations#selectReservationForInvoiceAction"
                   data-url="{{ path('invoices.select.reservation') }}"
                   data-reservation-id="{{ reservation.id }}"
                   {% else %}
                   aria-disabled="true"
                   {% endif %}>{{ 'reservation.button.create.invoice'|trans }}</a>
            </div>
        </div>
        {% endif %}
        {# Opens the confirmation as it would go out; sending happens from there. With several
           addresses the booker's address is picked first, as for the check-in invitation. #}
        {% set confirmationEmails = reservation.booker ? reservation.booker.emails : [] %}
        {% if confirmationEmails|length > 1 %}
            <div class="dropup me-auto">
                <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-paper-plane me-1"></i> {{ 'reservation.confirmation.button'|trans }}
                </button>
                <ul class="dropdown-menu">
                    {% for email in confirmationEmails %}
                        <li><button type="button" class="dropdown-item text-break"
                                    data-action="reservations#openModalContentAction"
                                    data-url="{{ path('reservations.confirmation.preview', {'id': reservation.id, 'email': email}) }}"
                                    data-title="{{ 'reservation.confirmation.title'|trans }}"><i class="fas fa-envelope fa-fw me-1"></i>{{ email }}</button></li>
                    {% endfor %}
                </ul>
            </div>
        {% else %}
            <button type="button" class="btn btn-secondary me-auto"
                    data-action="reservations#openModalContentAction"
                    data-url="{{ path('reservations.confirmation.preview', {'id': reservation.id}) }}"
                    data-title="{{ 'reservation.confirmation.title'|trans }}">
                <i class="fas fa-paper-plane me-1"></i> {{ 'reservation.confirmation.button'|trans }}
            </button>
        {% endif %}
        {# Confirmed in a popover; reservations_controller closes the dialog and reloads the table #}
        <button type="button" class="btn btn-outline-danger ms-auto"
                data-reservation-delete
                data-popover="delete"
                data-bs-placement="top"
                data-title="{{ 'reservation.delete.ask'|trans }}"
                data-bs-content="{{ reservationMacros.delete_popover_form(path('reservations.dodelete.reservation'), {'id': reservation.id, '_csrf_token': token}, 'button.delete'|trans)|e('html_attr') }}">
            <i class="fas fa-trash-alt me-1"></i> {{ 'button.delete'|trans }}
        </button>
        {# Phones close the full screen dialog with the X in its header #}
        <button type="button" class="btn btn-secondary d-none d-lg-inline-block" data-bs-dismiss="modal">{{ 'button.cancel'|trans }}</button>
    </div>
    {% endif %}
</div>
