{% import 'Reservations/_macros.html.twig' as reservationMacros %}
{# Business card and tabs; the wrapper takes no part in the layout (app.css), so the tabs can
   stick to the top of a full screen dialog while the body scrolls. #}
<div class="reservation-head">
    {% if mode is defined and mode == 'edit' %}
        {% include 'Reservations/_reservation_summary.html.twig' with {'reservation': attribute(reservations, 0)} %}
    {% endif %}
    <!-- Nav tabs -->
    <ul class="nav nav-underline flex-nowrap overflow-x-auto text-nowrap border-bottom modal-tabs">
        <li class="nav-item">
            <a class="nav-link{% if tab is defined and tab == 'booker' %} active{% endif %}" href="#reservation" data-bs-toggle="tab">{{ 'reservation.tab.details'|trans }}</a>
        </li>
        <li class="nav-item">
            <a class="nav-link{% if tab is defined and tab == 'guest' %} active{% endif %}" href="#guests" data-bs-toggle="tab" title="{{ 'reservation.preview.customer.inroom'|trans }}">{{ 'reservation.tab.guests'|trans }}</a>
        </li>
        <li class="nav-item">
            {% if booker is defined and booker is not null %}
                <a class="nav-link{% if tab is defined and tab == 'correspondence' %} active{% endif %}" href="#correspondence" data-bs-toggle="tab">{{ 'reservation.correspondences'|trans }}</a>
            {% else %}
                <span class="nav-link disabled text-muted" aria-disabled="true">{{ 'reservation.correspondences'|trans }}</span>
            {% endif %}
        </li>
        <li class="nav-item">
            <a class="nav-link{% if tab is defined and tab == 'prices' %} active{% endif %}" href="#prices" data-bs-toggle="tab">
                {{ 'reservation.prices.title'|trans }}
                {# Invoices are usually created without opening this tab, so a changed price list must show from outside. #}
                {% if priceListChange is defined and priceListChange is not null %}<span class="badge rounded-pill text-bg-info ms-1" title="{{ 'reservation.price.list_changed.title'|trans }}">!</span>{% endif %}
            </a>
        </li>
        {% if guestCheckIn is defined and guestCheckIn %}
        <li class="nav-item">
            <a class="nav-link{% if tab is defined and tab == 'checkin' %} active{% endif %}" href="#guest-checkin" data-bs-toggle="tab">
                {{ 'guest_checkin.tab.label'|trans }}
                {# A submission waiting for review is easy to miss behind the tab. #}
                {% if guestCheckIn.status.value == 'submitted' %}<span class="badge rounded-pill text-bg-primary ms-1" title="{{ 'guest_checkin.status.submitted'|trans }}">1</span>{% endif %}
            </a>
        </li>
        {% endif %}
    </ul>
</div>

<!-- Tab panes -->
<div class="tab-content px-0 py-3 py-lg-4">
    <div class="tab-pane{% if tab is defined and tab == 'booker' %} active{% endif %}" id="reservation" role="tabpanel" aria-labelledby="booker-tab">
        {% if mode is defined and mode == 'edit' %}
            {% include 'Reservations/_reservation_details.html.twig' with {'reservation': attribute(reservations, 0)} %}
        {% else %}
            {# Preview of a new booking: who books, the rooms, and the stay's details as inputs
               (read by the reservations controller when the booking is created) #}
            {% set first = attribute(reservations, 0) %}
            {% set company = null %}
            {% if booker is defined and booker %}
                {% for address in booker.customerAddresses %}
                    {% if company is null and address.type == 'CUSTOMER_ADDRESS_TYPE_BUSINESS' and address.company is not empty %}
                        {% set company = address.company %}
                    {% endif %}
                {% endfor %}
            {% else %}
                {% set booker = null %}
            {% endif %}
            {# One column at every width: sections read top to bottom, wide screens use the width inside them #}
            <section>
                <div class="d-flex align-items-center mb-2">
                    <h2 class="small text-uppercase fw-semibold text-body-secondary me-auto mb-0">{{ 'reservation.preview.booker'|trans }}</h2>
                </div>
                {% if booker %}
                    <div class="fs-5 fw-bold lh-sm text-break">{{ company ?: booker.firstname ~ ' ' ~ booker.lastname }}</div>
                    {% if company %}<div>{{ booker.firstname }} {{ booker.lastname }}</div>{% endif %}
                    <div class="mt-2">{% include 'Reservations/_reservation_guest_data.html.twig' with {'addressColumns': 'row-cols-1 row-cols-lg-2'} %}</div>
                {% else %}
                    {% include 'Reservations/_reservation_guest_data.html.twig' %}
                {% endif %}
            </section>
            <section class="mt-4">
                <div class="d-flex align-items-center mb-2">
                    <h2 class="small text-uppercase fw-semibold text-body-secondary me-auto mb-0">{{ 'reservation.preview.appartments.selected'|trans }}</h2>
                </div>
                <ul class="list-group">
                    {% for reservation in reservations %}
                        <li class="list-group-item">
                            <div class="fw-semibold">{{ reservation.appartment.number }} · {{ reservation.appartment.description }}</div>
                            <div class="small text-body-secondary">
                                {{ reservation.startdate|date('d.m.Y') }} – {{ reservation.enddate|date('d.m.Y') }}
                                · {{ 'reservation.summary.nights'|trans({'%count%': reservation.startdate.diff(reservation.enddate).days}) }}
                                · {{ 'reservation.summary.persons'|trans({'%count%': reservation.persons}) }}
                                {{ reservationMacros.guest_counts(reservation, guestCategoriesById|default({})) }}
                                · {{ reservation.reservationStatus|display_name }}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>

            <section class="mt-4">
                <div class="d-flex align-items-center mb-2">
                    <h2 class="small text-uppercase fw-semibold text-body-secondary me-auto mb-0">{{ 'reservation.details.stay'|trans }}</h2>
                </div>
                <div class="row g-3">
                    <div class="col-6 col-lg-4">
                        <label for="reservation-arrivalTime" class="form-label">{{ 'reservation.arrivalTime'|trans }}</label>
                        <input type="time" id="reservation-arrivalTime" name="arrivalTime" class="form-control"
                               value="{{ first.arrivalTime ? first.arrivalTime|date('H:i') }}">
                    </div>
                    <div class="col-6 col-lg-4">
                        <label for="reservation-departureTime" class="form-label">{{ 'reservation.departureTime'|trans }}</label>
                        <input type="time" id="reservation-departureTime" name="departureTime" class="form-control"
                               value="{{ first.departureTime ? first.departureTime|date('H:i') }}">
                    </div>
                    <div class="col-12 col-lg-4">
                        <label for="reservation-origin" class="form-label">{{ 'reservation.origin'|trans }}</label>
                        <select id="reservation-origin" name="reservation-origin" class="form-select">
                            {% for origin in origins %}
                                <option value="{{ origin.id }}" {% if first.reservationOrigin and origin.id == first.reservationOrigin.id %} selected {% endif %}>
                                    {{ origin.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12">
                        <label for="reservation-remark" class="form-label">{{ 'customer.remark'|trans }}</label>
                        <textarea id="reservation-remark" class="form-control" name="remark" rows="2">{{ first.remark }}</textarea>
                    </div>
                </div>
            </section>
        {% endif %}
        <input id="_csrf_token" name="_csrf_token" value="{{ token }}" type="hidden">

        

    </div>
    <div class="tab-pane{% if tab is defined and tab == 'guest' %} active{% endif %}" id="guests" role="tabpanel" aria-labelledby="guests-tab">
        {% for reservation in reservations %}
            {# In the preview of a new booking, customers are {c, appartmentId} pairs of all rooms #}
            {% set roomGuests = [] %}
            {% for customer in customers %}
                {% if mode is defined and mode == 'new' %}
                    {% if customer.appartmentId == reservation.appartment.id %}
                        {% set roomGuests = roomGuests|merge([customer.c]) %}
                    {% endif %}
                {% else %}
                    {% set roomGuests = roomGuests|merge([customer]) %}
                {% endif %}
            {% endfor %}
            <div class="d-flex align-items-center mb-2{{ loop.first ? '' : ' mt-4' }}">
                <h2 class="small text-uppercase fw-semibold text-body-secondary me-auto mb-0">{{ 'reservation.guests.room'|trans({'%number%': reservation.appartment.number}) }}</h2>
                {% if is_granted('ROLE_RESERVATIONS') %}
                    <a href="#" class="btn btn-sm btn-outline-primary"
                       data-action="click->reservations#changeReservationCustomerAction"
                       data-url="{{ path('reservations.edit.reservation.customer', {'id': reservationId}) }}"
                       data-reservation-id="{{ reservationId }}"
                       data-tab="guest"
                       data-appartment-id="{{ reservation.appartment.id }}">
                        <i class="fas fa-plus me-1"></i> {{ 'button.add'|trans }}
                    </a>
                {% endif %}
            </div>
            {% if roomGuests is empty %}
                <p class="text-body-secondary mb-0">{{ 'reservation.guests.empty'|trans }}</p>
            {% else %}
                <ul class="list-group">
                    {% for customer in roomGuests %}
                        <li class="list-group-item d-flex align-items-center gap-2">
                            <div class="me-auto text-break">
                                <div>{{ customer.salutation }} {{ customer.firstname }} {{ customer.lastname }}</div>
                                {% if customer.birthday %}
                                    <div class="small text-body-secondary">{{ 'customer.birthday'|trans }}: {{ customer.birthday|date('d.m.Y') }}</div>
                                {% endif %}
                            </div>
                            <form id="actions-customer-{{ customer.id }}" class="d-none">
                                <input id="reservation-id" type="hidden" value="{{ reservationId }}" name="reservation-id"/>
                                <input id="customer-id" type="hidden" value="{{ customer.id }}" name="customer-id"/>
                                <input id="tab" type="hidden" value="guest" name="tab"/>
                                <input id="appartmentId" type="hidden" value="{{ reservation.appartment.id }}" name="appartmentId"/>
                                <input name="_csrf_token" value="{{ token }}" type="hidden">
                            </form>
                            {% if is_granted('ROLE_RESERVATIONS') %}
                                <a href="#" class="btn btn-sm btn-link text-body-secondary"
                                   data-action="click->reservations#editReservationCustomerEditAction"
                                   data-customer-id="{{ customer.id }}"
                                   data-form-selector="#actions-customer-{{ customer.id }}"
                                   data-url="{{ path('reservations.edit.customer.edit') }}"
                                   title="{{ 'button.edit'|trans }}" aria-label="{{ 'button.edit'|trans }}">
                                    <i class="fas fa-edit"></i></a>
                                {# Confirmed in a popover; the answer is the dialog again, with the guests tab #}
                                <a href="#" class="btn btn-sm btn-link text-danger"
                                   data-popover="delete"
                                   data-bs-placement="left"
                                   data-delete-target="#modal-content-ajax"
                                   data-title="{{ 'reservation.guests.remove_ask'|trans }}"
                                   data-bs-content="{{ reservationMacros.delete_popover_form(path('reservations.edit.delete.customer'), {
                                       'customer-id': customer.id,
                                       'reservation-id': reservationId,
                                       'tab': 'guest',
                                       'appartmentId': reservation.appartment.id,
                                       '_csrf_token': token,
                                   }, 'reservation.guests.remove'|trans)|e('html_attr') }}"
                                   aria-label="{{ 'reservation.guests.remove'|trans }}">
                                    <i class="fas fa-trash-alt"></i></a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% endfor %}
    </div>
    
    <div class="tab-pane{% if tab is defined and tab == 'correspondence' %} active{% endif %}" id="correspondence" role="tabpanel" aria-labelledby="correspondence-tab">
        <div class="d-flex align-items-center mb-2">
            <h2 class="small text-uppercase fw-semibold text-body-secondary mb-0 me-auto">{{ 'reservation.correspondences.reservation'|trans }}</h2>
            {% if mode is defined and mode == 'edit' and is_granted('ROLE_RESERVATIONS') %}
                <a href="#" class="btn btn-sm btn-outline-primary text-nowrap"
                   data-action="click->reservations#selectReservationForTemplateAction"
                   data-url="{{ path('correspondence.select.reservation') }}"
                   data-reservation-id="{{ reservationId }}"
                   data-create-new="true">
                    <i class="fas fa-plus me-1"></i> {{ 'button.add'|trans }}
                </a>
            {% endif %}
        </div>
        {% if correspondences is empty %}
            <p class="text-body-secondary mb-0">{{ 'reservation.correspondences.empty'|trans }}</p>
        {% else %}
            <ul class="list-group">
                {% for correspondence in correspondences %}
                    <li class="list-group-item d-flex align-items-center gap-2">
                        <i class="fas {{ correspondence.template.templateType.icon }} fa-fw text-body-secondary" aria-hidden="true" title="{{ correspondence.template.templateType.name|trans }}"></i>
                        <div class="me-auto text-break">
                            <div>
                                {{ correspondence.name }}
                                {% if correspondence.children|length > 0 %}<i class="fas fa-paperclip small text-body-secondary ms-1" title="{{ 'templates.attachment'|trans }}"></i>{% endif %}
                            </div>
                            <div class="small text-body-secondary">{{ correspondence.created|date('d.m.Y H:i') }}</div>
                        </div>
                        {% if 'PDF' in correspondence.template.templateType.name %}
                            <a href="#" class="btn btn-sm btn-link text-body-secondary"
                               data-action="click->reservations#exportPDFCorrespondenceAction"
                               data-url="{{ path('correspondence.export.pdf', {'id': correspondence.id}) }}"
                               data-attachment-id="{{ correspondence.id }}"
                               title="{{ 'button.download'|trans }}" aria-label="{{ 'button.download'|trans }}"><i class="fas fa-download"></i></a>
                        {% elseif 'EMAIL' in correspondence.template.templateType.name %}
                            <a href="#" class="btn btn-sm btn-link text-body-secondary"
                               data-action="click->reservations#showMailCorrespondenceAction"
                               data-url="{{ path('correspondence.show', {'id': correspondence.id}) }}"
                               data-reservation-id="{{ reservationId }}"
                               data-correspondence-id="{{ correspondence.id }}"
                               title="{{ 'button.details'|trans }}" aria-label="{{ 'button.details'|trans }}"><i class="fas fa-eye"></i></a>
                        {% endif %}
                        {% if is_granted('ROLE_RESERVATIONS') %}
                            {# Confirmed in a popover; the reservations controller reloads this tab afterwards #}
                            <a href="#" class="btn btn-sm btn-link text-danger"
                               data-correspondence-delete
                               data-popover="delete"
                               data-bs-placement="left"
                               data-title="{{ 'templates.correspondence.delete.ask'|trans }}"
                               data-bs-content="{{ reservationMacros.delete_popover_form(path('correspondence.remove'), {'id': correspondence.id, '_csrf_token': token}, 'button.delete'|trans)|e('html_attr') }}"
                               aria-label="{{ 'button.delete'|trans }}"><i class="fas fa-trash-alt"></i></a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <input id="_csrf_token" name="_csrf_token" value="{{ token }}" type="hidden">
    </div>
    
    <div class="tab-pane{% if tab is defined and tab == 'prices' %} active{% endif %}" id="prices" role="tabpanel" aria-labelledby="prices-tab">
        <div class="row">
            <div class="col">
                <h4 class="pb-2">{{ 'reservation.prices.misc'|trans }}</h4>
            </div>
        </div>
        <div id="reservation-price-misc-options" class="row justify-content-start">
        {% set reservationPrices =  attribute(reservations, 0).prices %}
        {% for price in miscPrices %}
            <div class="col-md-4">
                <form id="update-misc-price-{{ price.id }}" action="{{ path('reservations.update.misc.price', {'reservationId': reservationId, 'id': price.id}) }}">
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" id="customCheck{{ loop.index }}" data-id="{{ price.id }}"
                               data-reservation-id="{{ reservationId }}" {% if existsById(reservationPrices, price) %} checked{% endif %}>
                        <label class="form-check-label" for="customCheck{{ loop.index }}">{{ price.description }}</label>
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('reservation-update-misc-price') }}"/>
                </form>
            </div>
        {% endfor %}
        {% if hasActiveTouristTax|default(false) %}
            <div class="w-100"><hr class="my-3"></div>
            <div class="col-md-6">
                <form id="update-kurtaxe-waived" action="{{ path('reservations.update.kurtaxe.waived', {'reservationId': reservationId}) }}">
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" id="kurtaxe-waived-toggle"
                               data-reservation-id="{{ reservationId }}"
                               {% if attribute(reservations, 0).kurtaxeWaived %} checked{% endif %}>
                        <label class="form-check-label" for="kurtaxe-waived-toggle"
                               title="{{ 'reservation.kurtaxe.waived.help'|trans }}">
                            {{ 'reservation.kurtaxe.waived'|trans }}
                        </label>
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('reservation-update-kurtaxe-waived') }}"/>
                </form>
            </div>
        {% endif %}
        </div>
        <input id="_csrf_token" name="_csrf_token" value="{{ token }}" type="hidden">
        
        <div class="row mt-4">
            <div class="col fs-5 fw-bold ">{{ 'invoice.price.total'|trans }}: {{ brutto|number_format(2, ',', '.') }}</div>
        </div>
        {% if mode is defined and mode == 'edit' and priceListChange is defined and priceListChange is not null %}
            {# Only shown when there is something to decide: the price list changed since the booking. #}
            <div class="alert alert-info d-flex flex-column flex-md-row align-items-md-center gap-2 mt-3 mb-0">
                <div class="me-md-auto">
                    <div class="fw-bold">{{ 'reservation.price.list_changed.title'|trans }}</div>
                    {{ 'reservation.price.list_changed.text'|trans({
                        '%date%': priceListChange.promisedOn|date('d.m.Y'),
                        '%promised%': priceListChange.promised|number_format(2, ',', '.') ~ ' ' ~ currency_symbol,
                        '%current%': priceListChange.current|number_format(2, ',', '.') ~ ' ' ~ currency_symbol,
                    }) }}
                </div>
                {% if is_granted('ROLE_RESERVATIONS') %}
                    <form action="{{ path('reservations.price.reprice', {'id': reservationId}) }}" method="post"
                          data-action="submit->reservations#repriceReservation" class="flex-shrink-0">
                        <input type="hidden" name="_token" value="{{ csrf_token('reservation-reprice-' ~ reservationId) }}">
                        <button type="submit" class="btn btn-sm btn-secondary w-100">{{ 'reservation.price.reprice.confirm'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        {% endif %}
        {# variable that contains the status whether prices are used that includes vat and does not include vats
        this will lead to price sums that are displayed incorrect #}
        {% set lastIncludesVat = null %}
        {% set vatWarning = false %}
        <div class="row mt-4">
            <div class="col">
                <h5>{{ 'invoice.appartment'|trans }}</h5>
                {% include 'Invoices/invoice_table_apartment_preview_positions.html.twig' with {'mode': 'read'} %}
                {# Which price rules or day prices are part of the room price, and on how many nights. #}
                {% import 'PriceRules/_macros.html.twig' as ruleText %}
                {% set ruleNights = {} %}
                {% for rate in nightRates|default([])|filter(rate => rate and rate.adjustment) %}
                    {% if rate.adjustment.dayPriceSource %}
                        {% set ruleLabel = 'reservation.price.day_price'|trans %}
                        {% set ruleNights = ruleNights|merge({(ruleLabel): (ruleNights[ruleLabel] ?? 0) + 1}) %}
                    {% endif %}
                    {% for applied in rate.adjustment.rules %}
                        {% set ruleLabel = applied[0] ~ ' ' ~ ruleText.percent(applied[1]) %}
                        {% set ruleNights = ruleNights|merge({(ruleLabel): (ruleNights[ruleLabel] ?? 0) + 1}) %}
                    {% endfor %}
                {% endfor %}
                {% if ruleNights is not empty %}
                    <p class="small text-body-secondary mb-0">
                        {{ 'reservation.price.rules_applied'|trans }}:
                        {% for ruleLabel, nights in ruleNights %}{{ ruleLabel }} ({{ 'reservation.price.rules_nights'|trans({'%count%': nights}) }}){{ loop.last ? '' : ', ' }}{% endfor %}
                    </p>
                {% endif %}
            </div>
        </div>
            
        {% if positionsMiscellaneous|filter(p => p.positionGroup == 'apartment_modifier')|length > 0 %}
            <div class="row mt-4">
                <div class="col">
                    <h5>{{ 'invoice.apartment_modifier.heading'|trans }}</h5>
                    {% include 'Invoices/invoice_table_apartment_modifier_preview_positions.html.twig' %}
                </div>
            </div>
        {% endif %}

        {% if hasActiveTouristTax|default(false) %}
            <div class="row mt-4">
                <div class="col">
                    <h5>{{ 'invoice.tourist_tax.heading'|trans }}</h5>
                    {% include 'Invoices/invoice_table_tourist_tax_preview_positions.html.twig' %}
                </div>
            </div>
        {% endif %}

        <div class="row mt-4">
            <div class="col">
                <h5>{{ 'invoice.miscellaneous'|trans }}</h5>
                {% include 'Invoices/invoice_table_misc_preview_positions.html.twig' with {'mode': 'read'} %}
            </div>
        </div>
        <div class="row mt-3">
            {# An existing booking keeps its prices, so the invoice starts from exactly these. #}
            <small><span class="text-info me-auto"><i class="fas fa-info-circle"></i> {{ (mode is defined and mode == 'edit' ? 'reservation.prices.invoice_note' : 'reservation.prices.preliminary')|trans }}</span></small>
        </div>
    </div>

    {% if guestCheckIn is defined and guestCheckIn %}
    <div class="tab-pane{% if tab is defined and tab == 'checkin' %} active{% endif %}" id="guest-checkin" role="tabpanel" aria-labelledby="guest-checkin-tab">
        {% include 'Reservations/_guest_checkin_tab.html.twig' with {'reservation': attribute(reservations, 0)} %}
    </div>
    {% endif %}
</div>
