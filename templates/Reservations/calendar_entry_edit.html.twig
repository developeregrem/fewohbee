{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% use "common/delete_popover.html.twig" %}

<div class="modal-body" data-controller="reservations">
    <div id="flash-message-overlay"></div>
    <h6 class="mb-3">{{ isNew ? 'calendar_entry.title_new'|trans : 'calendar_entry.title_edit'|trans }}</h6>

    {% if not isNew %}
        <p class="text-body-secondary small mb-3">
            <i class="fas fa-circle me-1" style="color: {{ calendarEntry.calendar.color }}; font-size: 0.7em; vertical-align: middle;"></i>
            {{ 'calendar_entry.calendar'|trans }}: <strong>{{ calendarEntry.calendar.name }}</strong>
        </p>
    {% endif %}

    {% if not isNew and calendarEntry.confirmedAt %}
        <p class="text-muted small">
            <i class="fas fa-check-circle text-success me-1"></i>
            {{ 'calendar_entry.confirmed_at'|trans({'%datetime%': calendarEntry.confirmedAt|date('d.m.Y H:i')}) }}
        </p>
    {% endif %}

    {% if not isNew and calendarEntry.calendar.hasIcsSource and not calendarEntry.isManuallyCreated and not calendarEntry.confirmedAt %}
        <div class="alert alert-warning small" role="alert">
            <i class="fas fa-triangle-exclamation me-1"></i>
            {{ 'calendar_entry.sync_warning'|trans }}
        </div>
    {% endif %}

    {% set formAction = isNew ? path('reservations.calendar_entry.new') : path('reservations.calendar_entry.edit', {'id': calendarEntry.id}) %}
    {{ form_start(form, {'attr': {'data-action': 'submit->reservations#saveCalendarEntryAction'}, 'action': formAction}) }}
        {# A new entry almost always belongs to the day whose header was
           clicked, so the form asks only for calendar, title and time, and the
           date fields stay behind a link unless they already carry a range or
           an error from a previous submit. The end time appears once a start
           time or an end date is set (calendar_entry_form_controller): on a
           range it belongs to the last day, so "until 14.08. 19:00" needs no
           start time. Editing has neither the calendar picker nor the end date
           and stays on one row. #}
        {% if isNew %}
            {% set showDateFields = form.dateTo.vars.value is not empty or form.date.vars.errors|length > 0 or form.dateTo.vars.errors|length > 0 %}
            {% set showEndTime = form.time.vars.value is not empty or form.dateTo.vars.value is not empty or form.endTime.vars.errors|length > 0 %}
            <div data-controller="calendar-entry-form">
                <p class="small text-body-secondary mb-3{{ showDateFields ? ' d-none' }}" data-calendar-entry-form-target="dateSummary">
                    {{ 'calendar_entry.form.on_date'|trans({'%date%': calendarEntry.date|date('d.m.Y')}) }}
                    &middot;
                    <a href="#" data-action="calendar-entry-form#showDateFields">{{ 'calendar_entry.form.change_date'|trans }}</a>
                </p>
                <div class="row{{ showDateFields ? '' : ' d-none' }}" data-calendar-entry-form-target="dateFields">
                    <div class="col-6 col-md-3">{{ form_row(form.date) }}</div>
                    <div class="col-6 col-md-3">{{ form_row(form.dateTo, {'attr': {'data-calendar-entry-form-target': 'dateTo', 'data-action': 'input->calendar-entry-form#updateEndTime'}}) }}</div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-5">{{ form_row(form.calendar) }}</div>
                    <div class="col-12 col-md-7">{{ form_row(form.title) }}</div>
                </div>
                <div class="row">
                    <div class="col-6 col-md-3">{{ form_row(form.time, {'attr': {'data-calendar-entry-form-target': 'time', 'data-action': 'input->calendar-entry-form#updateEndTime'}}) }}</div>
                    <div class="col-6 col-md-3{{ showEndTime ? '' : ' d-none' }}" data-calendar-entry-form-target="endTimeGroup">{{ form_row(form.endTime, {'label': 'calendar_entry.form.end_time_until', 'help': null}) }}</div>
                </div>
            </div>
        {% else %}
            <div class="row">
                <div class="col-6 col-md-3">{{ form_row(form.date, {'label': false, 'attr': {'title': 'calendar_entry.form.date'|trans}}) }}</div>
                <div class="col-3 col-md-2">{{ form_row(form.time, {'label': false, 'attr': {'title': 'calendar_entry.form.time'|trans}}) }}</div>
                <div class="col-3 col-md-2">{{ form_row(form.endTime, {'label': false, 'attr': {'title': 'calendar_entry.form.end_time'|trans}}) }}</div>
                <div class="col-12 col-md-5">{{ form_row(form.title, {'label': false, 'attr': {'placeholder': 'calendar_entry.form.title'|trans}}) }}</div>
            </div>
        {% endif %}

        <div class="d-flex justify-content-end mt-3">
            {% if not isNew and calendarEntry.confirmedAt %}
                {# Not a form submit: it carries its own CSRF token, and the
                   surrounding form already renders a "_token" field of its
                   own (stateless form protection), which a second one would
                   collide with. #}
                <button type="button"
                        class="btn btn-outline-secondary me-2"
                        data-action="click->reservations#unconfirmCalendarEntryAction"
                        data-url="{{ path('reservations.calendar_reminder.unconfirm', {'id': calendarEntry.id}) }}"
                        data-token="{{ csrf_token('unconfirmcalendarentry' ~ calendarEntry.id) }}">
                    {{ 'calendar_entry.unconfirm'|trans }}
                </button>
            {% endif %}
            {% if not isNew %}
                {# Same delete popover as the day-header list in the overview
                   (see _calendar_entry_popover_item.html.twig) - the shared
                   component carries its own CSRF token, so this button only
                   needs to trigger it. #}
                {% set id = 'calendarentry' ~ calendarEntry.id %}
                {% set targetUrl = path('reservations.calendar_entry.delete', {'id': calendarEntry.id}) %}
                <button type="button"
                        class="btn btn-danger me-2 js-calendar-entry-delete"
                        data-popover="delete"
                        data-title="{{ 'registrationbook.delete.ask'|trans }}"
                        data-bs-content='{{ block('deletePopoverContent') }}'>
                    {{ 'calendar_entry.delete'|trans }}
                </button>
            {% endif %}
            <button type="submit" class="btn btn-primary">{{ 'button.save'|trans }}</button>
        </div>
    {{ form_end(form) }}
</div>
