{# The reservation at a glance above the tabs: who, which room and when, and everything to do
   with the guest and the booking as labelled buttons. #}
{% import 'Reservations/_macros.html.twig' as reservationMacros %}
{% set booker = reservation.booker %}
{% set status = reservation.reservationStatus %}
{% set canEdit = is_granted('ROLE_RESERVATIONS') %}
{% set company = null %}
{% set phone = null %}
{% set email = null %}
{% if booker %}
    {# Business addresses first: the company shown on top is the one to call or mail #}
    {% for business in [true, false] %}
        {% for address in booker.customerAddresses|filter(a => (a.type == 'CUSTOMER_ADDRESS_TYPE_BUSINESS') == business) %}
            {# Same rule as Customers/_show_info.html.twig #}
            {% if company is null and business and address.company is not empty %}
                {% set company = address.company %}
            {% endif %}
            {% set phone = phone ?: address.mobilephone ?: address.phone %}
            {% set email = email ?: address.email %}
        {% endfor %}
    {% endfor %}
{% endif %}
<div class="reservation-card mb-3">
    <div class="d-flex align-items-start gap-2">
        <div class="me-auto text-break">
            {% if booker %}
                <div class="fs-5 fw-bold lh-sm">{{ company ?: booker.firstname ~ ' ' ~ booker.lastname }}</div>
                {% if company %}
                    <div>{{ booker.firstname }} {{ booker.lastname }}</div>
                {% endif %}
            {% else %}
                <div class="text-body-secondary">{{ 'reservation.import.booker.missing'|trans }}</div>
            {% endif %}
        </div>
        <span class="badge rounded-pill" style="background-color: {{ status.color }}; color: {{ status.contrastColor }}">{{ status|display_name }}</span>
    </div>
    <div class="mt-2">{{ reservation.appartment.number }} · {{ reservation.appartment.description }}</div>
    <div class="text-body-secondary">
        {{ reservation.startdate|date('d.m.Y') }} – {{ reservation.enddate|date('d.m.Y') }}
        · {{ 'reservation.summary.nights'|trans({'%count%': reservation.startdate.diff(reservation.enddate).days}) }}
        · {{ 'reservation.summary.persons'|trans({'%count%': reservation.persons}) }}
        {{ reservationMacros.guest_counts(reservation, guestCategoriesById|default({})) }}
    </div>

    {% if phone or email or canEdit %}
        {# Phones: one row of equal tiles, the icon above a short label; wider screens: a row of buttons #}
        <div class="row g-2 mt-1">
            {% if phone %}
                <div class="col col-lg-auto">
                    <a class="btn btn-outline-primary w-100 h-100 d-flex flex-column flex-lg-row align-items-center justify-content-center gap-1 px-1 px-lg-3 small" href="tel:{{ phone|replace({' ': '', '-': '', '/': '', '(': '', ')': ''}) }}">
                        <i class="fas fa-phone"></i> {{ 'reservation.summary.call'|trans }}
                    </a>
                </div>
            {% endif %}
            {% if email %}
                <div class="col col-lg-auto">
                    <a class="btn btn-outline-primary w-100 h-100 d-flex flex-column flex-lg-row align-items-center justify-content-center gap-1 px-1 px-lg-3 small" href="mailto:{{ email }}">
                        <i class="fas fa-envelope"></i> {{ 'customer.email'|trans }}
                    </a>
                </div>
            {% endif %}
            {% if canEdit %}
                <div class="col col-lg-auto dropdown">
                    <button class="btn btn-outline-primary w-100 h-100 d-flex flex-column flex-lg-row align-items-center justify-content-center gap-1 px-1 px-lg-3 small dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-user"></i> {{ 'reservation.summary.guest_menu'|trans }}
                    </button>
                    <ul class="dropdown-menu">
                        {% if booker %}
                            <li>
                                {# Read by editReservationCustomerEditAction #}
                                <form id="actions-booker-{{ booker.id }}" class="d-none">
                                    <input id="reservation-id" type="hidden" value="{{ reservation.id }}" name="reservation-id"/>
                                    <input id="customer-id" type="hidden" value="{{ booker.id }}" name="customer-id"/>
                                    <input id="tab" type="hidden" value="booker" name="tab"/>
                                    <input name="_csrf_token" value="{{ token }}" type="hidden">
                                </form>
                                <a class="dropdown-item" href="#"
                                   data-action="click->reservations#editReservationCustomerEditAction"
                                   data-customer-id="{{ booker.id }}"
                                   data-form-selector="#actions-booker-{{ booker.id }}"
                                   data-url="{{ path('reservations.edit.customer.edit') }}">
                                    <i class="fas fa-edit fa-fw me-2"></i>{{ 'reservation.summary.guest_edit'|trans }}
                                </a>
                            </li>
                        {% endif %}
                        <li>
                            <a class="dropdown-item" href="#"
                               data-action="click->reservations#changeReservationCustomerAction"
                               data-url="{{ path('reservations.edit.reservation.customer', {'id': reservation.id}) }}"
                               data-reservation-id="{{ reservation.id }}"
                               data-tab="booker"
                               data-appartment-id="0">
                                <i class="fas fa-exchange-alt fa-fw me-2"></i>{{ (booker ? 'reservation.summary.guest_change' : 'reservation.button.change.customer')|trans }}
                            </a>
                        </li>
                        {% if booker %}
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="{{ path('correspondence.registration.download', {id: reservation.id}) }}" target="_blank" rel="noopener">
                                    <i class="fas fa-print fa-fw me-2"></i>{{ 'operations.frontdesk.registration.print'|trans }}
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
                <div class="col col-lg-auto">
                    <a href="#" class="btn btn-outline-primary w-100 h-100 d-flex flex-column flex-lg-row align-items-center justify-content-center gap-1 px-1 px-lg-3 small"
                       data-action="click->reservations#editReservationAction"
                       data-url="{{ path('reservations.edit.reservation', {'id': reservation.id}) }}"
                       data-reservation-id="{{ reservation.id }}">
                        <i class="fas fa-calendar-alt"></i> {{ 'reservation.summary.change_booking'|trans }}
                    </a>
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>
