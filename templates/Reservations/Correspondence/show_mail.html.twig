<div data-controller="reservations">
<div class="modal-body">
    <div class="px-lg-5">
        <div id="flash-message-overlay"></div>
        <dl class="row mb-3">
            <dt class="col-4 col-sm-3 fw-normal text-body-secondary">{{ 'templates.recipient'|trans }}</dt>
            <dd class="col-8 col-sm-9 mb-1 text-break">{{ correspondence.recipient }}</dd>
            <dt class="col-4 col-sm-3 fw-normal text-body-secondary">{{ 'templates.subject'|trans }}</dt>
            <dd class="col-8 col-sm-9 mb-1 text-break">{{ correspondence.subject }}</dd>
        </dl>
        <div class="border rounded p-3 text-break">{{ correspondence.text|raw }}</div>
        {% if correspondence.children|length > 0 %}
            <h2 class="small text-uppercase fw-semibold text-body-secondary mt-4 mb-2">{{ 'templates.attachment'|trans }}</h2>
            <ul class="list-group">
                {% for attachment in correspondence.children %}
                    <li class="list-group-item d-flex align-items-center gap-2" id="aid-{{ attachment.id }}">
                        <i class="fas {{ attachment.template.templateType.icon }} fa-fw text-body-secondary" aria-hidden="true" title="{{ attachment.template.templateType.name|trans }}"></i>
                        <span class="me-auto text-break">{{ attachment.name }}</span>
                        <a href="#" class="btn btn-sm btn-link text-body-secondary"
                           data-action="click->reservations#exportPDFCorrespondenceAction"
                           data-url="{{ path('correspondence.export.pdf', {'id': attachment.id}) }}"
                           title="{{ 'button.download'|trans }}" aria-label="{{ 'button.download'|trans }}"><i class="fas fa-download"></i></a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
<div class="modal-footer">
    <a href="#" class="btn btn-link px-0 me-auto text-decoration-none"
       data-action="click->reservations#openReservationAction"
       data-url="{{ path('reservations.get.reservation', {'id': reservationId, 'tab': 'correspondence'}) }}"
       data-reservation-id="{{ reservationId }}"
       data-tab="correspondence">&larr; {{ 'button.back'|trans }}</a>
</div>
</div>
