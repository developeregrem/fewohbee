<div data-controller="reservations" data-delete-url="{{ path('correspondence.remove.reservation.from.selection') }}">
{% include 'Reservations/reservation_form_selected_reservations_fields.html.twig' %}
<div class="modal-footer">
    <a href="#" class="btn btn-link px-0 me-auto text-decoration-none"
       data-action="click->reservations#showAddReservationToSelectionAction"
       data-url="{{ path('correspondence.get.reservations') }}"
       data-create-new="false" data-title="{{ 'templates.select.reservations'|trans }}">
        <i class="fas fa-plus me-1"></i><span class="d-none d-sm-inline">{{ 'invoice.add.another.reservation'|trans }}</span><span class="d-sm-none">{{ 'button.add'|trans }}</span></a>
    {% if reservations|length > 0 %}
        <button type="button" class="btn btn-primary"
                data-action="click->reservations#selectTemplateForReservationsAction"
                data-url="{{ path('reservations.select.template') }}"
                data-title="{{ 'templates.select.template'|trans }}">{{ 'button.continue'|trans }} &rarr;</button>
    {% endif %}
</div>
</div>
