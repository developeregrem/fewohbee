{# Free rooms for the changed period; tapping one opens its guests and status with a save button. #}
<div class="list-group" data-controller="reservations">
    {% for appartment in appartments %}
        <div class="list-group-item">
            <a href="#" class="d-flex align-items-center gap-2 text-reset text-decoration-none"
               data-action="click->reservations#toggleAppartmentOptionsAction" data-appartment-id="{{ appartment.id }}">
                <span class="me-auto">
                    <span class="fw-semibold">{{ appartment.number }} · {{ appartment.description }}</span>
                    <span class="d-block small text-body-secondary">{{ 'appartment.bedsmax'|trans }}: {{ appartment.bedsmax }}</span>
                </span>
                <i class="fas fa-chevron-down text-body-secondary"></i>
            </a>
            <div id="appartment-{{ appartment.id }}" class="d-none appartment-options mt-3">
                <div id="appartment-options-{{ appartment.id }}">
                    <div class="row g-3">
                        {% include 'Reservations/reservations_form_appartment_options_input_fields.html.twig' %}
                    </div>
                    <div class="text-end mt-3">
                        <button class="btn btn-primary" type="button"
                                data-action="click->reservations#editUpdateReservationAction"
                                data-appartment-id="{{ appartment.id }}">{{ 'button.save'|trans }}</button>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
