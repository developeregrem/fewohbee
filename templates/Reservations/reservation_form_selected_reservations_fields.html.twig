{# The reservations picked for a document or an invoice, each removable (shared by both flows) #}
{% import 'Reservations/_macros.html.twig' as reservationMacros %}
<div class="modal-body">
    <div class="px-lg-5">
        <div id="flash-message-overlay">
            <div class="col">
            </div>
        </div>
        <h2 class="small text-uppercase fw-semibold text-body-secondary mb-2">{{ 'reservation.selected.reservations'|trans }}</h2>
        <ul class="list-group">
            {% for key, reservation in reservations %}
                <li class="list-group-item d-flex align-items-center gap-2">
                    <div class="me-auto text-break">
                        <div class="fw-semibold">{{ reservation.appartment.number }} · {{ reservation.appartment.description }}</div>
                        <div class="small text-body-secondary">
                            {% if reservation.booker %}
                                {{ reservation.booker.firstname }} {{ reservation.booker.lastname }}
                            {% else %}
                                {{ 'reservation.booker.missing.short'|trans }}
                            {% endif %}
                            · {{ reservationMacros.dates(reservation) }}
                        </div>
                    </div>
                    <a href="#" class="btn btn-sm btn-link text-danger"
                       data-action="click->reservations#deleteReservationFromSelectionAction" data-reservation-key="{{ key }}"
                       title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}">
                        <i class="fas fa-trash-alt"></i></a>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
