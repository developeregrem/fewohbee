{% set displayMonth = true %}
{% set displayWeek = true %}
{% set displayWeekday = true %}

{% set weekdayLabels = {
    1: 'reservation.table.weekday.monday'|trans,
    2: 'reservation.table.weekday.tuesday'|trans,
    3: 'reservation.table.weekday.wednesday'|trans,
    4: 'reservation.table.weekday.thursday'|trans,
    5: 'reservation.table.weekday.friday'|trans,
    6: 'reservation.table.weekday.saturday'|trans,
    7: 'reservation.table.weekday.sunday'|trans,
} %}

{% if selectedSubdivision == 'all' %}
    {% set showCountry = holidayCountry %}
{% else %}
    {% set showCountry = selectedSubdivision %}
{% endif %}

{# Defaults to false so other call sites of this template that don't pass the
   flag stay unaffected (opt-in feature). #}
{% set showCalendars = showCalendarEntries is defined ? showCalendarEntries : false %}

{% use 'Reservations/_resevation_popover.html.twig' %}

{% macro dayHeaderCell(col, label, showCountry, showCalendars) %}
    {% set weekendCss = col.isWeekend ? ' reservation-table-weekend' : '' %}
    {% set publicdays = getPublicdaysForDay(col.date|date_modify('+0 day'), showCountry, app.request.locale) %}
    {% set holidayText = "" %}
    {% for holiday in publicdays %}
        {% set holidayText = holidayText ~ holiday.name %}
        {% if not loop.last %}{% set holidayText = holidayText ~ "<br />" %}{% endif %}
    {% endfor %}
    {% set dayEntries = showCalendars ? getCalendarEntriesForDay(col.date|date_modify('+0 day')) : [] %}
    {% set entriesText = "" %}
    {% set entryColors = [] %}
    {% for entry in dayEntries %}
        {% set entryColors = entryColors|merge([entry.calendar.color]) %}
        {# Bootstrap's popover sanitizer strips data-action/onclick from
           injected HTML, so this can't be a Stimulus action - deleteCalendarEntryFromPopover in
           reservations_controller.js delegates on document instead, keyed
           off the js-calendar-entry-delete-form class. form/input/button/i[style] are
           allow-listed by _patchTooltipAllowList (utils.js), which
           enableDeletePopover() has already run by the time any popover
           can be opened. #}
        {% set deleteForm = "<form method='post' action='" ~ path('reservations.calendar_entry.delete', {'id': entry.id}) ~ "' class='d-inline js-calendar-entry-delete-form'><input type='hidden' name='_token' value='" ~ csrf_token('delete-calendar-entry-' ~ entry.id) ~ "'><button type='submit' class='btn btn-link btn-sm p-0 ms-1' title='" ~ 'calendar_entry.delete'|trans|e('html_attr') ~ "'><i class='fas fa-trash-alt' style='color: " ~ entry.calendar.color ~ "; font-size: 0.8em;'></i></button></form>" %}
        {% set entriesText = entriesText ~ "<a href='" ~ path('reservations.calendar_entry.edit', {'id': entry.id}) ~ "' class='text-dark text-decoration-underline js-calendar-entry-link'>" ~ entry.title ~ "</a> <span class='text-muted small'>(" ~ entry.calendar.name ~ ")</span>" ~ deleteForm %}
        {% if not loop.last %}
            {% set nextEntry = dayEntries[loop.index0 + 1] %}
            {% set entriesText = entriesText ~ (nextEntry.calendar.id != entry.calendar.id ? "<hr class='my-1'>" : "<br />") %}
        {% endif %}
    {% endfor %}
    {% set newEntryUrl = showCalendars ? path('reservations.calendar_entry.new', {'date': col.date|date_modify('+0 day')|date('Y-m-d')}) : null %}
    {% set newEntryLink = newEntryUrl ? "<a href='" ~ newEntryUrl ~ "' class='text-primary text-decoration-underline js-calendar-entry-link'>" ~ 'calendar_entry.popover.new'|trans ~ "</a>" : "" %}
    {# Popovers with only holiday text stay hover-triggered (no interactive
       content, matches pre-existing behavior); popovers with calendar-entry
       or "new entry" links need a click, since a link inside a hover popover
       is unreachable - the popover closes as soon as the mouse leaves the cell. #}
    {% set hasInteractiveContent = entriesText|length > 0 or newEntryLink|length > 0 %}
    {% set popoverText = holidayText %}
    {% if entriesText|length > 0 %}
        {% set popoverText = popoverText ~ (holidayText|length > 0 ? "<hr class='my-1'>" : "") ~ entriesText %}
    {% endif %}
    {% if newEntryLink|length > 0 %}
        {% set popoverText = popoverText ~ (popoverText|length > 0 ? "<hr class='my-1'>" : "") ~ newEntryLink %}
    {% endif %}
    {% set headerCss = "" %}
    {% if holidayText|length > 0 %}
        {% set headerCss = headerCss ~ " bg-info bg-opacity-25 holiday-info" %}
    {% endif %}
    {% if hasInteractiveContent %}
        {% set headerCss = headerCss ~ " calendar-info" %}
    {% endif %}
    {% if holidayText|length == 0 and entriesText|length == 0 and newEntryUrl %}
        {# Nothing to show but the "add new" link - skip the popover
           step and let the cell link straight to the new-entry form. #}
        <th class="text-center{{ weekendCss }}{{ headerCss }}" colspan="2">
            <a href="{{ newEntryUrl }}" class="text-reset text-decoration-none d-block js-calendar-entry-link" title="{{ 'calendar_entry.popover.new'|trans }}">{{ label }}</a>
        </th>
    {% else %}
        <th class="text-center{{ weekendCss }}{{ headerCss }}" colspan="2"
            style="{{ calendar_accent_marker_style(entryColors) }}"
            {% if popoverText|length > 0 %}
                data-bs-container="body" data-bs-toggle="popover" data-bs-placement="top"
                data-bs-content="{{ popoverText }}" data-bs-trigger="{{ hasInteractiveContent ? 'click' : 'hover' }}" data-bs-html="true"
            {% endif %}
        >{{ label }}</th>
    {% endif %}
{% endmacro %}
{% import _self as calendarMacros %}

<div class="table-responsive js-fit-vh" data-min-height="200">
    <table class="table table-hover table-bordered table-reservation m-0 table-sticky mb-2" id="reservation-table">
        <thead>
        {# ── Month headers ── #}
        {% if displayMonth %}
        <tr id="reservation-table-header-month">
            <td class="text-center"></td>
            {% for header in grid.monthHeaders %}
                <td class="text-center p-1" colspan="{{ header.colspan * 2 }}">{{ getLocalizedMonth(header.label, 'MMM', app.request.locale) }}</td>
            {% endfor %}
        </tr>
        {% endif %}

        {# ── Week headers ── #}
        {% if displayWeek %}
        <tr id="reservation-table-header-week">
            <td class="text-center"></td>
            {% for header in grid.weekHeaders %}
                <td class="text-center p-1" colspan="{{ header.colspan * 2 }}">{{ 'reservation.table.calendarweek'|trans }} {{ header.label }}</td>
            {% endfor %}
        </tr>
        {% endif %}

        {# ── Weekday headers ── #}
        {% if displayWeekday %}
        <tr id="reservation-table-header-weekday" class="table-weekdays">
            <th class="text-center"></th>
            {% for col in grid.dayColumns %}
                {{ calendarMacros.dayHeaderCell(col, weekdayLabels[col.isoDayOfWeek] ?? '', showCountry, showCalendars) }}
            {% endfor %}
        </tr>
        {% endif %}

        {# ── Day number headers ── #}
        <tr class="table-days">
            <th class="text-center">{{ 'reservation.appartment.name'|trans }}</th>
            {% for col in grid.dayColumns %}
                {{ calendarMacros.dayHeaderCell(col, '%02d'|format(col.dayOfMonth), showCountry, showCalendars) }}
            {% endfor %}
        </tr>
        </thead>

        <tbody>
        {% set totalColumnCount = grid.dayColumns|length * 2 + 1 %}
        {% set emptyTdNr = 0 %}

        {% for row in grid.rows %}
            {# Subsidiary group header #}
            {% if not row.isSubRow and grid.subsidiaryBreaks[row.apartment.id] is defined %}
                <tr>
                    <td colspan="{{ totalColumnCount }}" class="fw-semibold">
                        {{ grid.subsidiaryBreaks[row.apartment.id] ?? '' }}
                    </td>
                </tr>
            {% endif %}

            {# Room info for first row of each apartment #}
            {% if not row.isSubRow %}
                {% set roomInfo = 'appartment.bedsmax'|trans ~ ": " ~ row.apartment.bedsMax %}
                {% if row.apartment.multipleOccupancy %}
                    {% set roomInfo = roomInfo ~ ' <i class="fa-solid fa-users" title="' ~ 'apartment.multiple.occupancy.text'|trans ~ '"></i>' %}
                {% endif %}
            {% endif %}

            <tr{% if row.isSubRow %} class="border-top-0"{% endif %}>
                {% if row.isSubRow %}
                    <td></td>
                {% else %}
                    <td class="text-center room-info"
                        data-bs-container="body" data-bs-toggle="popover" data-bs-placement="right"
                        data-bs-content="{{ roomInfo }}" data-bs-trigger="hover"
                    >
                        <a href="{{ path('start.toggle.view', {
                            show: 'yearly',
                            apartmentId: row.apartment.id
                        }) }}" title="{{ 'reservation.table.view.yearly'|trans }}">
                            {{ row.apartment.number }}{% if row.apartment.roomCategory is not null and row.apartment.roomCategory.acronym|length > 0 %} ({{ row.apartment.roomCategory.acronym }}){% endif %}
                        </a>
                    </td>
                {% endif %}

                {# ── Cells ── #}
                {% for cell in row.cells %}
                    {% if cell.type == 'reservation' %}
                        {# Reservation cell #}
                        {% set reservation = cell.reservation %}
                        <td class="reservation text-center cell-{{ cell.position }}{{ cell.startsAtDayBoundary ? ' day-start' : '' }}"
                            colspan="{{ cell.span }}"
                        >
                            <div data-action="click->reservations#openReservationAction"
                                 data-reservation-id="{{ cell.reservationId }}"
                                 data-url="{{ path('reservations.get.reservation', {'id': cell.reservationId}) }}"
                                 style="background-color: {{ cell.color }}; color: {{ cell.contrastColor }}"
                                 class="reservation-inner text-center"
                                 title="{{ block('popTitle') }}"
                                 data-bs-content="{{ block('popBody') }}"
                            >{{ cell.displayName }}</div>
                        </td>
                    {% elseif cell.type == 'blocked' %}
                        {# Blocked cell #}
                        <td class="td-blocked" colspan="{{ cell.span }}">
                            <div class="blocked-inner"></div>
                        </td>
                    {% else %}
                        {# Empty half-day cell #}
                        <td class="td-empty td-half td-half-{{ cell.side }}{{ cell.startsAtDayBoundary ? ' day-start' : '' }}"
                            data-day="{{ cell.date }}" data-appartment="{{ row.apartment.id }}"
                            data-tdnumber="{{ emptyTdNr }}"
                        ></td>
                        {% set emptyTdNr = emptyTdNr + 1 %}
                    {% endif %}
                {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
