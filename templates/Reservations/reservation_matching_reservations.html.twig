{# Search hits; tapping one adds it to the selection #}
<div class="list-group">
    {% for reservation in reservations %}
        <a href="#" class="list-group-item list-group-item-action"
           data-action="click->reservations#selectReservationAction" data-reservation-id="{{ reservation.id }}">
            <div class="fw-semibold">
                {{ reservation.appartment.number }} ·
                {% if reservation.booker %}
                    {{ reservation.booker.firstname }} {{ reservation.booker.lastname }}
                {% else %}
                    <span class="text-body-secondary">{{ 'reservation.booker.missing.short'|trans }}</span>
                {% endif %}
            </div>
            <div class="small text-body-secondary">{{ reservation.startdate|date('d.m.Y') }} – {{ reservation.enddate|date('d.m.Y') }}</div>
        </a>
    {% endfor %}
</div>
