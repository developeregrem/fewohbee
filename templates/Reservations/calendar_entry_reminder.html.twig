<div class="modal-body" data-controller="reservations">
    <div id="flash-message-overlay"></div>
    <h2 class="small text-uppercase fw-semibold text-body-secondary mb-1">{{ 'reservation.calendar_reminder.section.title'|trans }}</h2>
    <p class="small text-body-secondary">{{ 'reservation.calendar_reminder.hint'|trans }}</p>
    {% if pendingReminders|length == 0 %}
        <p class="text-body-secondary mb-0">{{ 'reservation.calendar_reminder.empty'|trans }}</p>
    {% else %}
        <ul class="list-group">
            {% for reminder in pendingReminders %}
                {% set isToday = reminder.date|date('Y-m-d') == 'now'|date('Y-m-d') %}
                {% set reminderTime = reminder|calendar_entry_time %}
                <li class="list-group-item d-flex align-items-center gap-2">
                    <div class="me-auto text-break">
                        <div>
                            <i class="fas fa-circle me-1" style="color: {{ reminder.calendar.color }}; font-size: 0.6em; vertical-align: middle;"></i>
                            {{ reminder.title }}{% if reminderTime %} <span class="fw-semibold">{{ reminderTime }}</span>{% endif %}
                        </div>
                        <div class="small text-body-secondary">
                            {{ reminder.date|date('d.m.Y') }}
                            {% if isToday %}<span class="badge bg-danger ms-1">{{ 'reservation.calendar_reminder.today'|trans }}</span>{% endif %}
                            · {{ reminder.calendar.name }}
                        </div>
                    </div>
                    {# Confirming is a write - read-only staff see the pending reminders but get no button. #}
                    {% if is_granted('ROLE_RESERVATIONS') %}
                        <button type="button" class="btn btn-sm btn-primary text-nowrap"
                                data-action="click->reservations#confirmCalendarReminderAction"
                                data-url="{{ path('reservations.calendar_reminder.confirm', {'id': reminder.id}) }}"
                                data-token="{{ csrf_token('confirmcalendarentry' ~ reminder.id) }}"
                                title="{{ 'reservation.calendar_reminder.action.confirm.title'|trans }}">
                            <i class="fas fa-check"></i><span class="d-none d-sm-inline"> {{ 'reservation.calendar_reminder.action.confirm.title'|trans }}</span>
                        </button>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
