<div data-controller="reservations" data-create-reservations-url="{{ path('reservations.create.reservations') }}"
    data-preview-url="{{ path('reservations.create.preview') }}">
    <div class="modal-body">
        <div class="container-fluid px-0">
            <div id="flash-message-overlay">
                <div class="col">
                    {% include 'feedback.html.twig' with {'error': error, 'app': app } %}
                </div>
            </div>
            {% include 'Reservations/reservation_form_show_fields.html.twig' with {'mode': 'new', 'reservationId':  'new'} %}
        </div>
    </div>
    <div id="newReservationPreview" class="modal-footer">
        <a class="btn btn-link me-auto px-0 text-decoration-none" href="#"
           data-action="click->reservations#selectCustomerAction"
           data-url="{{ path('reservations.select.customer') }}">&larr; {{ 'button.back'|trans }}</a>
        <button type="button" class="btn btn-secondary d-none d-lg-inline-block" data-bs-dismiss="modal">{{ 'button.cancel'|trans }}</button>
        <button type="button" class="btn btn-primary"
                data-action="click->reservations#createReservationsAction"
                data-url="{{ path('reservations.create.reservations') }}">{{ 'reservation.new.create'|trans }}</button>
    </div>
</div>
