{# Online check-in of one reservation, laid out by its state with one main action each: share the
   link while the guest has not checked in, review and confirm what arrived, then the outcome. #}
{% set checkIn = guestCheckIn.checkIn %}
{% set status = guestCheckIn.status.value %}
{% set canEdit = is_granted('ROLE_RESERVATIONS') %}
<div data-controller="guest-checkin"
     data-guest-checkin-link-url-value="{{ path('reservations.guest_checkin.link', {'id': reservation.id}) }}"
     data-guest-checkin-regenerate-url-value="{{ path('reservations.guest_checkin.regenerate', {'id': reservation.id}) }}"
     data-guest-checkin-token-value="{{ canEdit ? csrf_token('guest-checkin-' ~ reservation.id) : '' }}">

    {% set invitation = status == 'open' and not guestCheckIn.unavailableReason ? guestCheckIn.invitation : null %}

    {# ── State; while open, with where the invitation stands ── #}
    {# No wrapping: on a phone only the text breaks, badge and undo stay beside it #}
    <div class="d-flex align-items-center gap-2 mb-3">
        <span class="badge flex-shrink-0 {{ {'open': 'text-bg-secondary', 'submitted': 'text-bg-primary', 'applied': 'text-bg-success'}[status] }}">{{ guestCheckIn.status.labelKey|trans }}</span>
        <span class="small text-body-secondary flex-grow-1">
            {% if status == 'applied' %}
                {{ (checkIn.checkedInAtDesk ? 'guest_checkin.tab.state_desk' : 'guest_checkin.tab.state_applied')|trans({'%date%': checkIn.appliedAt ? checkIn.appliedAt|date('d.m.Y H:i') : '–'}) }}
            {% elseif status == 'submitted' and guestCheckIn.review %}
                {{ 'guest_checkin.tab.state_submitted'|trans({'%date%': checkIn.lastSubmittedAt ? checkIn.lastSubmittedAt|date('d.m.Y H:i') : '–'}) }}
            {% elseif status == 'submitted' %}
                {{ 'guest_checkin.tab.state_purged'|trans }}
            {% elseif invitation %}
                {% if invitation.sentAt %}
                    {{ 'guest_checkin.tab.invitation_sent'|trans({'%date%': invitation.sentAt|date('d.m.Y')}) }}
                {% elseif invitation.workflows is not empty %}
                    {{ 'guest_checkin.tab.invitation_planned'|trans({'%names%': invitation.workflows|map(workflow => workflow.system ? workflow.name|trans : workflow.name)|join(', ')}) }}
                {% elseif invitation.template %}
                    {{ 'guest_checkin.tab.invitation_not_sent'|trans }}
                    {# No automation sends it, so only the button below does #}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('settings.workflows.index') }}" class="text-body-secondary ms-1" title="{{ 'guest_checkin.tab.invitation_no_workflow'|trans }}" aria-label="{{ 'guest_checkin.tab.invitation_no_workflow'|trans }}"><i class="fas fa-circle-info"></i></a>
                    {% else %}
                        <i class="fas fa-circle-info text-body-secondary ms-1" role="img" title="{{ 'guest_checkin.tab.invitation_no_workflow'|trans }}" aria-label="{{ 'guest_checkin.tab.invitation_no_workflow'|trans }}"></i>
                    {% endif %}
                {% else %}
                    {{ 'guest_checkin.tab.invitation_none'|trans }}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('settings.workflows.index') }}">{{ 'guest_checkin.tab.invitation_setup'|trans }}</a>
                    {% endif %}
                {% endif %}
            {% else %}
                {{ 'guest_checkin.tab.state_open'|trans }}
            {% endif %}
        </span>
        {# Only a desk check-in can be taken back; a confirmed online one already changed the guest
           records. It sits beside the line it takes back. #}
        {% if status == 'applied' and checkIn.checkedInAtDesk and is_granted('ROLE_RESERVATIONS') %}
            <form class="flex-shrink-0" method="post" action="{{ path('reservations.guest_checkin.desk_undo', {'id': reservation.id}) }}" data-action="submit->guest-checkin#post">
                <input type="hidden" name="_token" value="{{ csrf_token('guest-checkin-' ~ reservation.id) }}">
                {# On a phone only the icon, so the status line keeps its room #}
                <button type="submit" class="btn btn-sm btn-link text-body-secondary py-0" title="{{ 'guest_checkin.tab.desk_undo'|trans }}" aria-label="{{ 'guest_checkin.tab.desk_undo'|trans }}"><i class="fas fa-rotate-left"></i><span class="d-none d-sm-inline ms-1">{{ 'guest_checkin.tab.desk_undo'|trans }}</span></button>
            </form>
        {% endif %}
    </div>

    {% if status == 'open' %}
        {% if guestCheckIn.unavailableReason %}
            <div class="alert alert-secondary small">{{ guestCheckIn.unavailableReason|trans }}</div>
        {% elseif canEdit %}
            {# One row of actions: send the invitation, hand out the link, or close it at the desk #}
            <div class="d-flex flex-wrap align-items-center gap-2">
                {% if invitation and invitation.template and invitation.recipients is not empty %}
                    {# Sent by hand with the template from the check-in settings #}
                    <form method="post"
                          action="{{ path('reservations.guest_checkin.invite', {'id': reservation.id}) }}" data-action="submit->guest-checkin#post">
                        <input type="hidden" name="_token" value="{{ csrf_token('guest-checkin-' ~ reservation.id) }}">
                        {% set inviteLabel = (invitation.sentAt ? 'guest_checkin.tab.invite_again' : 'guest_checkin.tab.invite_send')|trans %}
                        {% if invitation.recipients|length > 1 %}
                            {# Several addresses: picking one sends; with one address the button sends directly #}
                            <div class="dropdown">
                                <button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-paper-plane me-1"></i>{{ inviteLabel }}
                                </button>
                                <ul class="dropdown-menu">
                                    {% for email in invitation.recipients %}
                                        <li><button type="submit" class="dropdown-item text-break" name="email" value="{{ email }}"><i class="fas fa-envelope fa-fw me-1"></i>{{ email }}</button></li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% else %}
                            <button type="submit" class="btn btn-sm btn-primary" title="{{ 'guest_checkin.tab.invite_to'|trans({'%email%': invitation.recipients|first}) }}"><i class="fas fa-paper-plane me-1"></i>{{ inviteLabel }}</button>
                        {% endif %}
                    </form>
                {% endif %}
                {% include 'Reservations/GuestCheckIn/_link.html.twig' %}
                {# Not every guest checks in online; the desk check-in closes the gap. #}
                <form method="post" action="{{ path('reservations.guest_checkin.desk', {'id': reservation.id}) }}" data-action="submit->guest-checkin#post">
                    <input type="hidden" name="_token" value="{{ csrf_token('guest-checkin-' ~ reservation.id) }}">
                    <button type="submit" class="btn btn-sm btn-outline-success" title="{{ 'guest_checkin.tab.desk_hint'|trans }}"><i class="fas fa-check me-1"></i>{{ 'guest_checkin.tab.desk_mark'|trans }}</button>
                </form>
            </div>
            {% if invitation and invitation.template and invitation.recipients is empty %}
                <p class="small text-body-secondary mt-2 mb-0">{{ 'guest_checkin.tab.invite_no_recipient'|trans }}</p>
            {% endif %}
            {% include 'Reservations/GuestCheckIn/_link_output.html.twig' %}
        {% endif %}
    {% elseif status == 'submitted' and guestCheckIn.review %}
        {% include 'Reservations/GuestCheckIn/_review.html.twig' with {'review': guestCheckIn.review} %}
    {% elseif status == 'applied' %}
        {% include 'Reservations/GuestCheckIn/_confirmed.html.twig' %}
    {% endif %}

    {# Once the guest acted, the link is a side matter: guests reopen it for their stay page. #}
    {% if status != 'open' and canEdit and not guestCheckIn.unavailableReason %}
        <div class="mt-4">
            {% include 'Reservations/GuestCheckIn/_link.html.twig' %}
            {% include 'Reservations/GuestCheckIn/_link_output.html.twig' %}
        </div>
    {% endif %}
</div>
