{% use "common/delete_popover.html.twig" %}
{% set checkIn = guestCheckIn.checkIn %}
{% set canEdit = is_granted('ROLE_RESERVATIONS') %}
<div data-controller="guest-checkin"
     data-guest-checkin-link-url-value="{{ path('reservations.guest_checkin.link', {'id': reservation.id}) }}"
     data-guest-checkin-regenerate-url-value="{{ path('reservations.guest_checkin.regenerate', {'id': reservation.id}) }}"
     data-guest-checkin-token-value="{{ canEdit ? csrf_token('guest-checkin-' ~ reservation.id) : '' }}">

    {# ── State, with what it means right below ── #}
    {% set hasPayload = checkIn and checkIn.payload %}
    {% set stateParts = [] %}
    {% if checkIn and checkIn.lastSubmittedAt %}
        {% set stateParts = stateParts|merge(['guest_checkin.tab.submitted_at'|trans({'%date%': checkIn.lastSubmittedAt|date('d.m.Y H:i')})]) %}
    {% endif %}
    {% if checkIn and checkIn.appliedAt %}
        {% set stateParts = stateParts|merge(['guest_checkin.tab.applied_at'|trans({'%date%': checkIn.appliedAt|date('d.m.Y H:i')})]) %}
    {% endif %}
    <div class="mb-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            {% set badgeClass = {'open': 'text-bg-secondary', 'submitted': 'text-bg-primary', 'applied': 'text-bg-success'}[guestCheckIn.status.value] %}
            <span class="badge {{ badgeClass }}">{{ guestCheckIn.status.labelKey|trans }}</span>
            {% if stateParts is not empty %}
                <small class="text-body-secondary">{{ stateParts|join(' · ') }}</small>
            {% endif %}
        </div>
        {% if guestCheckIn.status.value == 'applied' %}
            <p class="small text-body-secondary mb-0 mt-1">{{ 'guest_checkin.tab.applied_hint'|trans }}</p>
        {% elseif guestCheckIn.status.value == 'submitted' and not hasPayload %}
            <p class="small text-body-secondary mb-0 mt-1">{{ 'guest_checkin.tab.purged_hint'|trans }}</p>
        {% elseif not hasPayload %}
            <p class="small text-body-secondary mb-0 mt-1">{{ 'guest_checkin.tab.nothing_yet'|trans }}</p>
        {% endif %}
    </div>

    {# ── Link for the guest ── #}
    {% if guestCheckIn.unavailableReason %}
        <div class="alert alert-secondary small">{{ guestCheckIn.unavailableReason|trans }}</div>
    {% elseif canEdit %}
        <div class="mb-4">
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" data-action="guest-checkin#showLink">
                    <i class="fas fa-link me-1"></i>{{ 'guest_checkin.tab.show_link'|trans }}
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary" data-action="guest-checkin#showQr">
                    <i class="fas fa-qrcode me-1"></i>{{ 'guest_checkin.tab.show_qr'|trans }}
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#guest-checkin-regenerate-{{ reservation.id }}" aria-expanded="false">
                    <i class="fas fa-rotate me-1"></i>{{ 'guest_checkin.tab.regenerate'|trans }}
                </button>
            </div>
            <div class="collapse mt-2" id="guest-checkin-regenerate-{{ reservation.id }}" data-guest-checkin-target="regenerateBox">
                <div class="alert alert-warning small mb-0 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span>{{ 'guest_checkin.tab.regenerate_hint'|trans }}</span>
                    <button type="button" class="btn btn-sm btn-warning" data-action="guest-checkin#regenerate">{{ 'guest_checkin.tab.regenerate_confirm'|trans }}</button>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1 mt-2 d-none" data-guest-checkin-target="linkBox" data-controller="copy" data-copy-hint-value="{{ 'guest_checkin.tab.copied'|trans }}">
                <input type="text" class="form-control form-control-sm" readonly data-guest-checkin-target="url" data-copy-target="input" aria-label="{{ 'guest_checkin.tab.show_link'|trans }}">
                <button type="button" class="btn btn-sm border-0 shadow-none text-secondary" data-action="copy#copy"
                        title="{{ 'guest_checkin.tab.copy'|trans }}" aria-label="{{ 'guest_checkin.tab.copy'|trans }}"><i class="fas fa-copy"></i></button>
            </div>
            <div class="mt-2 d-none" data-guest-checkin-target="qrBox">
                <img data-guest-checkin-target="qr" alt="{{ 'guest_checkin.tab.show_qr'|trans }}" width="160" height="160" class="border rounded p-1 bg-white">
                <a class="d-block small mt-1" data-guest-checkin-target="qrDownload" download="online-checkin-{{ reservation.id }}.png"><i class="fas fa-download me-1"></i>{{ 'guest_checkin.tab.download_qr'|trans }}</a>
            </div>
            <div class="small text-warning-emphasis mt-1" data-guest-checkin-target="error" role="alert"></div>
            <p class="small text-body-secondary mt-2 mb-0">{{ 'guest_checkin.tab.link_hint'|trans }}</p>
        </div>
    {% endif %}

    {# ── What the guest sent ── #}
    {% if hasPayload %}
        <h5 class="fs-6 fw-semibold">{{ 'guest_checkin.tab.submission'|trans }}</h5>
        <dl class="row small mb-2">
            <dt class="col-sm-4">{{ 'reservation.arrivalTime'|trans }}</dt>
            <dd class="col-sm-8">{{ guestCheckIn.arrivalTime ?: '–' }}</dd>
            {% if guestCheckIn.message %}
                <dt class="col-sm-4">{{ 'guest_checkin.tab.message'|trans }}</dt>
                <dd class="col-sm-8">{{ guestCheckIn.message|nl2br }}</dd>
            {% endif %}
        </dl>

        {% if guestCheckIn.extras is not empty %}
            <h5 class="fs-6 fw-semibold">{{ 'guest_checkin.tab.extras'|trans }}</h5>
            <ul class="small">
                {% for extra in guestCheckIn.extras %}
                    <li>{{ extra.description }} · {{ extra.total|number_format(2, ',', '.') }} {{ currency_symbol }}</li>
                {% endfor %}
            </ul>
            {% if guestCheckIn.extrasConflict %}
                <div class="alert alert-warning small" role="alert">{{ 'guest_checkin.apply.extras_conflict_hint'|trans }}</div>
            {% endif %}
        {% endif %}

        {% if guestCheckIn.bookerDiffers %}
            <div class="alert alert-warning small" role="alert">{{ 'guest_checkin.apply.booker_differs'|trans }}</div>
        {% endif %}

        <table class="table table-sm small align-middle">
            <thead>
            <tr>
                <th scope="col">{{ 'guest_checkin.tab.main_guest'|trans }}</th>
                <th scope="col">{{ 'guest_checkin.tab.col_submitted'|trans }}</th>
                <th scope="col">{{ guestCheckIn.comparisonGuestName ? 'guest_checkin.tab.col_current_person'|trans({'%name%': guestCheckIn.comparisonGuestName}) : 'guest_checkin.tab.col_new_person'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for row in guestCheckIn.mainGuestRows %}
                {# Salutation, ID type: stored values are translation keys or configured salutations. #}
                {% set translatable = row.label in ['customer.salutation', 'customer.id.type.name'] %}
                <tr{% if row.differs %} class="table-warning"{% endif %}>
                    <th scope="row" class="fw-normal text-body-secondary">{{ row.label|trans }}</th>
                    <td>{{ row.submitted is not null ? (translatable ? row.submitted|trans : row.submitted) : '–' }}</td>
                    <td>{{ row.current is not null ? (translatable ? row.current|trans : row.current) : '–' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% if guestCheckIn.companions is not empty %}
            <table class="table table-sm small">
                <thead>
                <tr>
                    <th scope="col">{{ 'guest_checkin.tab.companions'|trans }}</th>
                    <th scope="col">{{ 'customer.birthday'|trans }}</th>
                    <th scope="col">{{ 'customer.nationality'|trans }}</th>
                    <th scope="col">{{ 'customer.address'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for companion in guestCheckIn.companions %}
                    <tr>
                        <td>{{ companion.salutation ? companion.salutation ~ ' ' : '' }}{{ companion.name }}</td>
                        <td>{{ companion.birthday ?: '–' }}</td>
                        <td>{{ companion.nationality ?: '–' }}</td>
                        <td>{{ companion.address ?: ('guest_checkin.tab.same_address'|trans) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {# ── Take over ── #}
        {% if canEdit and guestCheckIn.status.value == 'submitted' %}
            <form action="{{ path('reservations.guest_checkin.apply', {'id': reservation.id}) }}" method="post" class="border rounded p-3 bg-body-tertiary" data-action="submit->guest-checkin#apply">
                <input type="hidden" name="_token" value="{{ csrf_token('guest-checkin-' ~ reservation.id) }}">
                <input type="hidden" name="submissionVersion" value="{{ checkIn.submissionVersion }}">
                <h5 class="fs-6 fw-semibold">{{ 'guest_checkin.apply.title'|trans }}</h5>

                <div class="row g-2 align-items-center mb-2">
                    <label class="col-sm-4 col-form-label col-form-label-sm" for="guest-checkin-main-{{ reservation.id }}">{{ 'guest_checkin.apply.main_target'|trans }}</label>
                    <div class="col-sm-8">
                        <select class="form-select form-select-sm" name="mainTarget" id="guest-checkin-main-{{ reservation.id }}" data-guest-checkin-target="mainTarget" data-action="change->guest-checkin#syncMainTargetChoices" required>
                            {% if guestCheckIn.mainNeedsChoice %}
                                <option value="" selected disabled>{{ 'guest_checkin.apply.target_choose'|trans }}</option>
                            {% endif %}
                            {% for target, name in guestCheckIn.mainTargets %}
                                {% set targetLabel = target == 'booker'
                                    ? (guestCheckIn.bookerNeedsUpdate ? 'guest_checkin.apply.target_booker' : 'guest_checkin.apply.target_booker_unchanged')
                                    : 'guest_checkin.apply.target_guest' %}
                                <option value="{{ target }}"{% if target == guestCheckIn.defaultMainTarget %} selected{% endif %}>
                                    {{ targetLabel|trans({'%name%': name}) }}
                                </option>
                            {% endfor %}
                            {% if guestCheckIn.mainGlobalTargets is not empty %}
                                <optgroup label="{{ 'guest_checkin.apply.existing_matches'|trans }}">
                                    {% for target, match in guestCheckIn.mainGlobalTargets %}
                                        <option value="{{ target }}"{% if target == guestCheckIn.defaultMainTarget %} selected{% endif %}>{{ 'guest_checkin.apply.target_existing'|trans({'%name%': match.name, '%id%': match.id}) }}</option>
                                    {% endfor %}
                                </optgroup>
                            {% endif %}
                            <option value="new"{% if guestCheckIn.defaultMainTarget == 'new' %} selected{% endif %}>{{ 'guest_checkin.apply.target_new'|trans }}</option>
                        </select>
                    </div>
                </div>
                {% if guestCheckIn.mainGlobalTargets is not empty %}
                    <p class="small text-body-secondary{% if not guestCheckIn.defaultMainTarget starts with 'existing:' %} d-none{% endif %}" data-guest-checkin-target="globalHint">{{ 'guest_checkin.apply.existing_match_hint'|trans }}</p>
                {% endif %}
                {% if guestCheckIn.mainNeedsChoice %}
                    <div class="alert alert-warning small" role="alert">{{ (guestCheckIn.mainNameOnlyMatch ? 'guest_checkin.apply.name_only_match' : 'guest_checkin.apply.ambiguous_matches')|trans }}</div>
                {% endif %}
                {% if guestCheckIn.bookerDiffers %}
                    <div class="form-check mb-2{% if guestCheckIn.defaultMainTarget != 'booker' %} d-none{% endif %}" data-guest-checkin-target="bookerConfirmation">
                        <input class="form-check-input" type="checkbox" name="confirmBookerMismatch" value="1" id="guest-checkin-confirm-booker-{{ reservation.id }}"{% if guestCheckIn.defaultMainTarget != 'booker' %} disabled{% endif %}>
                        <label class="form-check-label small" for="guest-checkin-confirm-booker-{{ reservation.id }}">{{ 'guest_checkin.apply.confirm_booker_mismatch'|trans }}</label>
                    </div>
                {% endif %}
                {% if guestCheckIn.bookerDiffers and guestCheckIn.bookerIsGuest %}
                    <div class="form-check mb-2{% if guestCheckIn.defaultMainTarget in ['', 'booker'] %} d-none{% endif %}" data-guest-checkin-target="removeBooker">
                        <input class="form-check-input" type="checkbox" name="removeBookerFromGuests" value="1" id="guest-checkin-remove-booker-{{ reservation.id }}"{% if guestCheckIn.defaultMainTarget in ['', 'booker'] %} disabled{% endif %}>
                        <label class="form-check-label small" for="guest-checkin-remove-booker-{{ reservation.id }}">{{ 'guest_checkin.apply.remove_booker_from_guests'|trans }}</label>
                    </div>
                {% endif %}
                {% if reservation.booker is not null %}
                    <div class="form-check mb-2{% if guestCheckIn.defaultMainTarget in ['', 'booker'] %} d-none{% endif %}" data-guest-checkin-target="setAsBooker">
                        <input class="form-check-input" type="checkbox" name="setAsBooker" value="1" id="guest-checkin-booker-{{ reservation.id }}"{% if guestCheckIn.defaultMainTarget in ['', 'booker'] %} disabled{% endif %}>
                        <label class="form-check-label small" for="guest-checkin-booker-{{ reservation.id }}">{{ 'guest_checkin.apply.set_as_booker'|trans }}</label>
                    </div>
                {% endif %}

                {% for companion in guestCheckIn.companions %}
                    <div class="row g-2 align-items-center mb-2">
                        <label class="col-sm-4 col-form-label col-form-label-sm" for="guest-checkin-companion-{{ reservation.id }}-{{ loop.index0 }}">{{ companion.name }}</label>
                        <div class="col-sm-8">
                            <select class="form-select form-select-sm" name="companionTargets[]" id="guest-checkin-companion-{{ reservation.id }}-{{ loop.index0 }}" required>
                                {% if companion.needsChoice %}
                                    <option value="" selected disabled>{{ 'guest_checkin.apply.target_choose'|trans }}</option>
                                {% endif %}
                                <option value="new"{% if companion.defaultTarget == 'new' %} selected{% endif %}>{{ 'guest_checkin.apply.target_new'|trans }}</option>
                                {% for target, name in guestCheckIn.companionTargets %}
                                    <option value="{{ target }}"{% if target == companion.defaultTarget %} selected{% endif %}>{{ 'guest_checkin.apply.target_guest'|trans({'%name%': name}) }}</option>
                                {% endfor %}
                                {% if companion.globalTargets is not empty %}
                                    <optgroup label="{{ 'guest_checkin.apply.existing_matches'|trans }}">
                                        {% for target, match in companion.globalTargets %}
                                            <option value="{{ target }}"{% if target == companion.defaultTarget %} selected{% endif %}>{{ 'guest_checkin.apply.target_existing'|trans({'%name%': match.name, '%id%': match.id}) }}</option>
                                        {% endfor %}
                                    </optgroup>
                                {% endif %}
                                <option value="skip">{{ 'guest_checkin.apply.target_skip'|trans }}</option>
                            </select>
                        </div>
                    </div>
                    {% if companion.needsChoice %}
                        <div class="alert alert-warning small" role="alert">{{ (companion.nameOnlyMatch ? 'guest_checkin.apply.name_only_match' : 'guest_checkin.apply.ambiguous_matches')|trans }}</div>
                    {% endif %}
                {% endfor %}
                {% if guestCheckIn.extras is not empty %}
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="applyExtras" value="1" id="guest-checkin-apply-extras-{{ reservation.id }}"{% if not guestCheckIn.extrasConflict %} checked{% else %} disabled{% endif %}>
                        <label class="form-check-label small" for="guest-checkin-apply-extras-{{ reservation.id }}">{{ 'guest_checkin.apply.apply_extras'|trans }}</label>
                    </div>
                    <p class="small text-body-secondary">{{ 'guest_checkin.apply.extras_defer_hint'|trans }}</p>
                {% endif %}
                <p class="small text-body-secondary">{{ 'guest_checkin.apply.hint'|trans }}</p>
                <div class="d-flex justify-content-between">
                    {% set id = 'guest-checkin-' ~ reservation.id %}
                    {% set targetUrl = path('reservations.guest_checkin.discard', {'id': reservation.id}) %}
                    {% set deletePopoverHint = 'guest_checkin.discard.hint'|trans %}
                    <button type="button" class="btn btn-sm btn-outline-danger" title="{{ 'guest_checkin.discard.title'|trans }}"
                            data-popover="delete" data-delete-target="#modal-content-ajax" data-bs-content='{{ block('deletePopoverContent') }}'>
                        <i class="fas fa-trash me-1"></i>{{ 'guest_checkin.discard.title'|trans }}
                    </button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-check me-1"></i>{{ 'guest_checkin.apply.submit'|trans }}</button>
                </div>
            </form>
        {% endif %}
    {% endif %}
</div>
