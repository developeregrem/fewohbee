{% import 'Reservations/_macros.html.twig' as reservationMacros %}
<div data-controller="reservations">
<div class="modal-body">
    <div class="px-lg-5">
        <div id="flash-message-overlay">
            <div class="col">
                {% include 'feedback.html.twig' with {'app': app } %}
            </div>
        </div>
    {% set lastStartDate, lastEndDate = "", "" %}
    {% if reservations|length > 0 %}
        {# Rooms picked so far (keyed by their position in the session); ids are used by the
           reservations controller to edit or drop them #}
        <h2 class="reservation-section-title mb-2">{{ 'reservation.new.reservation.appartments.selected.heading'|trans }}</h2>
        <div id="selectedAppartments" class="list-group mb-4">
            {% for key, reservation in reservations %}
                <div class="list-group-item" data-selected-room>
                    <div class="d-flex align-items-center gap-2">
                        <a href="#" class="me-auto text-reset text-decoration-none"
                           data-action="click->reservations#toggleAppartmentOptionsAction" data-appartment-id="{{ key }}">
                            <span class="d-block fw-semibold">{{ reservation.appartment.number }} · {{ reservation.appartment.description }}</span>
                            <span class="d-block small text-body-secondary">
                                {{ reservation.startdate|date('d.m.Y') }} – {{ reservation.enddate|date('d.m.Y') }}
                                · {{ 'reservation.summary.nights'|trans({'%count%': reservation.startdate.diff(reservation.enddate).days}) }}
                                · {{ 'reservation.summary.persons'|trans({'%count%': reservation.persons}) }}
                                {{ reservationMacros.guest_counts(reservation, guestCategoriesById|default({})) }}
                                · {{ reservation.reservationStatus|display_name }}
                            </span>
                        </a>
                        <a href="#" class="btn btn-sm btn-link text-body-secondary"
                           data-action="click->reservations#toggleAppartmentOptionsAction" data-appartment-id="{{ key }}"
                           title="{{ 'button.edit'|trans }}" aria-label="{{ 'button.edit'|trans }}">
                            <i class="fas fa-edit"></i></a>
                        <a href="#" class="btn btn-sm btn-link text-danger"
                           data-action="click->reservations#deleteAppartmentAction" data-appartment-id="{{ key }}"
                           title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}">
                            <i class="fas fa-trash-alt"></i></a>
                    </div>
                    <div id="appartment-{{ key }}" class="d-none mt-3">
                        <form id="appartment-options-{{ key }}">
                            <div class="row g-3">
                                {% include 'Reservations/reservations_form_appartment_options_input_fields.html.twig' with {'appartment': reservation.appartment} %}
                            </div>
                            <div class="text-end mt-3">
                                <button class="btn btn-primary" type="button"
                                        data-action="click->reservations#saveAppartmentOptionsAction"
                                        data-appartment-id="{{ key }}">{{ 'button.save'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
                {% set lastStartDate = reservation.startdate|date('Y-m-d') %}
                {% set lastEndDate = reservation.enddate|date('Y-m-d') %}
            {% endfor %}
        </div>
    {% endif %}

        <form id="reservation-period" role="form"
              data-available-url="{{ path('reservations.get.available.appartments') }}"
              data-add-appartment-url="{{ path('reservations.add.appartment.to.reservation') }}"
              data-remove-appartment-url="{{ path('reservations.remove.appartment.from.reservation') }}"
              data-modify-appartment-options-url="{{ path('reservations.modify.appartment.options') }}"
              data-select-customer-url="{{ path('reservations.select.customer') }}"
              data-preview-url="{{ path('reservations.create.preview') }}"
              data-action="submit->reservations#selectCustomerAction">
            <h2 class="reservation-section-title mb-2">{{ 'reservation.new.reservation.appartments.addmore'|trans }}</h2>
            <div class="row g-3 align-items-end">
                <div class="col-6 col-md">
                    <label for="from" class="form-label">{{ 'reservation.startdate'|trans }}</label>
                    <input type="date" class="form-control" id="from" name="from"
                           data-action="change->reservations#getAvailableAppartmentsAction"
                           value="{{ lastStartDate }}">
                </div>
                <div class="col-6 col-md">
                    <label for="end" class="form-label">{{ 'reservation.enddate'|trans }}</label>
                    <input type="date" class="form-control" id="end" name="end"
                           data-action="change->reservations#getAvailableAppartmentsAction"
                           value="{{ lastEndDate }}">
                </div>
                <div class="col">
                    <select id="objects" name="object" class="form-select" aria-label="{{ 'reservation.objects.all'|trans }}"
                            data-action="change->reservations#getAvailableAppartmentsAction">
                        <option value="all"
                                {% if objectSelected == "all" %}selected{% endif %}>{{ 'reservation.objects.all'|trans }}</option>
                        {% for object in objects %}
                            <option value="{{ object.id }}"
                                    {% if objectSelected == object.id %}selected{% endif %}>{{ object.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-primary"
                            data-action="click->reservations#getAvailableAppartmentsAction"
                            title="{{ 'nav.customer.search'|trans }}" aria-label="{{ 'nav.customer.search'|trans }}">
                        <i class="fas fa-search"></i></button>
                </div>
            </div>
            <div class="mt-3" id="available-appartments"></div>
        </form>
    </div>
</div>

{% if reservations|length > 0 %}
<div class="modal-footer">
    <button type="button" class="btn btn-link text-body-secondary text-decoration-none px-0 me-auto"
            data-action="click->reservations#openBlockFormAction"
            data-url="{{ path('reservations.blocks.form', {fromSelection: 1}) }}"
            title="{{ 'roomblock.instead'|trans }}">
        <i class="fas fa-ban"></i> {{ 'roomblock.instead'|trans }}
    </button>
    {% if objectHasAppartments %}
        <button type="button" class="btn btn-primary"
                data-action="click->reservations#selectCustomerAction"
                data-url="{{ path('reservations.select.customer') }}">{{ 'button.continue'|trans }} &rarr;</button>
    {% endif %}
</div>
{% endif %}
</div>
