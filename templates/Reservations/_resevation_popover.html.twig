
{% block popTitle %}
    {% if reservation is defined and reservation is not null %}
        {% if reservation.booker is defined and reservation.booker is not null %}
            {% set popTitle = reservation.booker.salutation|e ~ " " ~ reservation.booker.firstname|e ~ " " ~ reservation.booker.lastname|e ~
                " (" ~reservation.persons ~ "/" ~ reservation.appartment.bedsMax ~ ")" %}
        {% elseif reservation.calendarSyncImport is defined and reservation.calendarSyncImport is not null %}
            {% set popTitle = reservation.calendarSyncImport.name|e ~ " (" ~ reservation.persons ~ "/" ~ reservation.appartment.bedsMax ~ ")" %}
        {% else %}
            {% set popTitle = "-" %}
        {% endif %}
        {{ popTitle }}
    {% endif %}
{% endblock %}
{% block popBody %}
    {% import 'Reservations/_macros.html.twig' as popoverMacros %}
    {% if reservation is defined and reservation is not null %}
        {# Escape user-controlled values before concatenation. The completed
           block is escaped again for the data attribute; the browser decodes
           that outer layer before Bootstrap treats the value as HTML. #}
        {% set popBody = reservation.startdate|date('d.m.Y') ~ " - " ~ reservation.enddate|date('d.m.Y') %}
        {% set phones = "" %}{% set mails = "" %}{% set mobiles = "" %}{% set invoiceNumbers = "" %}
        {% set phoneList = [] %}{% set mobileList = [] %}{% set mailList = [] %}
        {% set businessCompany = null %}
        {% if reservation.booker is defined and reservation.booker is not null %}
            {# Collected first, so the separators only go between values and a number or
               address shared by private and business address appears once #}
            {% for address in reservation.booker.customerAddresses %}
                {% if businessCompany is null and address.type == 'CUSTOMER_ADDRESS_TYPE_BUSINESS' and address.company is not empty %}
                    {% set businessCompany = address.company|e %}
                {% endif %}
                {% if address.phone|trim is not empty and address.phone|trim not in phoneList %}
                    {% set phoneList = phoneList|merge([address.phone|trim]) %}
                {% endif %}
                {% if address.mobilePhone|trim is not empty and address.mobilePhone|trim not in mobileList %}
                    {% set mobileList = mobileList|merge([address.mobilePhone|trim]) %}
                {% endif %}
                {% if address.email|trim is not empty and address.email|trim|lower not in mailList|map(mail => mail|lower) %}
                    {% set mailList = mailList|merge([address.email|trim]) %}
                {% endif %}
            {% endfor %}
        {% endif %}
        {% for number in phoneList %}
            {% set phones = phones ~ popoverMacros.tel_link(number) ~ (loop.last ? "" : ", ") %}
        {% endfor %}
        {% for number in mobileList %}
            {% set mobiles = mobiles ~ popoverMacros.tel_link(number) ~ (loop.last ? "" : ", ") %}
        {% endfor %}
        {% for address in mailList %}
            {% set mails = mails ~ popoverMacros.mail_link(address) ~ (loop.last ? "" : ", ") %}
        {% endfor %}
        {% for invoice in reservation.invoices %}
            {% set invoiceStatus = enum('App\\Entity\\Enum\\InvoiceStatus').fromStatus(invoice.status) %}
            {% set invoiceNumbers = invoiceNumbers ~ (is_granted('ROLE_INVOICES') ? popoverMacros.invoice_link(invoice) : invoice.number|e) %}
            {% if invoiceStatus %}{% set invoiceNumbers = invoiceNumbers ~ " (" ~ (invoiceStatus.labelKey|trans)|e ~ ")" %}{% endif %}
            {% if not loop.last %}{% set invoiceNumbers = invoiceNumbers ~ ", " %}{% endif %}
        {% endfor %}
        {# With an invoice the popover states the invoice status instead of the reservation status #}
        {% if invoiceNumbers is empty %}
            {% set popBody = popBody ~ " <i>(" ~ (reservation.reservationStatus|display_name)|e ~ ")</i>" %}
        {% endif %}
        {% if businessCompany %}
            {% set popBody = businessCompany ~ "<br />" ~ popBody %}
        {% endif %}
        {# Label/value pairs, the values already escaped. Arrival and departure share a row:
           the first time set gives the label, a departure after an arrival follows in the value. #}
        {% set details = [] %}
        {% if invoiceNumbers|length > 0 %}{% set details = details|merge([['invoice.number.short'|trans, invoiceNumbers]]) %}{% endif %}
        {% if phones|length > 0 %}{% set details = details|merge([['customer.phone'|trans, phones]]) %}{% endif %}
        {% if mobiles|length > 0 %}{% set details = details|merge([['customer.mobilephone'|trans, mobiles]]) %}{% endif %}
        {% if mails|length > 0 %}{% set details = details|merge([['customer.email'|trans, mails]]) %}{% endif %}
        {% if reservation.arrivalTime %}
            {% set times = reservation.arrivalTime|date('H:i') %}
            {% if reservation.departureTime %}
                {% set times = times ~ " <span class='text-body-secondary ms-2'>" ~ ('reservation.departureTime'|trans)|e ~ "</span> " ~ reservation.departureTime|date('H:i') %}
            {% endif %}
            {% set details = details|merge([['reservation.arrivalTime'|trans, times]]) %}
        {% elseif reservation.departureTime %}
            {% set details = details|merge([['reservation.departureTime'|trans, reservation.departureTime|date('H:i')]]) %}
        {% endif %}
        {% if details is not empty %}
            {% set popBody = popBody ~ "<div class='reservation-popover-details'>" %}
            {% for detail in details %}
                {% set popBody = popBody ~ "<span class='text-body-secondary'>" ~ detail[0]|e ~ "</span><span>" ~ detail[1] ~ "</span>" %}
            {% endfor %}
            {% set popBody = popBody ~ "</div>" %}
        {% endif %}
        {% if reservation.remark|length > 0 %}{% set popBody = popBody ~ "<div class='mt-1'>" ~ reservation.remark|e|nl2br ~ "</div>" %}{% endif %}
        {% if reservation.calendarSyncImport is defined and reservation.calendarSyncImport is not null %}
            {% set popBody = popBody ~ "<div class='mt-1'><i class='fas fa-cloud-download-alt'></i> " ~ reservation.calendarSyncImport.name|e ~ "</div>" %}
        {% endif %}
        {{ popBody }}
    {% endif %}
{% endblock %}
