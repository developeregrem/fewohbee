{% extends 'base.html.twig' %}
{% use "common/delete_popover.html.twig" %}

{% block title %}
    {{ parent() }} -  Appartmentverwaltung
{% endblock %}

{% block description %}
    {{ parent() }} -  Appartmentverwaltung
{% endblock %}

{% block page_title %}{{ 'nav.appartment'|trans }}{% endblock %}

{% block content %}
    {# The rooms come ordered by property: one card per property, like the price groups #}
    {% set groups = [] %}
    {% for apartment in apartments %}
        {% set subsidiary = apartment.object ?? null %}
        {% if groups is empty or (groups|last).subsidiaryId != (subsidiary.id ?? null) %}
            {% set groups = groups|merge([{subsidiary: subsidiary, subsidiaryId: subsidiary.id ?? null, apartments: [apartment]}]) %}
        {% else %}
            {% set last = groups|last %}
            {% set groups = groups|slice(0, -1)|merge([last|merge({apartments: last.apartments|merge([apartment])})]) %}
        {% endif %}
    {% endfor %}
    <div class="container fab-add-clearance" data-controller="settings">
        <twig:PageHeader :title="'nav.appartment'|trans" :back="path('settings.overview')" :backLabel="'nav.settings'|trans">
            <twig:AddButton :label="'nav.appartment.add'|trans"
                            data-action="click->settings#openModalAction"
                            data-url="{{ path('apartments.new.apartment') }}"
                            data-title="{{ 'nav.appartment.add'|trans }}"
                            data-bs-toggle="modal" data-bs-target="#modalCenter"/>
        </twig:PageHeader>

        {% for group in groups %}
            {# Card markup written out: the delete popover's block is not reachable inside a component #}
            <div class="card data-card{{ not loop.last ? ' mb-3' }}">
                {% if group.subsidiary %}
                    <div class="data-toolbar">
                        <h2 class="h6 mb-0">{{ group.subsidiary.name }}</h2>
                    </div>
                {% endif %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle data-table data-table-stack" data-controller="row-link" data-action="click->row-link#open">
                        <thead>
                        <tr>
                            <th>{{ 'appartment.number'|trans }}</th>
                            <th>{{ 'appartment.description'|trans }}</th>
                            <th class="text-end">{{ 'appartment.bedsmax'|trans }}</th>
                            <th class="data-table-actions"><span class="visually-hidden">{{ 'appartment.action'|trans }}</span></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for apartment in group.apartments %}
                            <tr{% if not apartment.active %} class="is-inactive"{% endif %}>
                                <td>
                                    <a href="#" class="data-table-link" data-row-link-target="link"
                                       data-action="click->settings#openModalAction"
                                       data-url="{{ path('apartments.edit.apartment', {'id': apartment.id}) }}"
                                       data-title="{{ 'appartment.edit'|trans }}"
                                       data-bs-toggle="modal" data-bs-target="#modalCenter">
                                        <span class="data-table-link-text">{{ apartment.number }}</span>
                                    </a>
                                    {% if apartment.multipleOccupancy %}
                                        <i class="fa-solid fa-users text-body-secondary ms-1" title="{{ 'apartment.multiple.occupancy.text'|trans }}" aria-label="{{ 'apartment.multiple.occupancy.text'|trans }}"></i>
                                    {% endif %}
                                    {% if apartment.isEventSpace %}
                                        <i class="fa-solid fa-people-roof text-body-secondary ms-1" title="{{ 'category.kind.event_space'|trans }}" aria-label="{{ 'category.kind.event_space'|trans }}"></i>
                                    {% endif %}
                                    <span class="cell-narrow badge text-secondary-emphasis bg-secondary-subtle ms-1" data-inactive-badge {{ apartment.active ? 'hidden' }}>{{ 'base.inactive'|trans }}</span>
                                </td>
                                <td class="cell-meta">{{ apartment.description }}</td>
                                <td class="cell-meta text-md-end">
                                    <span class="cell-narrow">{{ 'appartment.bedsmax'|trans }}: </span>{{ apartment.bedsmax }}
                                </td>
                                <td class="cell-actions data-table-actions text-end">
                                    <twig:ActiveToggle :action="path('apartments.toggle.apartment', {'id': apartment.id})"
                                                       :token="csrf_token('apartment-toggle-' ~ apartment.id)" :active="apartment.active"
                                                       :enableLabel="'button.enable'|trans" :disableLabel="'button.disable'|trans"
                                                       fetch inactiveClass="is-inactive"/>
                                    <twig:IconButton icon="arrows-rotate" :label="'calendar.sync.title'|trans"
                                                     data-action="click->settings#openModalAction"
                                                     data-url="{{ path('apartments.sync.edit', {'id': apartment.calendarSync.id}) }}"
                                                     data-title="{{ 'calendar.sync.title'|trans }}"
                                                     data-modal-size="lg"
                                                     data-bs-toggle="modal" data-bs-target="#modalCenter"/>
                                    {% set id = apartment.id %}
                                    {% set targetUrl = path('appartments.delete.appartment', {'id': apartment.id}) %}
                                    <button type="button" class="btn btn-icon text-danger"
                                            title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}"
                                            data-popover="delete"
                                            data-title="{{ 'appartment.delete.ask'|trans }}"
                                            data-bs-content='{{ block('deletePopoverContent') }}'>
                                        <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="data-footer">
                    <span>{{ 'category.rooms'|trans({'%count%': group.apartments|length}) }}</span>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
