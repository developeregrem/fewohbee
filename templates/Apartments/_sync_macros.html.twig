{% macro toggle(field) %}
    <div class="d-flex align-items-start justify-content-between gap-3">
        <div class="flex-grow-1">
            <label for="{{ field.vars.id }}" class="fw-semibold mb-1">
                {{ field.vars.label|trans(field.vars.label_translation_parameters, field.vars.translation_domain) }}
            </label>
            {{ form_help(field, {'help_attr': {'class': 'text-body-secondary mt-0'}}) }}
            {{ form_errors(field) }}
        </div>
        <div class="flex-shrink-0">
            {{ form_widget(field, {
                'label': false,
                'label_attr': {'class': 'checkbox-switch'},
                'attr': {'role': 'switch', 'aria-describedby': field.vars.id ~ '_help'}
            }) }}
        </div>
    </div>
{% endmacro %}

{% macro calendar_address(id, address, label, hint, icon) %}
    <label class="form-label fw-semibold mb-2" for="{{ id }}">
        <i class="fas {{ icon }} text-body-secondary me-2" aria-hidden="true"></i>{{ label|trans }}
    </label>
    <div class="d-flex align-items-center gap-1" data-controller="copy" data-copy-hint-value="{{ 'copy.sucess'|trans }}">
        <input type="text" class="form-control form-control-sm text-body"
               id="{{ id }}" value="{{ address }}" readonly autocomplete="off"
               aria-describedby="{{ id }}-help" data-copy-target="input">
        <button class="btn btn-sm border-0 shadow-none text-body-secondary" type="button"
                title="{{ 'copy.text'|trans }}" aria-label="{{ 'copy.text'|trans }}" data-action="click->copy#copy">
            <i class="fas fa-copy" aria-hidden="true"></i>
        </button>
    </div>
    <p class="small text-body-secondary mt-2 mb-0" id="{{ id }}-help">{{ hint|trans }}</p>
{% endmacro %}
