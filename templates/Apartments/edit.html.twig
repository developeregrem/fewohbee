{{ form_start(form, {'attr': {
    'id':'entry-form-'~apartment.id,
    'data-controller':'settings',
    'data-action':'submit->settings#submitFormAction',
    'data-url': path('apartments.edit.apartment', {'id': apartment.id})
} }) }}
    <div class="modal-body px-lg-5">
        <div id="flash-message-overlay">
        </div>
        {# Opens ready to edit: only admins reach it, a read-only step adds nothing #}
        <div class="row mt-3">
            <div class="col">                             
                {{ include('Apartments/_form.html.twig') }}
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'button.cancel'|trans }}</button>
        <input type="submit" value="{{ 'button.save'|trans }}" id="entry-submit-{{ apartment.id }}"
               class="btn btn-primary"/>
    </div>
{{ form_end(form) }}
