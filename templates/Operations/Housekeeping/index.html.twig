{% extends 'base.html.twig' %}

{% block title %}{{ 'housekeeping.title'|trans({}, 'Housekeeping') }}{% endblock %}

{% block content %}
    <div class="container" data-controller="housekeeping swipe-nav">
        {% set dayUrl = path('operations.housekeeping', { date: selectedDate|date('Y-m-d'), subsidiary: selectedSubsidiaryId, view: 'day' }) %}
        {% set weekUrl = path('operations.housekeeping', { date: selectedDate|date('Y-m-d'), subsidiary: selectedSubsidiaryId, view: 'week' }) %}
        <twig:PageHeader :title="'housekeeping.title'|trans({}, 'Housekeeping')">
            <div class="btn-group view-switch" role="group" aria-label="{{ 'reservation.table.view.label'|trans }}">
                <a class="btn btn-secondary{{ view == 'day' ? ' active' }}" href="{{ dayUrl }}"
                   {%- if view == 'day' %} aria-current="page"{% endif %}>{{ 'housekeeping.view.day'|trans({}, 'Housekeeping') }}</a>
                <a class="btn btn-secondary{{ view == 'week' ? ' active' }}" href="{{ weekUrl }}"
                   {%- if view == 'week' %} aria-current="page"{% endif %}>{{ 'housekeeping.view.week'|trans({}, 'Housekeeping') }}</a>
            </div>
        </twig:PageHeader>

        <form method="get" action="{{ path('operations.housekeeping') }}" class="mb-3"
              data-housekeeping-target="form"
              data-action="change->housekeeping#submitFilters submit->housekeeping#spin">
            {# The day or the week: arrows, swipe (swipe-nav) or the field; the filters fold out below #}
            <div class="page-toolbar">
                <twig:DatePager name="date" :value="selectedDate|date('Y-m-d')" :stepDays="view == 'week' ? 7 : 1"/>
                <div class="page-toolbar-tools">
                    <button type="button" class="btn btn-icon" data-action="click->housekeeping#submitFilters"
                            title="{{ 'housekeeping.apply'|trans({}, 'Housekeeping') }}" aria-label="{{ 'housekeeping.apply'|trans({}, 'Housekeeping') }}">
                        <i class="fas fa-sync-alt" data-housekeeping-target="spinner" aria-hidden="true"></i>
                    </button>
                    {% set exportRange = view == 'day' ? 'day' : 'week' %}
                    <twig:IconButton icon="file-csv" :label="('housekeeping.export.' ~ exportRange)|trans({}, 'Housekeeping')"
                                     :href="path('operations.housekeeping.export', { date: selectedDate|date('Y-m-d'), subsidiary: selectedSubsidiaryId, range: exportRange, occupancyTypes: selectedOccupancyTypes, statuses: selectedStatusIds })"/>
                    <twig:IconButton icon="sliders-h" :label="'operations.filter.title'|trans"
                                     data-bs-toggle="collapse" data-bs-target="#housekeepingFilters"
                                     aria-expanded="false" aria-controls="housekeepingFilters"/>
                </div>
            </div>
            <div class="collapse" id="housekeepingFilters">
                <div class="card card-body border mt-2 py-2 px-3">
                    <div class="d-flex flex-wrap align-items-end gap-3">
                        <div style="min-width:180px">
                            <label class="form-label small mb-1">{{ 'housekeeping.subsidiary'|trans({}, 'Housekeeping') }}</label>
                            <select name="subsidiary" class="form-select form-select-sm">
                                <option value="all"{% if selectedSubsidiaryId == 'all' %} selected{% endif %}>
                                    {{ 'housekeeping.subsidiary.all'|trans({}, 'Housekeeping') }}
                                </option>
                                {% for subsidiary in subsidiaries %}
                                    <option value="{{ subsidiary.id }}"{% if selectedSubsidiaryId == subsidiary.id %} selected{% endif %}>
                                        {{ subsidiary.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="vr d-none d-md-block"></div>
                        <div class="d-flex flex-wrap gap-2">
                            {% for occType in occupancyTypes %}
                                <label class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" name="occupancyTypes[]"
                                           value="{{ occType }}"{% if occType in selectedOccupancyTypes %} checked{% endif %}>
                                    <span class="form-check-label small">
                                        {{ occupancyLabels[occType]|trans({}, 'Housekeeping') }}
                                    </span>
                                </label>
                            {% endfor %}
                        </div>
                        <div class="vr d-none d-md-block"></div>
                        <div>
                            <div class="form-label small mb-1">{{ 'operations.filter.reservationStatus'|trans }}</div>
                            <div class="d-flex flex-wrap gap-2">
                                {% set statusDefault = selectedStatusIds is empty %}
                                {% for status in reservationStatuses %}
                                    <label class="form-check form-check-inline mb-0">
                                        <input class="form-check-input" type="checkbox" name="statuses[]"
                                               value="{{ status.id }}"{% if status.id in selectedStatusIds or (statusDefault and status.isBlocking) %} checked{% endif %}>
                                        <twig:StatusBadge :status="status"/>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <input type="hidden" name="view" value="{{ view }}">
        </form>

        <div data-housekeeping-target="content">
            {% include 'Operations/Housekeeping/_content.html.twig' %}
        </div>
    </div>
{% endblock %}
