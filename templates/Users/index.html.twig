{% extends 'base.html.twig' %}
{% use "common/delete_popover.html.twig" %}

{% block title %}
    {{ parent() }} -  Benutzerverwaltung
{% endblock %}

{% block description %}
    {{ parent() }} -  Userverwaltung
{% endblock %}

{% block page_title %}{{ 'nav.user'|trans }}{% endblock %}

{% block content %}
<div class="container fab-add-clearance" data-controller="settings">
    <twig:PageHeader :title="'nav.user'|trans" :back="path('settings.overview')" :backLabel="'nav.settings'|trans">
        <twig:AddButton :label="'nav.user.add'|trans"
                        data-action="click->settings#openModalAction"
                        data-url="{{ path('users.new.user') }}"
                        data-title="{{ 'nav.user.add'|trans }}"
                        data-bs-toggle="modal" data-bs-target="#modalCenter"/>
    </twig:PageHeader>

    {# Card markup written out: the delete popover's block is not reachable inside a component #}
    <div class="card data-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle data-table data-table-stack" data-controller="row-link" data-action="click->row-link#open">
                <thead>
                <tr>
                    <th>{{ 'user.lastname'|trans }}, {{ 'user.firstname'|trans }}</th>
                    <th>{{ 'user.username'|trans }}</th>
                    <th>{{ 'user.role'|trans }}</th>
                    <th class="data-table-actions"><span class="visually-hidden">{{ 'user.action'|trans }}</span></th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    {% set isSelf = app.user and app.user.id == user.id %}
                    <tr{% if not user.active %} class="is-inactive"{% endif %}>
                        <td>
                            <a href="#" class="data-table-link" data-row-link-target="link"
                               data-action="click->settings#openModalAction"
                               data-url="{{ path('users.edit.user', {'id': user.id}) }}"
                               data-title="{{ 'user.edit'|trans }}"
                               data-bs-toggle="modal" data-bs-target="#modalCenter">
                                <twig:Avatar :initials="user.firstname|first ~ user.lastname|first"/>
                                <span class="data-table-link-text">
                                    {{- user.lastname }}{% if user.firstname is not empty %}, {{ user.firstname }}{% endif -%}
                                </span>
                            </a>
                            {% if oidc_enabled and user.linkedToOidc %}
                                <span class="badge text-secondary-emphasis bg-secondary-subtle ms-1 align-middle" title="{{ user.oidcIssuer }}">{{ 'user.oidc.badge'|trans }}</span>
                            {% endif %}
                            <span class="cell-narrow badge text-secondary-emphasis bg-secondary-subtle ms-1" data-inactive-badge {{ user.active ? 'hidden' }}>{{ 'base.inactive'|trans }}</span>
                        </td>
                        <td class="cell-meta">{{ user.username }}</td>
                        <td class="cell-meta">{{ user.roleEntities|map(role => role.role|trans)|join(', ') }}</td>
                        <td class="cell-actions data-table-actions text-end">
                            {# Unlinking single sign-on first, so switch and delete stay in their places in every row.
                               Both popovers share the deletePopoverContent block, so every
                               variable it reads is set explicitly for each one - leaving a value
                               from the previous row in place would produce duplicate form ids. #}
                            {% if oidc_enabled and user.linkedToOidc %}
                                {% set id = user.id %}
                                {% set formId = 'unlink-' ~ user.id %}
                                {% set targetUrl = path('users.unlink.sso', {'id': user.id}) %}
                                {% set deletePopoverHint = 'user.oidc.unlink_confirm'|trans %}
                                <button type="button" class="btn btn-icon"
                                        title="{{ 'user.oidc.unlink'|trans }}" aria-label="{{ 'user.oidc.unlink'|trans }}"
                                        data-popover="delete"
                                        data-title="{{ 'user.oidc.unlink'|trans }}"
                                        data-bs-content='{{ block('deletePopoverContent') }}'>
                                    <i class="fas fa-link-slash" aria-hidden="true"></i>
                                </button>
                            {% endif %}
                            {# One's own account stays on: switched off it could not log in to switch back #}
                            {% if isSelf %}
                                <span class="icon-slot" aria-hidden="true"></span>
                            {% else %}
                                <twig:ActiveToggle :action="path('users.toggle.user', {'id': user.id})"
                                                   :token="csrf_token('user-toggle-' ~ user.id)" :active="user.active"
                                                   :enableLabel="'button.enable'|trans" :disableLabel="'button.disable'|trans"
                                                   fetch inactiveClass="is-inactive"/>
                            {% endif %}
                            {% set id = user.id %}
                            {% set formId = user.id %}
                            {% set targetUrl = path('users.delete.user', {'id': user.id}) %}
                            {% set deletePopoverHint = '' %}
                            <button type="button" class="btn btn-icon text-danger"
                                    title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}"
                                    data-popover="delete"
                                    data-title="{{ 'user.delete.ask'|trans }}"
                                    data-bs-content='{{ block('deletePopoverContent') }}'>
                                <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
