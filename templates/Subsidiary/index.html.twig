{% extends 'base.html.twig' %}
{% use "common/delete_popover.html.twig" %}

{% block title %}
    {{ parent() }} -  {{ 'object.title'|trans }}
{% endblock %}

{% block description %}
    {{ parent() }} -  {{ 'object.description'|trans }}
{% endblock %}

{% block page_title %}{{ 'nav.object'|trans }}{% endblock %}

{% block content %}
<div class="container fab-add-clearance" data-controller="settings">
    <twig:PageHeader :title="'nav.object'|trans" :back="path('settings.overview')" :backLabel="'nav.settings'|trans">
        <twig:AddButton :label="'nav.object.add'|trans"
                        data-action="click->settings#openModalAction"
                        data-url="{{ path('objects.new.object') }}"
                        data-title="{{ 'nav.object.add'|trans }}"
                        data-bs-toggle="modal" data-bs-target="#modalCenter"/>
    </twig:PageHeader>

    {# Card markup written out: the delete popover's block is not reachable inside a component #}
    <div class="card data-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle data-table data-table-stack" data-controller="row-link" data-action="click->row-link#open">
                <thead>
                <tr>
                    <th>{{ 'object.name'|trans }}</th>
                    <th>{{ 'object.description'|trans }}</th>
                    <th class="text-end">{{ 'nav.appartment'|trans }}</th>
                    <th class="data-table-actions"><span class="visually-hidden">{{ 'object.action'|trans }}</span></th>
                </tr>
                </thead>
                <tbody>
                {% for object in objects %}
                    {% set rooms = object.appartments|length %}
                    <tr>
                        <td>
                            <a href="#" class="data-table-link" data-row-link-target="link"
                               data-action="click->settings#openModalAction"
                               data-url="{{ path('objects.get.object', {'id': object.id}) }}"
                               data-title="{{ 'object.edit'|trans }}"
                               data-bs-toggle="modal" data-bs-target="#modalCenter">
                                <span class="data-table-link-text">{{ object.name }}</span>
                            </a>
                        </td>
                        <td class="cell-meta">{{ object.description }}</td>
                        <td class="cell-meta text-end">
                            <span class="cell-wide">{{ rooms }}</span>
                            <span class="cell-narrow">{{ 'category.rooms'|trans({'%count%': rooms}) }}</span>
                        </td>
                        <td class="cell-actions data-table-actions text-end">
                            {% set id = object.id %}
                            {% set targetUrl = path('objects.delete.object', {'id': object.id}) %}
                            <button type="button" class="btn btn-icon text-danger"
                                    title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}"
                                    data-popover="delete"
                                    data-title="{{ 'object.delete.ask'|trans }}"
                                    data-bs-content='{{ block('deletePopoverContent') }}'>
                                <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="data-footer">
            <span>{{ 'object.list.count'|trans({'%count%': objects|length}) }}</span>
        </div>
    </div>
</div>
{% endblock %}
