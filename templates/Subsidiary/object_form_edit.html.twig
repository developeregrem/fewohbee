<form id="entry-form-{{ object.id }}" role="form" method="POST"
      data-controller="settings"
      data-action="submit->settings#submitFormAction"
      data-url="{{ path('objects.edit.object', {'id': object.id}) }}">
    <div class="modal-body ps-3 pe-3">
        <div id="flash-message-overlay">
        </div>
        <div class="row">
            <div class="col">                
                {% include 'Subsidiary/object_form_input_fields.html.twig' %}
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'button.cancel'|trans }}</button>
        <input type="submit" value="{{ 'button.save'|trans }}" id="entry-submit-{{ object.id }}"
               class="btn btn-primary">
    </div>
</form>
