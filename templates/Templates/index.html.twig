{% extends 'base.html.twig' %}
{% use "common/delete_popover.html.twig" %}

{% block title %}
    {{ parent() }} -  {{ 'templates.title'|trans }}
{% endblock %}

{% block description %}
    {{ parent() }} -  {{ 'templates.description'|trans }}
{% endblock %}

{% block content %}
<div class="container" data-controller="settings templates">
    <div class="row">
        <div class="col d-flex align-items-center gap-2">
            {% if operationsTemplatesMissing %}
                <div class="alert alert-info alert-dismissible fade show d-flex flex-wrap align-items-center gap-2"
                     role="alert"
                     data-templates-target="importNotice">
                    <div>
                        <strong>{{ 'templates.operations.import.title'|trans }}</strong>
                        {{ 'templates.operations.import.text'|trans }}
                    </div>
                    <form method="post" action="{{ path('settings.templates.import.operations') }}" class="ms-auto">
                        <input type="hidden" name="_csrf_token" value="{{ importToken }}">
                        <button type="submit" class="btn btn-secondary btn-sm">
                            {{ 'templates.operations.import.button'|trans }}
                        </button>
                    </form>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="{{ 'button.close'|trans }}"
                            data-action="templates#dismissImportNotice">
                    </button>
                </div>
            {% endif %}
            <a class="btn btn-secondary" href="{{ path('settings.templates.new.page') }}">
                <i class="fas fa-plus" aria-hidden="true"></i> {{ 'templates.add'|trans }}
            </a>
            <button type="button"
                    class="btn btn-outline-secondary ms-auto"
                    data-action="click->settings#openModalAction"
                    data-url="{{ path('settings.templates.fonts.manage') }}"
                    data-title="{{ 'templates.fonts.title'|trans }}"
                    data-modal-size="lg"
                    data-bs-toggle="modal"
                    data-bs-target="#modalCenter"
                    title="{{ 'templates.fonts.open'|trans }}"
                    aria-label="{{ 'templates.fonts.open'|trans }}">
                <i class="fas fa-cog" aria-hidden="true"></i>
            </button>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col">
            {% set lastTypeId = null %}
            {# Language variants are listed under the template they translate. #}
            {% for template in templates|filter(t => not t.isVariant()) %}
                {% if lastTypeId != template.templateType.id %}
                    {% if lastTypeId is not null %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    {% endif %}
                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="fas {{ template.templateType.icon }}" aria-hidden="true"></i>
                            {{ template.templateType.name|trans }}
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-bordered table-hover mb-0" style="table-layout: fixed;">
                                <colgroup>
                                    <col style="width: 70%;">
                                    <col style="width: 15%;">
                                    <col style="width: 15%;">
                                </colgroup>
                                <thead>
                                <tr>
                                    <th>{{ 'templates.name'|trans }}</th>
                                    <th>Default</th>
                                    <th>{{ 'base.action'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                    {% set lastTypeId = template.templateType.id %}
                {% endif %}
                {% for row in [template]|merge(template.variants.toArray) %}
                <tr>
                    <td>
                        {% if row.isVariant() %}
                            <span class="ms-3 text-body-secondary"><i class="fas fa-level-up-alt fa-rotate-90 me-2" aria-hidden="true"></i></span>{{ row.name }}
                            <span class="badge text-bg-light border ms-1" title="{{ 'templates.variant.badge'|trans }}">{{ row.locale|upper }}</span>
                        {% else %}
                            {{ row.name }}
                        {% endif %}
                    </td>
                    <td class="text-center">
                        {% if row.isDefault %}
                            <i class="fas fa-check text-success" aria-hidden="true"></i>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('settings.templates.edit.page', {'id': row.id}) }}" title="{{ 'button.edit'|trans }}">
                            <i class="fas fa-edit" aria-hidden="true"></i></a>
                        {% set missingLocales = row.isVariant() ? [] : guest_extra_locales()|filter(locale => row.variant(locale) is null) %}
                        {% if missingLocales is not empty %}
                            <span class="dropdown">
                                <a href="#" data-bs-toggle="dropdown" aria-expanded="false" title="{{ 'templates.variant.add'|trans }}">
                                    <i class="fas fa-language" aria-hidden="true"></i></a>
                                <form method="post" action="{{ path('settings.templates.variant.create', {'id': row.id}) }}" class="dropdown-menu">
                                    <input type="hidden" name="_token" value="{{ csrf_token('template-variant' ~ row.id) }}">
                                    <h6 class="dropdown-header">{{ 'templates.variant.add'|trans }}</h6>
                                    {% for locale in missingLocales %}
                                        <button type="submit" class="dropdown-item" name="locale" value="{{ locale }}">{{ language_name(locale, false) }}</button>
                                    {% endfor %}
                                </form>
                            </span>
                        {% endif %}
                        {% set id = row.id %}
                        {% set targetUrl = path('settings.templates.delete', {'id': row.id}) %}
                        {% set deletePopoverHint = row.variants is not empty ? 'templates.variant.delete_hint'|trans : '' %}
                        <a href="#" title="{{ 'button.delete'|trans }}">
                            <i class="fas fa-trash-alt"
                                data-popover="delete"
                                data-title="{{ 'registrationbook.delete.ask'|trans }}"
                                data-bs-content='{{ block('deletePopoverContent') }}'></i></a>
                    </td>
                </tr>
                {% endfor %}
            {% endfor %}
            {% if lastTypeId is not null %}
                                </tbody>
                            </table>
                        </div>
                    </div>
            {% endif %}
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
