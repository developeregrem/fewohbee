{# The prices of one group of room categories, room prices and then other prices. The
   description opens the price for editing; on phones a price is a block: description, then persons, period,
   weekdays and amount beneath. #}
{% use "common/delete_popover.html.twig" %}

<div class="table-responsive">
<table class="table table-hover align-middle data-table data-table-stack price-table" data-controller="row-link" data-action="click->row-link#open">
<thead>
<tr>
    <th>{{ 'price.description'|trans }}</th>
    <th class="text-center">{{ 'price.persons'|trans }}</th>
    <th>{{ 'price.season'|trans }}</th>
    <th>{{ 'price.daysinweek'|trans }}</th>
    <th class="text-end">{{ 'price.price'|trans }}</th>
    <th class="text-end">{{ 'price.vat'|trans }}</th>
    <th class="data-table-actions"><span class="visually-hidden">{{ 'base.action'|trans }}</span></th>
</tr>
</thead>
{# Room prices first, then other prices; an icon before the name tells them apart #}
{% set sections = [
    {'prices': apartmentPrices, 'type': 'price.appartment', 'icon': 'fa-bed'},
    {'prices': miscPrices, 'type': 'price.miscellaneous', 'icon': 'fa-tag'},
] %}
{% for section in sections|filter(section => section.prices is not empty) %}
<tbody>
    {% for price in section.prices %}
    {% set vat = price.vat|number_format(is_decimal_place_0(price.vat) ? 0 : 2, ',', '.') %}
    <tr{% if price.active == false %} class="price-inactive"{% endif %}>
        <td>
            <a href="#" class="data-table-link" data-row-link-target="link"
               data-action="click->settings#openModalAction"
               data-url="{{ path('prices.get.price', {'id': price.id}) }}"
               data-title="{{ 'price.edit'|trans }}"
               data-bs-toggle="modal" data-bs-target="#modalCenter"
               title="{{ 'button.edit'|trans }}">
                <span class="price-type" title="{{ section.type|trans }}"><i class="fas {{ section.icon }}" aria-hidden="true"></i><span class="visually-hidden">{{ section.type|trans }}: </span></span>
                <span class="data-table-link-text">{{ price.description }}</span>
            </a>
            {% if price.isPackage %}
                {% set packageComponentCount = price.components|length %}
                <span class="badge text-secondary-emphasis bg-secondary-subtle ms-1 align-middle"
                      data-bs-toggle="tooltip"
                      title="{{ 'price.package.overview.tooltip'|trans({'%count%': packageComponentCount}) }}">
                    <i class="fas fa-layer-group" aria-hidden="true"></i> {{ 'price.package.overview.badge'|trans({'%count%': packageComponentCount}) }}
                </span>
            {% endif %}
            <span class="cell-narrow badge text-secondary-emphasis bg-secondary-subtle ms-1" data-inactive-badge {{ price.active ? 'hidden' }}>{{ 'price.inactive'|trans }}</span>
        </td>
        <td class="cell-meta text-center">
            <span class="cell-narrow">{{ 'price.persons'|trans }}: </span>
            {%- if price.numberOfPersons is not null -%}
                {{ price.hasExtraPersonSurcharge ? 'price.numberofpersons.up_to_count'|trans({'%count%': price.numberOfPersons}) : price.numberOfPersons }}
                {% if price.hasExtraPersonSurcharge %}
                    <div class="small text-body-secondary text-nowrap">{{ 'price.extra_person_surcharge.short'|trans({'%amount%': price.extraPersonSurcharge|number_format(2, ',', '.') ~ ' ' ~ currency_symbol}) }}</div>
                {% endif %}
            {%- else -%}
                -
            {%- endif -%}
        </td>
        <td class="cell-meta">
            <span class="cell-narrow">{{ 'price.season'|trans }}: </span>
            {%- if price.allPeriods -%}
                {{ 'price.abbreviation.alldays'|trans }}
            {%- else -%}
                {% for pricePeriod in price.pricePeriods %}
                    <span class="d-block d-md-inline-block text-nowrap">{{ pricePeriod.start|date('d.m.Y') }} - {{ pricePeriod.end|date('d.m.Y') }}{% if pricePeriod.description %} <span class="text-body-secondary small">{{ pricePeriod.description }}</span>{% endif %}</span>
                {% endfor %}
            {%- endif -%}
        </td>
        <td class="cell-meta">
            <span class="cell-narrow">{{ 'price.daysinweek'|trans }}: </span>
            {%- if price.alldays -%}
                {{ 'price.abbreviation.alldays'|trans }}
            {%- else -%}
                {% for day in ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'] %}{% if attribute(price, day) %}{{ ('price.abbreviation.' ~ day)|trans }} {% endif %}{% endfor %}
            {%- endif -%}
        </td>
        <td class="cell-meta text-end text-nowrap price-amount">
            {{- price.price|number_format(2, ',', '.') }}<span class="cell-narrow"> {{ currency_symbol }} · {{ 'price.vat'|trans }} {{ vat }} %</span>
        </td>
        <td class="cell-wide text-end">{{ vat }}</td>
        <td class="cell-actions data-table-actions text-end">
            <twig:ActiveToggle :action="path('prices.toggle.price', {'id': price.id})"
                               :token="csrf_token('price-toggle-' ~ price.id)" :active="price.active"
                               :enableLabel="'price.enable'|trans" :disableLabel="'price.disable'|trans"
                               fetch inactiveClass="price-inactive"/>
            {% set id = price.id %}
            {% set targetUrl = path('prices.delete.price', {'id': price.id}) %}
            <button type="button" class="btn btn-icon text-danger"
                    title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}"
                    data-popover="delete"
                    data-title="{{ 'registrationbook.delete.ask'|trans }}"
                    data-bs-content='{{ block('deletePopoverContent') }}'>
                <i class="fas fa-trash-alt" aria-hidden="true"></i>
            </button>
        </td>
    </tr>
    {% endfor %}
</tbody>
{% endfor %}
</table>
</div>
