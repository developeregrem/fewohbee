{% extends 'base.html.twig' %}
{% use "common/delete_popover.html.twig" %}

{% block title %}
    {{ parent() }} - {{ 'calendar.index.title'|trans }}
{% endblock %}

{% block page_title %}{{ 'nav.calendars'|trans }}{% endblock %}

{% block content %}
<div class="container fab-add-clearance" data-controller="settings">
    <twig:PageHeader :title="'calendar.index.title'|trans" :back="path('settings.overview')" :backLabel="'nav.settings'|trans">
        <twig:AddButton :label="'calendar.index.add'|trans"
                        data-action="click->settings#openModalAction"
                        data-url="{{ path('settings.calendars.new') }}"
                        data-title="{{ 'calendar.form.title_new'|trans }}"
                        data-bs-toggle="modal" data-bs-target="#modalCenter"/>
    </twig:PageHeader>
    <p class="text-body-secondary small mb-3">{{ 'calendar.index.description'|trans }}</p>

    {# Card markup written out: the delete popover's block is not reachable inside a component #}
    <div class="card data-card">
        {% if calendars is empty %}
            <twig:EmptyState icon="calendar-days" :title="'calendar.index.empty'|trans"/>
        {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle data-table data-table-stack" data-controller="row-link" data-action="click->row-link#open">
                <thead>
                <tr>
                    <th>{{ 'calendar.index.table.name'|trans }}</th>
                    <th>{{ 'calendar.index.table.source'|trans }}</th>
                    <th class="text-end">{{ 'calendar.index.table.entries'|trans }}</th>
                    <th class="data-table-actions"><span class="visually-hidden">{{ 'base.action'|trans }}</span></th>
                </tr>
                </thead>
                <tbody>
                {% for calendar in calendars %}
                    <tr>
                        <td>
                            <a href="#" class="data-table-link" data-row-link-target="link"
                               data-action="click->settings#openModalAction"
                               data-url="{{ path('settings.calendars.edit', {'id': calendar.id}) }}"
                               data-title="{{ 'calendar.form.title_edit'|trans }}"
                               data-bs-toggle="modal" data-bs-target="#modalCenter">
                                <twig:ColorDot :color="calendar.color"/>
                                <span class="data-table-link-text">{{ calendar.name }}</span>
                            </a>
                            {% if calendar.requiresConfirmation %}
                                <span class="badge text-secondary-emphasis bg-secondary-subtle ms-1 align-middle">{{ 'calendar.form.requires_confirmation'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="cell-meta">{{ (calendar.icsUrl ? 'calendar.index.source_url' : 'calendar.index.source_manual')|trans }}</td>
                        <td class="cell-meta text-md-end">
                            <span class="cell-narrow">{{ 'calendar.index.table.entries'|trans }}: </span>{{ entryCounts[calendar.id] ?? 0 }}
                        </td>
                        <td class="cell-actions data-table-actions text-end">
                            {% set id = calendar.id %}
                            {% set targetUrl = path('settings.calendars.delete', {'id': calendar.id}) %}
                            <button type="button" class="btn btn-icon text-danger"
                                    title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}"
                                    data-popover="delete"
                                    data-title="{{ 'calendar.form.delete_confirm'|trans }}"
                                    data-bs-content='{{ block('deletePopoverContent') }}'>
                                <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="data-footer">
            <span>{{ 'calendar.index.count'|trans({'%count%': calendars|length}) }}</span>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
