<div class="table-responsive">
    <table class="table table-hover align-middle data-table data-table-stack">
        <thead>
            <tr>
                <th>{{ 'mcp.settings.log.date'|trans }}</th>
                <th>{{ 'mcp.settings.tokens.user'|trans }}</th>
                <th>{{ 'mcp.settings.log.tool'|trans }}</th>
                <th>{{ 'mcp.settings.log.outcome'|trans }}</th>
                <th>{{ 'mcp.settings.log.details'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for log in logs %}
                <tr>
                    <td class="text-nowrap">{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
                    <td class="cell-meta">{{ log.username }} <span class="font-monospace text-body-secondary small">{{ log.tokenPrefix }}</span></td>
                    <td class="cell-meta font-monospace small">{{ log.toolName }}</td>
                    <td class="cell-meta">
                        {% set tone = log.outcome.value == 'ok' ? 'success' : (log.outcome.value == 'error' ? 'danger' : 'warning') %}
                        <span class="badge text-{{ tone }}-emphasis bg-{{ tone }}-subtle">
                            {{ ('mcp.settings.log.outcomes.' ~ log.outcome.value)|trans }}
                        </span>
                    </td>
                    <td class="cell-meta small">
                        {%- if log.details.reservationId is defined %}
                            {{ 'mcp.settings.log.reservation'|trans({'%id%': log.details.reservationId}) }}
                            {% if log.details.arrival is defined %}{{ log.details.arrival }} – {{ log.details.departure }}{% endif %}
                        {% elseif log.details.priceId is defined %}
                            {{ 'mcp.settings.log.price'|trans({'%id%': log.details.priceId}) }}
                            {% if log.details.firstNight is defined %}{{ log.details.firstNight }} – {{ log.details.lastNight }}{% endif %}
                        {%- endif -%}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-body-secondary">{{ 'mcp.settings.log.none'|trans }}</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% if pages > 1 %}
<div class="data-footer">
    <span></span>
    {% include 'paginator.html.twig' with {
        url: path('settings.mcp.logs'),
        page: page,
        pages: pages,
        search: '',
        swipe_nav: true,
    } %}
</div>
{% endif %}
