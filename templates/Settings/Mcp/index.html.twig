{% extends 'base.html.twig' %}
{% use "common/delete_popover.html.twig" %}
{% import 'Profile/_api_token_summary.html.twig' as tokenSummary %}

{% block title %}
    {{ parent() }} - {{ 'mcp.settings.page_title'|trans }}
{% endblock %}

{% block description %}
    {{ parent() }} - {{ 'mcp.settings.page_title'|trans }}
{% endblock %}

{% block page_title %}{{ 'mcp.nav.label'|trans }}{% endblock %}

{% block content %}
<div class="container" data-controller="settings">
    <twig:PageHeader :title="'mcp.nav.label'|trans" :back="path('settings.overview')" :backLabel="'nav.settings'|trans"/>
    <p class="text-body-secondary small mb-3">{{ 'mcp.settings.intro'|trans }}</p>

    {% if not hostAllowed %}
        <div class="alert alert-danger small">{{ 'mcp.settings.connection.host_not_allowed'|trans({'%host%': currentHost}) }}</div>
    {% endif %}
    {% if not secure and not insecureHttpAllowed %}
        <div class="alert alert-warning small">{{ 'mcp.settings.connection.https_required'|trans }}</div>
    {% elseif not secure %}
        <div class="alert alert-warning small">{{ 'mcp.settings.connection.insecure_allowed'|trans }}</div>
    {% endif %}

    {{ form_start(form) }}
    <section class="card mb-4" aria-labelledby="mcp-access">
        <twig:SectionHeader headingId="mcp-access" icon="shield-halved"
                            :title="'mcp.settings.section.access'|trans"
                            :description="'mcp.settings.section.access_desc'|trans"/>
        <div class="card-body">
            {{ form_row(form.mcpEnabled) }}
            {{ form_row(form.mcpWriteEnabled) }}
            {{ form_row(form.allowedHosts) }}
            <div class="alert alert-warning small mb-0">{{ 'mcp.settings.privacy_hint'|trans }}</div>
        </div>
        <div class="card-footer text-end">
            <button type="submit" class="btn btn-primary">{{ 'button.save'|trans }}</button>
        </div>
    </section>
    {{ form_end(form) }}

    <section class="card mb-4" aria-labelledby="mcp-users">
        <twig:SectionHeader headingId="mcp-users" icon="users" :title="'mcp.settings.section.users'|trans"/>
        <div class="card-body">
            <p class="small mb-2">{{ 'mcp.settings.users.text'|trans }}</p>
            <a href="{{ path('profile') }}#api-tokens" class="btn btn-secondary">
                <i class="fas fa-key me-1" aria-hidden="true"></i>{{ 'mcp.settings.users.link'|trans }}
            </a>
        </div>
    </section>

    {% if active %}
        <section class="card data-card mb-4" aria-labelledby="mcp-tokens">
            <twig:SectionHeader headingId="mcp-tokens" icon="key"
                                :title="'mcp.settings.section.tokens'|trans"
                                :description="'mcp.settings.tokens.desc'|trans"/>
            {% if mcpTokens is empty %}
                <twig:EmptyState icon="key" :title="'mcp.settings.tokens.none'|trans"/>
            {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle data-table data-table-stack">
                    <thead>
                        <tr>
                            <th>{{ 'profile.apitokens.name'|trans }}</th>
                            <th>{{ 'mcp.settings.tokens.user'|trans }}</th>
                            <th>{{ 'profile.apitokens.scopes.label'|trans }}</th>
                            <th>{{ 'profile.apitokens.last_used'|trans }}</th>
                            <th>{{ 'profile.apitokens.expiry.label'|trans }}</th>
                            <th class="data-table-actions"><span class="visually-hidden">{{ 'base.action'|trans }}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for apiToken in mcpTokens %}
                            <tr>
                                <td>{{ apiToken.name }} <span class="font-monospace text-body-secondary small">{{ apiToken.tokenPrefix }}&hellip;</span></td>
                                <td class="cell-meta">{{ apiToken.user.userIdentifier }}</td>
                                <td class="cell-meta">{{ tokenSummary.summary(apiToken) }}</td>
                                <td class="cell-meta text-nowrap">
                                    <span class="cell-narrow">{{ 'profile.apitokens.last_used'|trans }}: </span>
                                    {{- apiToken.lastUsedAt ? apiToken.lastUsedAt|date('d.m.Y H:i') : 'profile.apitokens.never'|trans -}}
                                </td>
                                <td class="cell-meta text-nowrap">
                                    <span class="cell-narrow">{{ 'profile.apitokens.expiry.label'|trans }}: </span>
                                    {{- apiToken.expiresAt ? apiToken.expiresAt|date('d.m.Y') : 'profile.apitokens.expiry.never'|trans -}}
                                </td>
                                <td class="cell-actions data-table-actions text-end">
                                    {% set id = apiToken.id %}
                                    {% set targetUrl = path('settings.mcp.token_revoke', {id: apiToken.id}) %}
                                    <button type="button" class="btn btn-icon text-danger"
                                            title="{{ 'mcp.settings.tokens.revoke'|trans }}" aria-label="{{ 'mcp.settings.tokens.revoke'|trans }}"
                                            data-popover="delete"
                                            data-title="{{ 'mcp.settings.tokens.revoke_ask'|trans }}"
                                            data-bs-content='{{ block('deletePopoverContent') }}'>
                                        <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </section>

        <section class="card data-card mb-4" aria-labelledby="mcp-log">
            <twig:SectionHeader headingId="mcp-log" icon="clock-rotate-left"
                                :title="'mcp.settings.section.log'|trans"
                                :description="'mcp.settings.log.desc'|trans"/>
            {# A swipe on the log pages it, as the arrows do; only there, not on the form above #}
            <div data-controller="log-pagination swipe-nav"
                 data-log-pagination-url-value="{{ path('settings.mcp.logs') }}"
                 data-swipe-nav-local-value="true"
                 data-action="click->log-pagination#paginate">
                {% include 'Settings/Mcp/_log_table.html.twig' with logPage %}
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}
