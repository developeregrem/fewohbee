{% extends 'base.html.twig' %}
{% import 'common/content_translations.html.twig' as contentTranslations %}

{% block title %}
    {{ parent() }} - {{ 'guest_checkin.settings.page_title'|trans }}
{% endblock %}

{% block description %}
    {{ parent() }} - {{ 'guest_checkin.settings.page_title'|trans }}
{% endblock %}

{% block page_title %}{{ 'guest_checkin.nav.label'|trans }}{% endblock %}

{% block content %}
{% set enabled = form.vars.value.enabled %}
<div class="container">
    <twig:PageHeader :title="'guest_checkin.nav.label'|trans" :back="path('settings.overview')" :backLabel="'nav.settings'|trans">
        <span class="badge {{ enabled ? 'bg-success-subtle text-success-emphasis' : 'bg-warning-subtle text-warning-emphasis' }}">
            {{- (enabled ? 'guest_checkin.settings.status_enabled' : 'guest_checkin.settings.status_disabled')|trans -}}
        </span>
        {# Shows the saved settings; unsaved changes on this page are not part of it. #}
        <a class="btn btn-secondary" href="{{ path('settings.guest_checkin.preview') }}" target="_blank" rel="noopener">
            <i class="fas fa-eye me-1" aria-hidden="true"></i>{{ 'guest_checkin.settings.preview'|trans }}
        </a>
    </twig:PageHeader>

    {{ form_start(form) }}

    <section class="card mb-4" aria-labelledby="checkin-general">
        <twig:SectionHeader headingId="checkin-general" icon="sliders"
                            :title="'guest_checkin.settings.section_general'|trans"
                            :description="'guest_checkin.settings.section_general_desc'|trans"/>
        <div class="card-body">
            {{ form_row(form.enabled) }}
            <div class="row mb-3">
                <div class="col-sm offset-sm-4">
                    <ol class="small text-body-secondary ps-3 mb-0">
                        <li>{{ 'guest_checkin.settings.how.link'|trans }}</li>
                        <li>{{ 'guest_checkin.settings.how.verify'|trans }}</li>
                        <li>{{ 'guest_checkin.settings.how.form'|trans }}</li>
                        <li>{{ 'guest_checkin.settings.how.review'|trans }}</li>
                    </ol>
                </div>
            </div>
            {% if not publicBaseUrl %}
                <div class="alert alert-info small mb-0">
                    {{ 'guest_checkin.settings.public_address_missing'|trans }}
                    <a href="{{ path('settings.general.index') }}">{{ 'guest_checkin.settings.public_address_change'|trans }}</a>
                </div>
            {% endif %}
        </div>
    </section>

    {# Without an invitation the feature stays unused: the automations that send it, and the template to send by hand #}
    <section class="card mb-4" aria-labelledby="checkin-invitation">
        <twig:SectionHeader headingId="checkin-invitation" icon="envelope"
                            :title="'guest_checkin.settings.section_invitation'|trans"
                            :description="'guest_checkin.settings.section_invitation_desc'|trans"/>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-sm-4 col-form-label text-sm-end">{{ 'workflow.nav.label'|trans }}</div>
                <div class="col-sm">
                    <div class="form-control-plaintext">
                        {% if invitationWorkflows is not empty %}
                            <p class="mb-1"><i class="fas fa-circle-check text-success me-1" aria-hidden="true"></i>{{ 'guest_checkin.settings.invitation_active'|trans }}</p>
                            <ul class="mb-1">
                                {% for workflow in invitationWorkflows %}
                                    <li><a href="{{ path('settings.workflows.edit', {'id': workflow.id}) }}">{{ workflow.system ? workflow.name|trans : workflow.name }}</a></li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class="mb-1">{{ 'guest_checkin.settings.invitation_none'|trans }}</p>
                        {% endif %}
                        <a class="small" href="{{ path('settings.workflows.index') }}">{{ 'guest_checkin.settings.invitation_manage'|trans }}</a>
                    </div>
                </div>
            </div>
            {{ form_row(form.invitationTemplate) }}
        </div>
    </section>

    <section class="card mb-4" aria-labelledby="checkin-fields">
        <twig:SectionHeader headingId="checkin-fields" icon="list-check"
                            :title="'guest_checkin.settings.section_fields'|trans"
                            :description="'guest_checkin.settings.section_fields_desc'|trans"/>
        <div class="card-body">
            {% for field in fieldGroups|filter(field => field != 'companionsMode') %}
                {{ form_row(attribute(form, field)) }}
            {% endfor %}
        </div>
    </section>

    {# Fellow travellers: who is asked, not which field - kept apart from the field groups #}
    <section class="card mb-4" aria-labelledby="checkin-companions">
        <twig:SectionHeader headingId="checkin-companions" icon="users"
                            :title="'guest_checkin.settings.section_companions'|trans"
                            :description="'guest_checkin.settings.section_companions_desc'|trans"/>
        <div class="card-body">
            {{ form_row(form.companionsMode) }}
        </div>
    </section>

    <section class="card mb-4" aria-labelledby="checkin-extras">
        <twig:SectionHeader headingId="checkin-extras" icon="mug-hot"
                            :title="'guest_checkin.settings.section_extras'|trans"
                            :description="'guest_checkin.settings.section_extras_desc'|trans"/>
        <div class="card-body">
            {{ form_row(form.extrasEnabled) }}
        </div>
    </section>

    <section class="card mb-4" aria-labelledby="checkin-texts">
        <twig:SectionHeader headingId="checkin-texts" icon="align-left"
                            :title="'guest_checkin.settings.section_texts'|trans"
                            :description="'guest_checkin.settings.section_texts_desc'|trans"/>
        <div class="card-body">
            {{ form_row(form.introText) }}
            {{ contentTranslations.inputs(form.translations, 'introText') }}
            {{ form_row(form.privacyUrl) }}
            {{ contentTranslations.inputs(form.translations, 'privacyUrl') }}
            {{ form_row(form.privacyText) }}
            {{ contentTranslations.inputs(form.translations, 'privacyText') }}
        </div>
    </section>

    <twig:SaveBar :label="'guest_checkin.settings.save'|trans" :hint="'guest_checkin.settings.save_hint'|trans"/>

    {{ form_end(form) }}
</div>
{% endblock %}
