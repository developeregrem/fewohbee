{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }} - {{ isNew ? 'workflow.new'|trans : 'workflow.edit'|trans }}
{% endblock %}

{% block page_title %}{{ isNew ? 'workflow.new'|trans : 'workflow.edit'|trans }}{% endblock %}

{% block content %}
{# Trigger, conditions and action fill in their fields from the server (workflow_form_controller.js),
   in the same form grid as the fields written here: label left from sm. #}
<div class="container"
     data-controller="workflow-form"
     data-workflow-form-compatible-url-value="{{ path('settings.workflows.compatible_options') }}"
     data-workflow-form-preview-url-value="{{ path('settings.workflows.preview') }}"
     {% if not isNew %}data-workflow-form-log-url-value="{{ path('settings.workflows.logs', {id: workflow.id}) }}"{% endif %}
     data-workflow-form-translations-value="{{ {
         'no_condition': 'workflow.form.no_condition'|trans,
         'condition_type': 'workflow.form.condition_type'|trans,
         'preview_loading': 'workflow.preview.loading'|trans,
         'preview_empty': 'workflow.preview.empty'|trans,
         'preview_count': 'workflow.preview.count'|trans,
         'preview_count_one': 'workflow.preview.count_one'|trans,
         'remove_condition': 'workflow.form.remove_condition'|trans,
     }|json_encode|e('html_attr') }}">
    <twig:PageHeader :title="(isNew ? 'workflow.new' : 'workflow.edit')|trans"
                     :back="path('settings.workflows.index')" :backLabel="'workflow.nav.label'|trans"/>

    <form method="post" data-action="submit->workflow-form#collectConfigJson">

        <section class="card mb-4" aria-labelledby="wf-general">
            <twig:SectionHeader headingId="wf-general" icon="tag" :title="'workflow.form.section_general'|trans"/>
            <div class="card-body">
                <div class="row mb-3">
                    <label for="wf-name" class="col-sm-4 col-form-label text-sm-end required">{{ 'workflow.form.name'|trans }}</label>
                    <div class="col-sm">
                        <input type="text" class="form-control" id="wf-name" name="name"
                               value="{{ workflow.system ? workflow.name|trans : workflow.name }}" required maxlength="150">
                    </div>
                </div>
                <div class="row mb-3">
                    <label for="wf-description" class="col-sm-4 col-form-label text-sm-end">{{ 'workflow.form.description'|trans }}</label>
                    <div class="col-sm">
                        <textarea class="form-control" id="wf-description" name="description"
                                  rows="2" maxlength="1000">{{ workflow.system ? workflow.description|trans : workflow.description }}</textarea>
                    </div>
                </div>
            </div>
        </section>

        {# When … #}
        <section class="card mb-4" aria-labelledby="wf-trigger-title">
            <twig:SectionHeader headingId="wf-trigger-title" icon="play"
                                :title="'workflow.form.section_trigger'|trans"
                                :description="'workflow.form.section_trigger_desc'|trans"/>
            <div class="card-body">
                <div class="row mb-3">
                    <label for="wf-trigger" class="col-sm-4 col-form-label text-sm-end required">{{ 'workflow.form.trigger_type'|trans }}</label>
                    <div class="col-sm">
                        <select class="form-select" id="wf-trigger" name="triggerType" required
                                data-workflow-form-target="triggerType"
                                data-action="change->workflow-form#onTriggerChange">
                            <option value="">-- {{ 'workflow.form.select_trigger'|trans }} --</option>
                            {% for trigger in triggerChoices %}
                                <option value="{{ trigger.type }}"
                                        data-entity-class="{{ trigger.entityClass }}"
                                        data-event-driven="{{ trigger.isEventDriven ? '1' : '0' }}"
                                        {{ workflow.triggerType == trigger.type ? 'selected' : '' }}>
                                    {{ trigger.label|trans }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div data-workflow-form-target="triggerConfig"></div>
                <input type="hidden" name="triggerConfig" data-workflow-form-target="triggerConfigJson"
                       value="{{ workflow.triggerConfig|json_encode }}">
            </div>
        </section>

        {# Only if … (several conditions, all have to hold) #}
        <section class="card mb-4" aria-labelledby="wf-condition-title">
            <twig:SectionHeader headingId="wf-condition-title" icon="filter"
                                :title="'workflow.form.section_condition'|trans"
                                :description="'workflow.form.section_condition_desc'|trans"/>
            <div class="card-body">
                <div data-workflow-form-target="conditionsContainer"></div>
                <div class="row mb-3">
                    <div class="col-sm offset-sm-4">
                        <button type="button" class="btn btn-sm btn-secondary"
                                data-action="click->workflow-form#addCondition">
                            <i class="fas fa-plus me-1" aria-hidden="true"></i>{{ 'workflow.form.add_condition'|trans }}
                        </button>
                    </div>
                </div>
            </div>
            <input type="hidden" name="conditions" data-workflow-form-target="conditionsJson"
                   value="{{ workflow.conditions|json_encode }}">
        </section>

        {# Then … #}
        <section class="card mb-4" aria-labelledby="wf-action-title">
            <twig:SectionHeader headingId="wf-action-title" icon="paper-plane"
                                :title="'workflow.form.section_action'|trans"
                                :description="'workflow.form.section_action_desc'|trans"/>
            <div class="card-body">
                <div class="row mb-3">
                    <label for="wf-action" class="col-sm-4 col-form-label text-sm-end required">{{ 'workflow.form.action_type'|trans }}</label>
                    <div class="col-sm">
                        <select class="form-select" id="wf-action" name="actionType" required
                                data-workflow-form-target="actionType"
                                data-action="change->workflow-form#onActionChange"
                                data-restore-value="{{ workflow.actionType }}">
                            <option value="">-- {{ 'workflow.form.select_action'|trans }} --</option>
                            {# Options populated dynamically by Stimulus based on trigger #}
                        </select>
                    </div>
                </div>
                <div data-workflow-form-target="actionConfig"></div>
                <input type="hidden" name="actionConfig" data-workflow-form-target="actionConfigJson"
                       value="{{ workflow.actionConfig|json_encode }}">
            </div>
        </section>

        {# Which records trigger and conditions hit right now, without acting on them #}
        <section class="card data-card mb-4" aria-labelledby="wf-preview-title" data-workflow-form-target="previewCard">
            <twig:SectionHeader headingId="wf-preview-title" icon="eye"
                                :title="'workflow.preview.title'|trans"
                                :description="'workflow.preview.description'|trans">
                <button type="button" class="btn btn-sm btn-secondary text-nowrap"
                        data-action="click->workflow-form#runPreview">
                    <i class="fas fa-play me-1" aria-hidden="true"></i>{{ 'workflow.preview.run'|trans }}
                </button>
            </twig:SectionHeader>
            <div data-workflow-form-target="previewResults" class="d-none">
                <div class="table-responsive">
                    <table class="table table-hover align-middle data-table mb-0">
                        <thead data-workflow-form-target="previewHead"></thead>
                        <tbody data-workflow-form-target="previewBody"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <twig:SaveBar :label="'workflow.save'|trans"/>
    </form>

    {# The log of an existing workflow pages itself; a swipe on it pages as well, only there #}
    {% if not isNew %}
        <section class="card data-card mb-4" aria-labelledby="wf-log-title">
            <twig:SectionHeader headingId="wf-log-title" icon="clock-rotate-left" :title="'workflow.logs.title'|trans"/>
            <div data-workflow-form-target="logContainer" data-controller="swipe-nav" data-swipe-nav-local-value="true">
                <p class="text-center text-body-secondary small py-3 mb-0">
                    <i class="fas fa-spinner fa-spin me-1" aria-hidden="true"></i>{{ 'workflow.logs.loading'|trans }}
                </p>
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}
