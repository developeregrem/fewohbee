{# One workflow shown on another settings page (the confirmation of the online booking), inside
   that page's form: the switch saves at once over fetch and tells so (SaveState), because a
   form of its own (ActiveToggle) may not stand inside another form. The pen leads to the edit
   page. Expects: workflow #}
<div class="border rounded p-3 d-flex align-items-start gap-2"
     data-controller="workflow-toggle"
     data-workflow-toggle-url-value="{{ path('settings.workflows.toggle', {id: workflow.id}) }}"
     data-workflow-toggle-token-value="{{ csrf_token('workflow-toggle-' ~ workflow.id) }}">
    <div class="form-check form-switch me-auto mb-0">
        <input class="form-check-input" type="checkbox" role="switch"
               id="wf-card-toggle-{{ workflow.id }}"
               {{ workflow.enabled ? 'checked' }}
               {% if workflow.description %}aria-describedby="wf-card-desc-{{ workflow.id }}"{% endif %}
               data-workflow-toggle-target="input"
               data-action="change->workflow-toggle#toggle">
        <label class="form-check-label d-inline fw-semibold" for="wf-card-toggle-{{ workflow.id }}">{{ workflow.system ? workflow.name|trans : workflow.name }}</label>
        <twig:SaveState class="ms-2 align-top" data-workflow-toggle-target="state"/>
        {% if workflow.description %}
            <div class="small text-body-secondary" id="wf-card-desc-{{ workflow.id }}">{{ workflow.system ? workflow.description|trans : workflow.description }}</div>
        {% endif %}
        {{ include('Settings/Workflow/_workflow_steps.html.twig') }}
    </div>
    <twig:IconButton icon="pen" :label="'workflow.edit'|trans" :href="path('settings.workflows.edit', {id: workflow.id})" class="flex-shrink-0"/>
</div>
