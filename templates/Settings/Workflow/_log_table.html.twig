{# Execution log of one workflow, loaded and paged by workflow_form_controller.js (links with
   data-page); the arrows of the paginator are the targets of the swipe-nav around it. #}
{% if logs|length > 0 %}
<div class="table-responsive">
    <table class="table table-hover align-middle data-table data-table-stack">
        <thead>
            <tr>
                <th>{{ 'workflow.logs.date'|trans }}</th>
                <th>{{ 'workflow.logs.status'|trans }}</th>
                <th>{{ 'workflow.logs.entity'|trans }}</th>
                <th>{{ 'workflow.logs.message'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for log in logs %}
                {% set tone = log.status == 'success' ? 'success' : (log.status == 'skipped' ? 'warning' : 'danger') %}
                <tr>
                    <td class="text-nowrap">{{ log.executedAt|date('d.m.Y H:i') }}</td>
                    <td class="cell-meta">
                        <span class="badge text-{{ tone }}-emphasis bg-{{ tone }}-subtle">{{ ('workflow.logs.status_' ~ (log.status in ['success', 'skipped'] ? log.status : 'error'))|trans }}</span>
                    </td>
                    <td class="cell-meta text-body-secondary">{% if log.entityId %}#{{ log.entityId }}{% endif %}</td>
                    <td class="cell-meta small">{{ log.message|length > 120 ? log.message[:120] ~ '…' : log.message }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% if pages is defined and pages > 1 %}
<div class="data-footer">
    <span></span>
    {% include 'paginator.html.twig' with {
        url: path('settings.workflows.logs', {'id': workflow.id}),
        page: page,
        pages: pages,
        search: '',
        swipe_nav: true,
    } %}
</div>
{% endif %}
{% else %}
<p class="text-center text-body-secondary small py-3 mb-0">{{ 'workflow.logs.empty'|trans }}</p>
{% endif %}
