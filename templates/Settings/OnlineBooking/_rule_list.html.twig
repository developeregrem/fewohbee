{# One booking-rule list, used twice on the settings page: once for the unlimited rules and
   once for the special periods. Both edit the same entity through the same offcanvas; only
   the "add" route and the period column differ.

   Expects: listRules, ruleDescriptions, anchorId, icon, listTitle, listDesc, addPath,
   addLabel, emptyLabel, showPeriod. #}
{% use "common/delete_popover.html.twig" %}
<div class="card mb-3" id="{{ anchorId }}">
    <div class="card-header d-flex align-items-center justify-content-between gap-2">
        <div>
            <h5 class="card-title fs-6 mb-0"><i class="fas {{ icon }} text-primary me-2"></i>{{ listTitle|trans }}</h5>
            <p class="text-body-secondary small mb-0 mt-1">{{ listDesc|trans }}</p>
        </div>
        <button class="btn btn-sm btn-outline-primary text-nowrap" type="button"
                data-action="click->booking-rules#openOffcanvas"
                data-url="{{ path(addPath) }}"
                data-offcanvas-title="{{ addLabel|trans }}">
            <i class="fas fa-plus me-1"></i>{{ addLabel|trans }}
        </button>
    </div>
    <div class="card-body p-0">
        <ul class="list-group list-group-flush" data-booking-rules-target="ruleList" {{ listRules|length > 0 ? '' : 'hidden' }}>
                {% for rule in listRules %}
                    <li class="list-group-item d-flex flex-wrap align-items-start justify-content-between gap-2 {{ rule.enabled ? '' : 'opacity-50' }}"
                        data-booking-rules-target="ruleRow">
                        <div class="me-auto">
                            <p class="mb-1 small fw-semibold">
                                {{ ruleDescriptions[rule.id] }}
                                <span class="badge text-bg-secondary ms-1" data-booking-rules-target="disabledBadge" {{ rule.enabled ? 'hidden' : '' }}>{{ 'booking_rules.disabled'|trans }}</span>
                            </p>
                            <p class="mb-0 text-body-secondary" style="font-size:.8rem">
                                {% if rule.allCategories %}
                                    {{ 'booking_rules.all_categories'|trans }}
                                {% elseif rule.categories|length > 0 %}
                                    {{ rule.categories|map(c => c.name)|join(', ') }}
                                {% else %}
                                    {{ 'booking_rules.no_categories'|trans }}
                                {% endif %}
                            </p>
                        </div>
                        <div class="text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                    title="{{ 'booking_rules.edit'|trans }}"
                                    data-action="click->booking-rules#openOffcanvas"
                                    data-url="{{ path('settings.online_booking.rule_edit', {'id': rule.id}) }}"
                                    data-offcanvas-title="{{ 'booking_rules.edit'|trans }}">
                                <i class="fas fa-pen-to-square"></i>
                            </button>
                            {# Submitted over ajax so the page keeps its scroll position. #}
                            <form method="post" action="{{ path('settings.online_booking.rule_toggle', {'id': rule.id}) }}" class="d-inline"
                                  data-action="submit->booking-rules#toggleRule">
                                <input type="hidden" name="_token" value="{{ csrf_token('booking-rule-toggle-' ~ rule.id) }}">
                                <button class="btn btn-sm btn-outline-secondary me-1" type="submit"
                                        data-booking-rules-target="toggleButton"
                                        data-enable-label="{{ 'booking_rules.enable'|trans }}"
                                        data-disable-label="{{ 'booking_rules.disable'|trans }}"
                                        title="{{ (rule.enabled ? 'booking_rules.disable' : 'booking_rules.enable')|trans }}">
                                    <i class="fas {{ rule.enabled ? 'fa-toggle-on' : 'fa-toggle-off' }}"></i>
                                </button>
                            </form>
                            {% set id = rule.id %}
                            {% set targetUrl = path('settings.online_booking.rule_delete', {'id': rule.id}) %}
                            {% set deletePopoverHint = 'booking_rules.delete_confirm'|trans %}
                            <button type="button"
                                    class="btn btn-sm btn-link text-danger p-0 border-0 align-baseline"
                                    title="{{ 'button.delete'|trans }}"
                                    data-popover="delete"
                                    data-title="{{ 'registrationbook.delete.ask'|trans }}"
                                    data-bs-content='{{ block('deletePopoverContent') }}'>
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </li>
                {% endfor %}
        </ul>
        <div class="p-3 text-body-secondary small text-center" data-booking-rules-target="ruleListEmpty" {{ listRules|length > 0 ? 'hidden' : '' }}>{{ emptyLabel|trans }}</div>
    </div>
</div>
