{# One booking-rule list, used twice on the settings page: once for the unlimited rules and
   once for the special periods. Both edit the same entity through the same offcanvas; only
   the "add" route and the period column differ. The page saves its settings with a save bar,
   so the lists keep their add button in their own head instead of a round add button.

   Expects: listRules, ruleDescriptions, anchorId, icon, listTitle, listDesc, addPath,
   addLabel, emptyIcon, emptyLabel, countLabel. #}
{% use "common/delete_popover.html.twig" %}
<section class="card data-card mb-4" id="{{ anchorId }}" aria-labelledby="{{ anchorId }}-title">
    <twig:SectionHeader :headingId="anchorId ~ '-title'" :icon="icon" :title="listTitle|trans" :description="listDesc|trans">
        <button class="btn btn-sm btn-secondary text-nowrap" type="button"
                data-action="click->booking-rules#openOffcanvas"
                data-url="{{ path(addPath) }}"
                data-offcanvas-title="{{ addLabel|trans }}">
            <i class="fas fa-plus me-1" aria-hidden="true"></i>{{ addLabel|trans }}
        </button>
    </twig:SectionHeader>
    <ul class="list-group list-group-flush" data-booking-rules-target="ruleList"
        data-action="active-toggle:toggled->booking-rules#ruleToggled" {{ listRules|length > 0 ? '' : 'hidden' }}>
        {% for rule in listRules %}
            {# The id is the scroll target after saving a rule in the offcanvas. Clicking a rule
               marks the calendar days whose value it sets; the marking stays while scrolling. #}
            <li id="booking-rule-{{ rule.id }}"
                class="list-group-item booking-rule-item d-flex align-items-start gap-2{{ rule.enabled ? '' : ' opacity-50' }}"
                data-booking-rules-target="ruleRow"
                data-rule-id="{{ rule.id }}"
                data-action="click->booking-rules#toggleHighlight">
                <div class="me-auto">
                    <p class="mb-1 fw-semibold">
                        <button type="button" class="booking-rule-item__mark" data-rule-highlight aria-pressed="false"
                                title="{{ 'booking_rules.show_in_calendar'|trans }}">{{ ruleDescriptions[rule.id] }}</button>
                        <span class="badge text-secondary-emphasis bg-secondary-subtle ms-1" data-inactive-badge {{ rule.enabled ? 'hidden' }}>{{ 'booking_rules.disabled'|trans }}</span>
                    </p>
                    <p class="mb-0 small text-body-secondary">
                        {% if rule.allCategories %}
                            {{ 'booking_rules.all_categories'|trans }}
                        {% elseif rule.categories|length > 0 %}
                            {{ rule.categories|map(c => c.name)|join(', ') }}
                        {% else %}
                            {{ 'booking_rules.no_categories'|trans }}
                        {% endif %}
                    </p>
                </div>
                <div class="text-nowrap flex-shrink-0">
                    {# Switched over fetch so the page keeps its scroll position; the calendar
                       follows through active-toggle:toggled #}
                    <twig:ActiveToggle :action="path('settings.online_booking.rule_toggle', {'id': rule.id})"
                                       :token="csrf_token('booking-rule-toggle-' ~ rule.id)" :active="rule.enabled"
                                       :enableLabel="'booking_rules.enable'|trans" :disableLabel="'booking_rules.disable'|trans"
                                       fetch inactiveClass="opacity-50"/>
                    <twig:IconButton icon="pen" :label="'booking_rules.edit'|trans"
                                     data-action="click->booking-rules#openOffcanvas"
                                     :data-url="path('settings.online_booking.rule_edit', {'id': rule.id})"
                                     :data-offcanvas-title="'booking_rules.edit'|trans"/>
                    {% set id = rule.id %}
                    {% set targetUrl = path('settings.online_booking.rule_delete', {'id': rule.id}) %}
                    {% set deletePopoverHint = 'booking_rules.delete_confirm'|trans %}
                    <button type="button" class="btn btn-icon text-danger"
                            title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}"
                            data-popover="delete"
                            data-title="{{ 'registrationbook.delete.ask'|trans }}"
                            data-bs-content='{{ block('deletePopoverContent') }}'>
                        <i class="fas fa-trash-alt" aria-hidden="true"></i>
                    </button>
                </div>
            </li>
        {% endfor %}
    </ul>
    <div data-booking-rules-target="ruleListEmpty" {{ listRules|length > 0 ? 'hidden' : '' }}>
        <twig:EmptyState :icon="emptyIcon" :title="emptyLabel|trans"/>
    </div>
    {# The texts for every count down to none: deleting a rule updates the count without a reload #}
    <div class="data-footer" data-booking-rules-target="ruleCount"
         data-texts="{{ range(0, listRules|length)|map(n => countLabel|trans({'%count%': n}))|json_encode|e('html_attr') }}"
         {{ listRules|length > 0 ? '' : 'hidden' }}>
        <span>{{ countLabel|trans({'%count%': listRules|length}) }}</span>
    </div>
</section>
