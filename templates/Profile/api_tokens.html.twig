{% use "common/delete_popover.html.twig" %}
{% trans_default_domain 'messages' %}
{% import 'Profile/_api_token_summary.html.twig' as tokenSummary %}
<div class="row mb-4" id="api-tokens">
    <div class="col-lg">
        <div class="card shadow-sm">
            <div class="card-body">
                <h4 class="card-tittle">{{ 'profile.apitokens.title'|trans }}</h4>
                <p class="card-subtitle text-muted">{{ 'profile.apitokens.subtitle'|trans }}</p>

                {% if newApiToken %}
                    <div class="alert alert-success mt-3" data-controller="copy">
                        <p class="mb-2"><strong>{{ 'profile.apitokens.created_once_hint'|trans }}</strong></p>
                        <div class="input-group">
                            <input type="text" class="form-control font-monospace" readonly value="{{ newApiToken }}" data-copy-target="input">
                            <button type="button" class="btn btn-outline-secondary shadow-none" data-action="copy#copy" data-copy-hint-value="{{ 'profile.apitokens.copied'|trans }}">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                        {% if newApiTokenIsMcp|default(false) %}
                            <p class="mb-0 mt-2 small text-muted">{{ 'profile.apitokens.mcp.usage_hint'|trans }}</p>
                        {% else %}
                            <p class="mb-0 mt-2 small text-muted">{{ 'profile.apitokens.usage_hint'|trans }}</p>
                        {% endif %}
                    </div>
                {% endif %}

                <table class="table table-bordered table-hover mt-3">
                    <thead>
                        <tr>
                            <th>{{ 'profile.apitokens.name'|trans }}</th>
                            <th>{{ 'profile.apitokens.token'|trans }}</th>
                            <th>{{ 'profile.apitokens.scopes.label'|trans }}</th>
                            <th>{{ 'profile.apitokens.created_at'|trans }}</th>
                            <th>{{ 'profile.apitokens.last_used'|trans }}</th>
                            <th>{{ 'profile.apitokens.expiry.label'|trans }}</th>
                            <th>{{ 'profile.apitokens.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for apiToken in apiTokens %}
                            <tr>
                                <td>{{ apiToken.name }}</td>
                                <td class="font-monospace">{{ apiToken.tokenPrefix }}&hellip;</td>
                                <td>
                                    {% if 'mcp:access' in apiToken.scopes %}
                                        <span class="badge text-bg-primary"><i class="fas fa-robot"></i> {{ 'profile.apitokens.kind.mcp_badge'|trans }}</span>
                                    {% endif %}
                                    <div class="small">{{ tokenSummary.summary(apiToken) }}</div>
                                </td>
                                <td>{{ apiToken.createdAt|date('Y-m-d H:i') }}</td>
                                <td>
                                    {% if apiToken.lastUsedAt %}
                                        {{ apiToken.lastUsedAt|date('Y-m-d H:i') }}
                                    {% else %}
                                        <span class="text-muted">{{ 'profile.apitokens.never'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if apiToken.expiresAt %}
                                        {{ apiToken.expiresAt|date('Y-m-d') }}
                                    {% else %}
                                        <span class="text-muted">{{ 'profile.apitokens.expiry.never'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% set id = apiToken.id %}
                                    {% set formId = 'apitoken-' ~ apiToken.id %}
                                    {% set targetUrl = path('profile.apitokens.delete', {id: apiToken.id}) %}
                                    <a href="#" title="{{ 'button.delete'|trans }}">
                                        <i class="fas fa-trash-alt"
                                            data-popover="delete"
                                            data-title="{{ 'registrationbook.delete.ask'|trans }}"
                                            data-bs-content='{{ block('deletePopoverContent') }}'></i>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="px-6 py-4 text-center text-gray-400">{{ 'profile.apitokens.none'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <div class="mt-3">
                    <button type="button" class="btn btn-secondary" data-bs-toggle="offcanvas" data-bs-target="#apiTokenOffcanvas">
                        <i class="fas fa-plus"></i> {{ 'profile.apitokens.create'|trans }}
                    </button>
                </div>
                <p class="form-text mb-0 mt-3">
                    <a href="{{ path('profile.apitokens.openapi') }}">{{ 'profile.apitokens.openapi'|trans }}</a>
                    {{ 'profile.apitokens.openapi_hint'|trans }}
                </p>
                {% if mcpEndpointUrl|default(null) %}
                    <div class="form-text mt-2" id="mcp-connection">
                        <div class="mb-1"><i class="fas fa-robot"></i> {{ 'profile.apitokens.mcp.connect_hint'|trans }}</div>
                        <div class="input-group input-group-sm mb-1" style="max-width: 36rem" data-controller="copy" data-copy-hint-value="{{ 'copy.sucess'|trans }}">
                            <span class="input-group-text">{{ 'profile.apitokens.mcp.endpoint'|trans }}:&nbsp;</span>
                            <input type="text" id="mcp-endpoint" readonly class="form-control font-monospace" value="{{ mcpEndpointUrl }}" data-copy-target="input">
                            <button class="btn btn-outline-secondary shadow-none" type="button" data-action="click->copy#copy" title="{{ 'copy.text'|trans }}">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                        <div>
                            {{ 'profile.apitokens.mcp.example'|trans }}
                            <code>claude mcp add --transport http fewohbee {{ mcpEndpointUrl }} --header "Authorization: Bearer fwb_…"</code>
                        </div>
                        <div>
                            {{ 'profile.apitokens.mcp.more'|trans }}
                            <a href="https://github.com/developeregrem/fewohbee/wiki/MCP-AI-Assistants" target="_blank" rel="noopener noreferrer">{{ 'profile.apitokens.mcp.more_link'|trans }}</a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="apiTokenOffcanvas" aria-labelledby="apiTokenOffcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="apiTokenOffcanvasLabel">{{ 'profile.apitokens.create'|trans }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        {% set summaryTexts = {
            and: 'profile.apitokens.summary.and'|trans,
            seeRest: 'profile.apitokens.summary.see.rest'|trans,
            seeMcp: 'profile.apitokens.summary.see.mcp'|trans,
            seeMcpNone: 'profile.apitokens.summary.see.mcp_none'|trans,
            personalNone: 'profile.apitokens.summary.personal.none'|trans,
            personalGuests: 'profile.apitokens.summary.personal.guests'|trans,
            personalBank: 'profile.apitokens.summary.personal.bank'|trans,
            personalBoth: 'profile.apitokens.summary.personal.both'|trans,
            changeSome: 'profile.apitokens.summary.change.some'|trans,
            changeNone: 'profile.apitokens.summary.change.none'|trans,
        } %}
        {{ form_start(apiTokenForm, {attr: {'data-turbo': 'false', 'data-controller': 'api-token-form', 'data-api-token-form-texts-value': summaryTexts|json_encode}}) }}
        {{ form_errors(apiTokenForm) }}
        {{ form_row(apiTokenForm.name) }}
        {% if apiTokenForm.kind is defined %}
            {{ form_row(apiTokenForm.kind) }}
        {% endif %}
        {{ form_row(apiTokenForm.expiresIn) }}

        {% if apiTokenForm.kind is defined %}
            <div class="alert alert-warning small" data-api-token-form-target="mcpOnly">{{ 'profile.apitokens.mcp.privacy_hint'|trans }}</div>
        {% endif %}
        {{ form_errors(apiTokenForm.scopes) }}
        {# The scopes field is rendered by hand: grouped by the question each scope answers. #}
        {% do apiTokenForm.scopes.setRendered %}
        {% for group, entries in apiTokenForm.vars.scope_groups %}
            <fieldset class="mb-3" data-api-token-form-target="group">
                <legend class="fs-6 fw-semibold mb-1">
                    <span data-api-token-form-target="restOnly">{{ ('profile.apitokens.groups.' ~ group ~ '.rest')|trans }}</span>
                    {% if apiTokenForm.kind is defined %}
                        <span data-api-token-form-target="mcpOnly">{{ ('profile.apitokens.groups.' ~ group ~ '.mcp')|trans }}</span>
                    {% endif %}
                </legend>
                {% for entry in entries %}
                    {% set scope = entry.scope %}
                    {% set tools = mcpToolsByScope[scope.value]|default([]) %}
                    <div data-api-token-form-target="scopeItem"
                         data-kinds="{{ scope.forRest ? 'api' }} {{ scope.forMcp ? 'mcp' }}"
                         data-group="{{ group }}"
                         data-summary="{{ scope.summaryKey|trans }}"
                         {% if scope.value == 'bank-import:write' %}data-shares-bank-data="1"{% endif %}>
                        <div class="d-flex align-items-center gap-2">
                            {% if entry.field %}
                                {{ form_widget(entry.field) }}
                            {% else %}
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" disabled data-unavailable="1" id="scope-unavailable-{{ loop.parent.loop.index }}-{{ loop.index }}">
                                    <label class="form-check-label text-body-secondary" for="scope-unavailable-{{ loop.parent.loop.index }}-{{ loop.index }}">{{ scope.labelKey|trans }}</label>
                                </div>
                            {% endif %}
                            {% if tools is not empty and apiTokenForm.kind is defined %}
                                {% set toolsHint = 'profile.apitokens.tools'|trans({'%tools%': tools|join(', ')}) %}
                                {# The tooltip sits on a wrapper: Font Awesome replaces the <i> by an SVG and drops its title. #}
                                <span class="small text-body-secondary" tabindex="0" data-api-token-form-target="mcpOnly"
                                      data-bs-toggle="tooltip" title="{{ toolsHint }}" aria-label="{{ toolsHint }}">
                                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                                </span>
                            {% endif %}
                        </div>
                        {% if entry.reason or scope.hintKey %}
                            <div class="form-text ms-4 mt-0 mb-1">
                                {% if entry.reason == 'role' %}
                                    {{ 'profile.apitokens.unavailable.role'|trans({'%role%': scope.requiredRole|trans}) }}
                                {% elseif entry.reason == 'switch' %}
                                    {{ 'profile.apitokens.mcp.write_disabled'|trans }}
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('settings.mcp.index') }}">{{ 'profile.apitokens.mcp.write_disabled_link'|trans }}</a>
                                    {% endif %}
                                {% else %}
                                    {{ scope.hintKey|trans }}
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </fieldset>
        {% endfor %}
        <p class="small text-body-secondary mb-0" data-api-token-form-target="summary"></p>
        <div class="mt-3 text-end">
            <button type="submit" class="btn btn-primary">{{ 'profile.apitokens.submit'|trans }}</button>
        </div>
        {{ form_end(apiTokenForm) }}
    </div>
</div>
