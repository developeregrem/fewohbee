{% extends 'base.html.twig' %}
{% use "common/delete_popover.html.twig" %}

{% block title %}
    {{ parent() }} -  {{ 'status.title'|trans }}
{% endblock %}

{% block description %}
    {{ parent() }} -  {{ 'status.description'|trans }}
{% endblock %}

{% block page_title %}{{ 'nav.status'|trans }}{% endblock %}

{% block content %}
<div class="container fab-add-clearance" data-controller="settings">
    <twig:PageHeader :title="'nav.status'|trans" :back="path('settings.overview')" :backLabel="'nav.settings'|trans">
        <twig:AddButton :label="'status.add'|trans"
                        data-action="click->settings#openModalAction"
                        data-url="{{ path('reservation_status_new') }}"
                        data-title="{{ 'status.add'|trans }}"
                        data-bs-toggle="modal" data-bs-target="#modalCenter"/>
    </twig:PageHeader>

    {# Card markup written out: the delete popover's block is not reachable inside a component #}
    <div class="card data-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle data-table" data-controller="row-link" data-action="click->row-link#open">
                <thead>
                <tr>
                    <th>{{ 'status.name'|trans }}</th>
                    <th class="data-table-actions"><span class="visually-hidden">{{ 'status.action'|trans }}</span></th>
                </tr>
                </thead>
                <tbody>
                {% for status in reservation_status %}
                    <tr>
                        <td>
                            <a href="#" class="data-table-link" data-row-link-target="link"
                               data-action="click->settings#openModalAction"
                               data-url="{{ path('reservation_status_edit', {'id': status.id}) }}"
                               data-title="{{ 'status.edit'|trans }}"
                               data-bs-toggle="modal" data-bs-target="#modalCenter">
                                <twig:StatusBadge :status="status"/>
                            </a>
                        </td>
                        <td class="cell-actions data-table-actions text-end">
                            {% if status.system %}
                                <span class="icon-slot text-body-tertiary" title="{{ 'status.system.locked'|trans }}">
                                    <i class="fas fa-lock" aria-hidden="true"></i>
                                    <span class="visually-hidden">{{ 'status.system.locked'|trans }}</span>
                                </span>
                            {% else %}
                                {% set id = status.id %}
                                {% set targetUrl = path('reservation_status_delete', {'id': status.id}) %}
                                <button type="button" class="btn btn-icon text-danger"
                                        title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}"
                                        data-popover="delete"
                                        data-title="{{ 'status.delete.ask'|trans }}"
                                        data-bs-content='{{ block('deletePopoverContent') }}'>
                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
