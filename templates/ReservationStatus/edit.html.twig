{{ form_start(form, {'attr': {
    'id':'entry-form-'~status.id,
    'data-controller':'settings',
    'data-action':'submit->settings#submitFormAction',
    'data-url': path('reservation_status_edit', {'id': status.id})
} }) }}
    <div class="modal-body px-lg-5">
        <div id="flash-message-overlay">
        </div>
        {# Opens ready to edit; a system status stays locked (the server refuses changes) #}
        <div class="row">
            <div class="col">                             
                {{ include('ReservationStatus/_form.html.twig') }}
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'button.cancel'|trans }}</button>
        {% if not status.system %}
            <input type="submit" value="{{ 'button.save'|trans }}" id="entry-submit-{{ status.id }}"
                   class="btn btn-primary"/>
        {% endif %}
    </div>
{{ form_end(form) }}
