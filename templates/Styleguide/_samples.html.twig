{# One set of samples; included once per colour scheme, so ids carry the scheme. Where a sample is
   a Twig component (templates/components/), its name stands next to the heading. #}
<h3 class="styleguide-heading">Colours</h3>
<div class="styleguide-swatches">
    {% for token in ['canvas', 'surface', 'surface-2', 'surface-3', 'border', 'border-strong', 'text', 'text-muted', 'text-subtle'] %}
        <div class="styleguide-swatch"><span style="background: var(--feb-{{ token }})"></span>{{ token }}</div>
    {% endfor %}
</div>
<div class="styleguide-swatches">
    {% for token in ['primary', 'accent', 'neutral', 'success', 'info', 'partial', 'warning', 'danger'] %}
        <div class="styleguide-swatch"><span style="background: var(--feb-{{ token }})"></span>{{ token }}</div>
    {% endfor %}
</div>

<h3 class="styleguide-heading">Type</h3>
<div class="card card-body">
    <h1 class="page-title mb-2">Page title</h1>
    <h2 class="h5">Section heading</h2>
    <p class="mb-1">Body text with a <a href="#">plain link</a> and <strong>emphasis</strong>.</p>
    <p class="text-body-secondary mb-1">Secondary text for explanations and hints.</p>
    <p class="mb-0">
        <span class="text-primary">primary</span> · <span class="text-success">success</span> ·
        <span class="text-info">info</span> · <span class="text-warning">warning</span> ·
        <span class="text-danger">danger</span> · <span class="text-secondary">secondary</span>
    </p>
</div>

<h3 class="styleguide-heading">Page header <code class="styleguide-ref">PageHeader · AddButton</code></h3>
<div class="card card-body styleguide-page-header">
    <twig:PageHeader title="Guests" subtitle="Below lg the top bar shows the title instead.">
        <twig:AddButton label="Add guest"/>
    </twig:PageHeader>
    <p class="text-body-secondary small mb-0">With a mouse the add button sits in the header; on touch screens it is the round
        button at the bottom right. Both are shown here.</p>
</div>

<h3 class="styleguide-heading">Buttons <code class="styleguide-ref">IconButton</code></h3>
<div class="card card-body gap-3">
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Primary</button>
        <button type="button" class="btn btn-secondary">Secondary</button>
        <button type="button" class="btn btn-outline-secondary">Outline</button>
        <button type="button" class="btn btn-success">Success</button>
        <button type="button" class="btn btn-warning">Warning</button>
        <button type="button" class="btn btn-danger">Danger</button>
        <button type="button" class="btn btn-link">Link</button>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <button type="button" class="btn btn-outline-primary">Outline primary</button>
        <button type="button" class="btn btn-outline-danger">Outline danger</button>
        <button type="button" class="btn btn-primary" disabled>Disabled</button>
        <button type="button" class="btn btn-secondary btn-sm">Small</button>
        <twig:IconButton icon="pen" label="Edit"/>
        <twig:IconButton icon="trash-can" label="Delete"/>
        <div class="btn-group">
            <button type="button" class="btn btn-secondary">Day</button>
            <button type="button" class="btn btn-secondary active">Week</button>
            <button type="button" class="btn btn-secondary">Month</button>
        </div>
    </div>
</div>

<h3 class="styleguide-heading">Form <code class="styleguide-ref">form theme layout</code></h3>
<div class="card card-body">
    {# The grid the form theme renders, and that forms written by hand use as well #}
    <div class="mb-3 row">
        <label class="col-form-label col-sm-4 text-sm-end required" for="sg-name-{{ scheme }}">Name</label>
        <div class="col-sm"><input type="text" class="form-control" id="sg-name-{{ scheme }}" value="Anna Beispiel" required></div>
    </div>
    <div class="mb-3 row">
        <label class="col-form-label col-sm-4 text-sm-end" for="sg-room-{{ scheme }}">Room</label>
        <div class="col-sm">
            <select class="form-select" id="sg-room-{{ scheme }}"><option>Double room 1</option><option>Single room 2</option></select>
        </div>
    </div>
    <div class="mb-3 row">
        <label class="col-form-label col-sm-4 text-sm-end" for="sg-price-{{ scheme }}">Price</label>
        <div class="col-sm">
            <div class="input-group">
                <input type="text" class="form-control" id="sg-price-{{ scheme }}" placeholder="0,00">
                <span class="input-group-text">€</span>
            </div>
            <div class="form-text">Per night, including VAT.</div>
        </div>
    </div>
    <div class="mb-3 row">
        <label class="col-form-label col-sm-4 text-sm-end" for="sg-mail-{{ scheme }}">E-mail</label>
        <div class="col-sm">
            <input type="email" class="form-control is-invalid" id="sg-mail-{{ scheme }}" value="anna@">
            <div class="invalid-feedback">Please enter a complete address.</div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm offset-sm-4 d-flex flex-wrap gap-4">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="sg-check-{{ scheme }}" checked>
                <label class="form-check-label" for="sg-check-{{ scheme }}">Breakfast</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" id="sg-radio-{{ scheme }}" checked>
                <label class="form-check-label" for="sg-radio-{{ scheme }}">Option</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="sg-switch-{{ scheme }}" checked>
                <label class="form-check-label" for="sg-switch-{{ scheme }}">Active</label>
            </div>
        </div>
    </div>
</div>

<h3 class="styleguide-heading">Suggestions while typing <code class="styleguide-ref">Autocomplete</code></h3>
<div class="card card-body">
    <div class="row">
        <label class="col-form-label col-sm-4 text-sm-end" for="sg-autocomplete-{{ scheme }}">Address</label>
        <div class="col-sm">
            <twig:Autocomplete id="sg-autocomplete-{{ scheme }}" placeholder="Type a name, e.g. Muster"
                               :url="path('customers.search.address', {address: '__query__'})"
                               :maxResults="5" label="{customer}" detail="{company}, {address}, {zip} {city}"/>
            <div class="form-text">Loads guests' addresses; picking one dispatches autocomplete:select.</div>
        </div>
    </div>
</div>

<h3 class="styleguide-heading">Record list <code class="styleguide-ref">DataCard · SearchField · Avatar · StatusBadge</code></h3>
<twig:DataCard>
    <twig:block name="toolbar">
        <twig:SearchField placeholder="Search" input:id="sg-search-{{ scheme }}"/>
        <button type="button" class="btn btn-secondary ms-auto"><i class="fas fa-filter me-1"></i> Filter</button>
    </twig:block>
    <div class="table-responsive">
        <table class="table table-hover align-middle data-table data-table-stack">
            <thead>
            <tr><th class="data-table-id">ID</th><th>Name</th><th>Company</th><th>Status</th><th class="text-end">Bookings</th><th class="data-table-actions"></th></tr>
            </thead>
            <tbody>
            {% for row in [
                { initials: 'AB', name: 'Beispiel, Anna', company: 'Muster GmbH', status: statuses[0], bookings: 4 },
                { initials: 'JD', name: 'Doe, John', company: '', status: statuses[1], bookings: 1 },
                { initials: 'MM', name: 'Mustermann, Max', company: 'Reisebüro Sonne', status: statuses[3], bookings: 12 },
            ] %}
                <tr>
                    <td class="cell-meta data-table-id">{{ loop.index + 40 }}</td>
                    <td><a href="#" class="data-table-link"><twig:Avatar :initials="row.initials"/><span class="data-table-link-text">{{ row.name }}</span></a></td>
                    <td class="cell-meta">{{- row.company -}}</td>
                    <td class="cell-meta"><twig:StatusBadge :status="row.status"/></td>
                    <td class="cell-meta text-end">{{ row.bookings }}</td>
                    <td class="cell-actions data-table-actions text-end"><twig:IconButton icon="pen" label="Edit"/></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <twig:block name="footer">
        <span>112 records</span>
        {# Below md only the arrows and "2 / 6" #}
        {% include 'paginator.html.twig' with {url: '#', page: 2, pages: 6, search: ''} only %}
    </twig:block>
</twig:DataCard>

<h3 class="styleguide-heading">Empty state <code class="styleguide-ref">EmptyState</code></h3>
<div class="card">
    <twig:EmptyState icon="users" title="Nothing here yet">A short hint on what to do next.</twig:EmptyState>
</div>

<h3 class="styleguide-heading">Colours chosen by the operator <code class="styleguide-ref">StatusBadge · ColorDot</code></h3>
<div class="card card-body gap-3">
    <div class="d-flex flex-wrap gap-2">
        {% for status in statuses %}<twig:StatusBadge :status="status"/>{% endfor %}
    </div>
    <div class="d-flex flex-wrap gap-2">
        {% for status in statuses %}<twig:StatusBadge :status="status" pill/>{% endfor %}
    </div>
    <div class="d-flex flex-wrap align-items-center gap-3">
        {% for status in statuses %}
            <span class="d-inline-flex align-items-center gap-2"><twig:ColorDot :color="status.color"/>{{ status.name }}</span>
        {% endfor %}
        <twig:ColorDot :color="statuses[3].color" size="lg"/>
    </div>
</div>

<h3 class="styleguide-heading">Paging a period <code class="styleguide-ref">DatePager · Pager</code></h3>
<div class="card card-body" data-controller="swipe-nav">
    <div class="d-flex flex-wrap align-items-center gap-3">
        <twig:DatePager name="styleguide-date" :value="'now'|date('Y-m-d')"/>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
        <twig:Pager links previousHref="#" nextHref="#" previousLabel="April 2026" nextLabel="June 2026">
            <span class="input-group-text">May 2026<span class="fw-normal text-body-secondary ms-1">· 1/2</span></span>
        </twig:Pager>
        <twig:Pager links nextHref="#" nextLabel="February 2026">
            <span class="input-group-text">January 2026</span>
        </twig:Pager>
    </div>
</div>

<h3 class="styleguide-heading">Invoice status <code class="styleguide-ref">InvoiceStatus</code></h3>
<div class="card card-body">
    <div class="d-flex flex-wrap gap-2">
        {% for status in [1, 3, 2, 4] %}<twig:InvoiceStatus :status="status"/>{% endfor %}
    </div>
</div>

<h3 class="styleguide-heading">Invoice status to change <code class="styleguide-ref">InvoiceStatusPicker</code></h3>
<div class="card card-body">
    <div class="d-flex flex-wrap align-items-center gap-3">
        {# Sample invoices only: there is no invoice 0, so a pick here ends in the warning #}
        {% set cash = constant('App\\Entity\\Enum\\PaymentMeansCode::CASH') %}
        {% for status in [1, 3, 2, 4] %}<twig:InvoiceStatusPicker :invoice="{id: 0, status: status, paymentMeans: cash}"/>{% endfor %}
        <twig:InvoiceStatusPicker :invoice="{id: 0, status: 2, paymentMeans: cash}" label/>
    </div>
</div>

<h3 class="styleguide-heading">Field that saves itself <code class="styleguide-ref">SaveState</code></h3>
<div class="card card-body">
    <div class="d-flex flex-wrap align-items-center gap-4">
        <twig:SaveState state="saving"/>
        <twig:SaveState state="saved" class="save-state-hold"/>
        <twig:SaveState state="failed"/>
    </div>
</div>

<h3 class="styleguide-heading">Badges and messages</h3>
<div class="card card-body gap-3">
    <div class="d-flex flex-wrap gap-2">
        {% for variant in ['primary', 'secondary', 'success', 'info', 'warning', 'danger', 'light', 'dark'] %}
            <span class="badge text-bg-{{ variant }}">{{ variant }}</span>
        {% endfor %}
    </div>
    <div class="d-flex flex-wrap gap-2">
        {% for variant in ['primary', 'secondary', 'success', 'info', 'warning', 'danger'] %}
            <span class="badge bg-{{ variant }}-subtle text-{{ variant }}-emphasis border border-{{ variant }}-subtle">{{ variant }} subtle</span>
        {% endfor %}
    </div>
    <div class="alert alert-info mb-0"><i class="fas fa-circle-info me-2"></i>Check-in is possible from 3 pm.</div>
    <div class="alert alert-warning mb-0"><i class="fas fa-triangle-exclamation me-2"></i>Two reservations overlap.</div>
    <div class="alert alert-danger mb-0"><i class="fas fa-circle-exclamation me-2"></i>The invoice could not be sent.</div>
    <div class="alert alert-success mb-0"><i class="fas fa-circle-check me-2"></i>Saved.</div>
</div>

<h3 class="styleguide-heading">Tabs, menu, dialog</h3>
<div class="card">
    <div class="card-header">Card header</div>
    <div class="card-body">
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item"><a class="nav-link active" href="#">Details</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Invoices</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Correspondence</a></li>
        </ul>
        <div class="d-flex flex-wrap gap-2">
            <div class="dropdown">
                <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Menu</button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item active" href="#">Current entry</a></li>
                    <li><a class="dropdown-item" href="#">Another entry</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="#">Separated entry</a></li>
                </ul>
            </div>
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#sg-modal-{{ scheme }}">Open dialog</button>
        </div>
        <div class="progress mt-3" role="progressbar" aria-label="Sample" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: 60%"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="sg-modal-{{ scheme }}" tabindex="-1" aria-labelledby="sg-modal-title-{{ scheme }}" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="sg-modal-title-{{ scheme }}">Dialog title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">A dialog keeps the colour scheme of the region it is declared in.</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Save</button>
            </div>
        </div>
    </div>
</div>
