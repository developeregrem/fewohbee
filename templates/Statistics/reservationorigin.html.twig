{% extends 'base.html.twig' %}
{% import 'Statistics/_macros.html.twig' as stat %}

{% block title %}{{ parent() }} - {{ 'statistics.origin.title'|trans }}{% endblock %}

{% block description %}{{ parent() }} - {{ 'statistics.origin.title'|trans }}{% endblock %}

{% block page_title %}{{ 'nav.origin'|trans }}{% endblock %}

{% block content %}
    <div class="container"
         data-controller="statistics"
         data-statistics-monthly-origin-url-value="{{ path('statistics.origin.monthtly') }}"
         data-statistics-yearly-origin-url-value="{{ path('statistics.origin.yearly') }}">
        <twig:PageHeader :title="'nav.origin'|trans"/>
        <form id="table-filter" role="form" class="page-toolbar mb-3">
            <select id="objects" name="object" class="form-select stat-subsidiary"
                    data-statistics-target="objects"
                    data-action="change->statistics#drawMonthlyOriginAction change->statistics#drawYearlyOriginAction">
                <option value="all">{{ 'reservation.objects.all'|trans }}</option>
                {% for object in objects %}
                    <option value="{{ object.id }}"{% if object.id == objectId %} selected{% endif %}>{{ object.name }}</option>
                {% endfor %}
            </select>
        </form>
        <div class="row g-3 justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0">{{ 'statistics.origin.monthly'|trans }}</h2>
                        <twig:IconButton icon="sync-alt" :label="'statistics.refresh'|trans" id="refreshMonthly" class="my-n2 me-n2"
                                         data-action="click->statistics#drawMonthlyOriginAction"/>
                    </div>
                    <div class="card-body">
                        <div class="stat-chart">
                            <canvas id="monthlyChart" data-statistics-target="monthlyChart"></canvas>
                        </div>
                    </div>
                    <div class="card-footer">
                        <form role="form">
                            {{ stat.monthRange('monthlyStart', 'monthlyStartYear', 'monthlyEnd', 'monthlyEndYear', 'drawMonthlyOriginAction', minYear, maxYear) }}
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0">{{ 'statistics.origin.yearly'|trans }}</h2>
                        <twig:IconButton icon="sync-alt" :label="'statistics.refresh'|trans" id="refreshYearly" class="my-n2 me-n2"
                                         data-action="click->statistics#drawYearlyOriginAction"/>
                    </div>
                    <div class="card-body">
                        <div class="stat-chart">
                            <canvas id="yearlyChart" data-statistics-target="yearlyChart"></canvas>
                        </div>
                    </div>
                    <div class="card-footer">
                        <form role="form">
                            {{ stat.yearRange('yearlyStartYear', 'yearlyEndYear', 'drawYearlyOriginAction', minYear, maxYear) }}
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
