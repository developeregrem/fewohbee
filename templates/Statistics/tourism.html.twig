{% extends 'base.html.twig' %}
{% import 'Statistics/_macros.html.twig' as stat %}

{% block title %}{{ parent() }} - {{ 'statistics.tourism.title'|trans }}{% endblock %}

{% block description %}{{ parent() }} - {{ 'statistics.tourism.title'|trans }}{% endblock %}

{% block page_title %}{{ 'nav.tourism'|trans }}{% endblock %}

{% block content %}
    <div class="container mb-1"
         data-controller="statistics"
         data-statistics-snapshot-url-value="{{ path('statistics.snapshot.monthly') }}"
         data-statistics-snapshot-ignore-url-value="{{ path('statistics.snapshot.warning.ignore', { snapshot: 0 }) }}"
         data-statistics-snapshot-arrivals-label-value="{{ 'statistics.tourism.arrivals'|trans }}"
         data-statistics-snapshot-overnights-label-value="{{ 'statistics.tourism.overnights'|trans }}"
         data-statistics-snapshot-room-label-value="{{ 'statistics.tourism.room_label'|trans }}"
         data-statistics-by-country-table-label-value="{{ 'statistics.tourism.by_country_table'|trans }}"
         data-statistics-by-state-table-label-value="{{ 'statistics.tourism.by_state_table'|trans }}"
         data-statistics-country-label-value="{{ 'statistics.tourism.country'|trans }}"
         data-statistics-state-label-value="{{ 'statistics.tourism.state'|trans }}"
         data-statistics-arrivals-by-country-label-value="{{ 'statistics.tourism.arrivals_by_country'|trans }}"
         data-statistics-overnights-by-country-label-value="{{ 'statistics.tourism.overnights_by_country'|trans }}"
         data-statistics-arrivals-by-state-label-value="{{ 'statistics.tourism.arrivals_by_state'|trans }}"
         data-statistics-overnights-by-state-label-value="{{ 'statistics.tourism.overnights_by_state'|trans }}"
         data-statistics-no-state-data-label-value="{{ 'statistics.tourism.no_state_data'|trans }}"
         data-statistics-guest-category-label-value="{{ 'statistics.tourism.guest_category'|trans }}"
         data-statistics-overnights-by-guest-category-label-value="{{ 'statistics.tourism.overnights_by_guest_category'|trans }}"
         data-statistics-no-category-data-label-value="{{ 'statistics.tourism.no_category_data'|trans }}"
         data-statistics-total-label-value="{{ 'statistics.tourism.total'|trans }}"
         data-statistics-last-calculated-label-value="{{ 'statistics.tourism.last_calculated'|trans }}">
        <input type="hidden" id="statistics_csrf_token" name="_csrf_token" value="{{ csrf_token('statistics.snapshot.warning.ignore') }}">
        <twig:PageHeader :title="'nav.tourism'|trans">
            <button type="button" class="btn btn-secondary"
                    data-action="click->statistics#drawSnapshotForceAction">
                <i class="fas fa-sync-alt me-1" aria-hidden="true"></i>{{ 'statistics.tourism.regenerate'|trans }}
            </button>
        </twig:PageHeader>
        {# The property and the month; when the figures were last calculated on the right #}
        <form id="table-filter" role="form" class="page-toolbar flex-wrap mb-3">
            <div class="d-flex flex-wrap gap-2">
                <select id="objects" name="object" class="form-select stat-subsidiary"
                                    data-statistics-target="objects"
                                    data-action="change->statistics#drawSnapshotAction">
                                <option value="all">{{ 'reservation.objects.all'|trans }}</option>
                                {% for object in objects %}
                                    <option value="{{ object.id }}"{% if object.id == objectId %} selected{% endif %}>{{ object.name }}</option>
                                {% endfor %}
                            </select>
                {{ stat.month('snapshotMonth', 'snapshotYear', 'drawSnapshotAction', minYear, maxYear) }}
            </div>
            <div class="small text-body-secondary" data-statistics-target="snapshotUpdatedAt"></div>
        </form>
        <div class="row mt-3">
            <div class="col">
                <label class="form-label mb-1">{{ 'status.title'|trans }}</label>
                <form id="reservation-status" role="form" data-statistics-target="reservationStatusForm">
                    {% for status in reservationStatuses %}
                        <div class="form-check form-switch form-check-inline">
                            <input type="checkbox" class="form-check-input" id="reservation-status-{{ status.id }}" name="reservation-status[]" value="{{ status.id }}"
                                   {% if not status.isSystem %}checked="checked"{% endif %}
                                   data-action="change->statistics#drawSnapshotAction">
                            <label class="form-check-label" for="reservation-status-{{ status.id }}">{{ status|display_name }}</label>
                        </div>
                    {% endfor %}
                </form>
            </div>
        </div>
        <div class="row mt-2">
            <div class="col">
                <div class="form-check form-switch form-check-inline">
                    <input type="checkbox" class="form-check-input" id="show-by-state"
                           data-statistics-target="showByState"
                           data-action="change->statistics#toggleByState">
                    <label class="form-check-label" for="show-by-state">{{ 'statistics.tourism.show_by_state'|trans }}</label>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0">{{ 'statistics.tourism.summary'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr>
                                    <th>{{ 'statistics.tourism.arrivals'|trans }}</th>
                                    <td data-statistics-target="snapshotArrivalsTotal">0</td>
                                </tr>
                                <tr>
                                    <th>{{ 'statistics.tourism.overnights'|trans }}</th>
                                    <td data-statistics-target="snapshotOvernightsTotal">0</td>
                                </tr>
                                <tr>
                                    <th>{{ 'statistics.tourism.rooms_total'|trans }}</th>
                                    <td data-statistics-target="snapshotRoomsTotal">0</td>
                                </tr>
                                <tr>
                                    <th>{{ 'statistics.tourism.beds_total'|trans }}</th>
                                    <td data-statistics-target="snapshotBedsTotal">0</td>
                                </tr>
                                <tr>
                                    <th>{{ 'statistics.tourism.utilization'|trans }}</th>
                                    <td data-statistics-target="snapshotUtilization">0%</td>
                                </tr>
                                <tr>
                                    <th>{{ 'statistics.blocked.room_days'|trans }}</th>
                                    <td data-statistics-target="snapshotBlockedRoomDays">0</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card mt-3">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0" data-statistics-target="byCountryTableHeader">{{ 'statistics.tourism.by_country_table'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th data-statistics-target="byCountryColumnHeader">{{ 'statistics.tourism.country'|trans }}</th>
                                        <th>{{ 'statistics.tourism.arrivals'|trans }}</th>
                                        <th>{{ 'statistics.tourism.overnights'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody data-statistics-target="snapshotByCountryBody"></tbody>
                            </table>
                        </div>
                        <div class="text-muted small mt-2 d-none" data-statistics-target="noStateDataHint">
                            {{ 'statistics.tourism.no_state_data'|trans|raw }}
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0" data-statistics-target="arrivalsChartHeader">{{ 'statistics.tourism.arrivals_by_country'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        <div style="position: relative; height:30vh;">
                            <canvas id="snapshotArrivalsChart" data-statistics-target="snapshotArrivalsChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="card mt-3">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0" data-statistics-target="overnightsChartHeader">{{ 'statistics.tourism.overnights_by_country'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        <div style="position: relative; height:30vh;">
                            <canvas id="snapshotOvernightsChart" data-statistics-target="snapshotOvernightsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0">{{ 'statistics.tourism.overnights_by_guest_category'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>{{ 'statistics.tourism.guest_category'|trans }}</th>
                                        <th class="text-end">{{ 'statistics.tourism.overnights'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody data-statistics-target="snapshotByGuestCategoryBody"></tbody>
                            </table>
                        </div>
                        <div class="text-muted small mt-2 d-none" data-statistics-target="noCategoryDataHint">
                            {{ 'statistics.tourism.no_category_data'|trans }}
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0">{{ 'statistics.tourism.overnights_by_guest_category'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        <div style="position: relative; height:30vh;">
                            <canvas id="snapshotByGuestCategoryChart" data-statistics-target="snapshotByGuestCategoryChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0">{{ 'statistics.tourism.by_country_and_category_table'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-sm mb-0">
                                <thead data-statistics-target="snapshotCountryCategoryHead"></thead>
                                <tbody data-statistics-target="snapshotCountryCategoryBody"></tbody>
                            </table>
                        </div>
                        <div class="text-muted small mt-2 d-none" data-statistics-target="noCountryCategoryDataHint">
                            {{ 'statistics.tourism.no_category_data'|trans }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0">{{ 'statistics.tourism.warnings'|trans }}</h2>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0"
                            data-statistics-target="snapshotWarnings"
                            data-empty-text="{{ 'statistics.tourism.no_warnings'|trans }}">
                            <li class="text-muted">{{ 'statistics.tourism.no_warnings'|trans }}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
