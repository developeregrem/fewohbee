{% extends 'base.html.twig' %}
{% import 'Statistics/_macros.html.twig' as stat %}

{% block title %}{{ parent() }} - {{ 'statistics.utilization.title'|trans }}{% endblock %}

{% block description %}{{ parent() }} - {{ 'statistics.utilization.title'|trans }}{% endblock %}

{% block page_title %}{{ 'nav.utilization'|trans }}{% endblock %}

{% block content %}
    <div class="container"
         data-controller="statistics"
         data-statistics-monthly-utilization-url-value="{{ path('statistics.utilization.monthtly') }}"
         data-statistics-yearly-utilization-url-value="{{ path('statistics.utilization.yearly') }}">
        <twig:PageHeader :title="'nav.utilization'|trans"/>
        <form id="table-filter" role="form" class="page-toolbar mb-3">
            <select id="objects" name="object" class="form-select stat-subsidiary"
                    data-statistics-target="objects"
                    data-action="change->statistics#drawMonthlyUtilizationAction change->statistics#drawYearlyUtilizationAction">
                <option value="all">{{ 'reservation.objects.all'|trans }}</option>
                {% for object in objects %}
                    <option value="{{ object.id }}"{% if object.id == objectId %} selected{% endif %}>{{ object.name }}</option>
                {% endfor %}
            </select>
        </form>
        <div class="row g-3 justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0">{{ 'statistics.utilization.monthly'|trans }}</h2>
                        <twig:IconButton icon="sync-alt" :label="'statistics.refresh'|trans" id="refreshMonthly" class="my-n2 me-n2"
                                         data-action="click->statistics#drawMonthlyUtilizationAction"/>
                    </div>
                    <div class="card-body">
                        <div class="stat-chart">
                            <canvas id="monthlyChart" data-statistics-target="monthlyChart"></canvas>
                        </div>
                    </div>
                    <div class="card-footer">
                        <form role="form">
                            {{ stat.monthRange('monthlyStart', 'monthlyStartYear', 'monthlyEnd', 'monthlyEndYear', 'drawMonthlyUtilizationAction', minYear, maxYear) }}
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0">{{ 'statistics.utilization.yearly'|trans }}</h2>
                        <twig:IconButton icon="sync-alt" :label="'statistics.refresh'|trans" id="refreshYearly" class="my-n2 me-n2"
                                         data-action="click->statistics#drawYearlyUtilizationAction"/>
                    </div>
                    <div class="card-body">
                        <div class="stat-chart">
                            <canvas id="yearlyChart" data-statistics-target="yearlyChart"></canvas>
                        </div>
                    </div>
                    <div class="card-footer">
                        <form role="form">
                            {{ stat.yearRange('yearlyStartYear', 'yearlyEndYear', 'drawYearlyUtilizationAction', minYear, maxYear) }}
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col">
                <label class="form-label mb-1">{{ 'status.title'|trans }}</label>
                <form id="reservation-status" role="form" data-statistics-target="reservationStatusForm">
                    {% for status in reservationStatuses %}
                        <div class="form-check form-switch form-check-inline">
                            <input type="checkbox" class="form-check-input" id="reservation-status-{{ status.id }}" name="reservation-status[]" value="{{ status.id }}"
                                   {% if not status.isSystem %}checked="checked"{% endif %}
                                   data-action="change->statistics#drawMonthlyUtilizationAction change->statistics#drawYearlyUtilizationAction">
                            <label class="form-check-label" for="reservation-status-{{ status.id }}">{{ status|display_name }}</label>
                        </div>
                    {% endfor %}
                </form>
            </div>
        </div>
    </div>
{% endblock %}
