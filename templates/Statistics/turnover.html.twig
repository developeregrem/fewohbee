
{% extends 'base.html.twig' %}
{% import 'Statistics/_macros.html.twig' as stat %}

{% block title %}{{ parent() }} - {{ 'statistics.turnover.title'|trans }}{% endblock %}

{% block description %}{{ parent() }} - {{ 'statistics.turnover.title'|trans }}{% endblock %}

{% block page_title %}{{ 'nav.turnover'|trans }}{% endblock %}

{% block content %}
    <div class="container"
         data-controller="statistics"
         data-statistics-monthly-url-value="{{ path('statistics.turnover.monthly') }}"
         data-statistics-yearly-url-value="{{ path('statistics.turnover.yearly') }}">
        <twig:PageHeader :title="'nav.turnover'|trans"/>
        <div class="row g-3 justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0">{{ 'statistics.turnover.monthly'|trans }}</h2>
                        <twig:IconButton icon="sync-alt" :label="'statistics.refresh'|trans" id="refreshMonthly" class="my-n2 me-n2"
                                         data-action="click->statistics#drawMonthlyTurnoverAction"/>
                    </div>
                    <div class="card-body">
                        <div class="stat-chart">
                            <canvas id="monthlyChart" data-statistics-target="monthlyChart"></canvas>
                        </div>
                    </div>
                    <div class="card-footer">
                        <form role="form">
                            {{ stat.yearRange('monthlyStartYear', 'monthlyEndYear', 'drawMonthlyTurnoverAction', minYear, maxYear) }}
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card" id="yearlyCard">
                    <div class="card-header stat-card-header">
                        <h2 class="h6 mb-0">{{ 'statistics.turnover.yearly'|trans }}</h2>
                        <twig:IconButton icon="sync-alt" :label="'statistics.refresh'|trans" id="refreshYearly" class="my-n2 me-n2"
                                         data-action="click->statistics#drawYearlyTurnoverAction"/>
                    </div>
                    <div class="card-body">
                        <div class="stat-chart">
                            <canvas id="yearlyChart" data-statistics-target="yearlyChart"></canvas>
                        </div>
                    </div>
                    <div class="card-footer">
                        <form role="form">
                            {{ stat.yearRange('yearlyStartYear', 'yearlyEndYear', 'drawYearlyTurnoverAction', minYear, maxYear) }}
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col">
                <span class="text-info"><i class="fas fa-info-circle"></i> {{ 'statistics.turnover.help'|trans }}</span>
            </div>
        </div>
        <div class="row mt-3">
                <form id="invoice-status" role="form" data-statistics-target="invoiceStatusForm">
                    <div class="form-check form-switch form-check-inline">
                        <input type="checkbox" class="form-check-input" id="invoice-status-1" name="invoice-status[]" value="1"
                               data-action="change->statistics#drawMonthlyTurnoverAction change->statistics#drawYearlyTurnoverAction">
                        <label class="form-check-label" for="invoice-status-1">{{ 'invoice.status.unpaid'|trans }}</label>
                    </div>
                    <div class="col form-check form-switch form-check-inline">
                        <input type="checkbox" class="form-check-input" id="invoice-status-3" name="invoice-status[]" value="3"
                               data-action="change->statistics#drawMonthlyTurnoverAction change->statistics#drawYearlyTurnoverAction">
                        <label class="form-check-label" for="invoice-status-3">{{ 'invoice.status.prepaid'|trans }}</label>
                    </div>
                    <div class="col form-check form-switch form-check-inline">
                        <input type="checkbox" class="form-check-input" id="invoice-status-2" name="invoice-status[]" value="2" checked="checked"
                               data-action="change->statistics#drawMonthlyTurnoverAction change->statistics#drawYearlyTurnoverAction">
                        <label class="form-check-label" for="invoice-status-2">{{ 'invoice.status.paid'|trans }}</label>
                    </div>
                    <div class="col form-check form-switch form-check-inline">
                        <input type="checkbox" class="form-check-input" id="invoice-status-4" name="invoice-status[]" value="4"
                               data-action="change->statistics#drawMonthlyTurnoverAction change->statistics#drawYearlyTurnoverAction">
                        <label class="form-check-label" for="invoice-status-4">{{ 'invoice.status.canceled'|trans }}</label>
                    </div>
                </form>

        </div>
        <div class="row mt-3">
                <form id="turnover-forecast" role="form" data-statistics-target="forecastForm">
                    <div class="form-check form-switch form-check-inline">
                        <input type="checkbox" class="form-check-input" id="forecast" name="forecast" value="1" checked="checked"
                               data-statistics-target="forecastSwitch"
                               data-action="change->statistics#toggleForecastAction">
                        <label class="form-check-label" for="forecast">{{ 'statistics.turnover.forecast.show'|trans }}</label>
                    </div>
                    <div class="col form-check form-switch form-check-inline">
                        <input type="checkbox" class="form-check-input" id="forecast-invoiced" name="forecast-invoiced" value="1"
                               data-statistics-target="forecastInvoicedSwitch"
                               data-action="change->statistics#drawMonthlyTurnoverAction change->statistics#drawYearlyTurnoverAction">
                        <label class="form-check-label" for="forecast-invoiced">{{ 'statistics.turnover.forecast.include_invoiced'|trans }}</label>
                    </div>
                </form>
        </div>
    </div>
{% endblock %}
