{% import 'Invoices/_position_macros.html.twig' as positionMacros %}
{% set modifierPositions = positionsMiscellaneous|filter(p => p.positionGroup == 'apartment_modifier') %}
{% if modifierPositions|length > 0 %}
    <ul class="list-group">
        {% for key, position in modifierPositions %}
            {{ positionMacros.misc_item(key, position) }}
        {% endfor %}
    </ul>
{% endif %}
