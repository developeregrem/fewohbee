{% import 'Invoices/_position_macros.html.twig' as positionMacros %}
<ul class="list-group">
    {% for key, position in positionsAppartment %}
        <li class="list-group-item d-flex align-items-center gap-2">
            <div class="me-auto text-break">
                <div class="fw-semibold">{{ position.number }} · {{ position.description }}</div>
                <div class="small text-body-secondary">
                    {{ position.startdate|date('d.m.Y') }} – {{ position.enddate|date('d.m.Y') }}
                    · {{ 'reservation.summary.persons'|trans({'%count%': position.persons}) }}
                    · {{ position.beds }} {{ 'invoice.appartment.position.beds'|trans }}
                    · {{ 'invoice.vat'|trans }} {{ positionMacros.vat(position.vat) }} %
                </div>
            </div>
            <div class="text-end text-nowrap">{{ position.price|number_format(2, ',', '.') }}</div>
            {% if mode is defined and mode == 'edit' %}
                <button type="button" class="btn btn-sm btn-link text-body-secondary"
                        data-action="click->invoices#openModalAction"
                        data-url="{{ path('invoices.edit.apartment.position', {'invoiceId': 'new', 'id': key}) }}"
                        title="{{ 'button.edit'|trans }}" aria-label="{{ 'button.edit'|trans }}"><i class="fas fa-edit"></i></button>
                <button type="button" class="btn btn-sm btn-link text-danger"
                        data-action="click->invoices#removeApartmentPositionAction"
                        data-url="{{ path('invoices.delete.appartment.invoice.position') }}" data-index="{{ key }}"
                        title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}"><i class="fas fa-trash-alt"></i></button>
            {% endif %}
        </li>
    {% endfor %}
</ul>
