{% import 'Invoices/_position_macros.html.twig' as positionMacros %}
<ul class="list-group">
    {% for key, position in positionsAppartment %}
        <li class="list-group-item d-flex align-items-center gap-2">
            <div class="me-auto text-break">
                <div class="fw-semibold">{{ position.number }} · {{ position.description }}</div>
                <div class="small text-body-secondary">
                    {{ position.startdate|date('d.m.Y') }} – {{ position.visibleEndDate|date('d.m.Y') }}
                    · {{ 'reservation.summary.persons'|trans({'%count%': position.persons}) }}
                    · {% if position.eventSpace %}{{ 'appartment.bedsmax'|trans }}: {{ position.beds }}{% else %}{{ position.beds }} {{ 'invoice.appartment.position.beds'|trans }}{% endif %}
                    · {{ 'invoice.vat'|trans }} {{ positionMacros.vat(position.vat) }} %
                </div>
            </div>
            <div class="text-end text-nowrap">{{ position.price|number_format(2, ',', '.') }}</div>
            {% if mode is defined and mode == 'edit' %}
                <twig:IconButton icon="pen" :label="'button.edit'|trans" data-action="click->invoices#openModalAction" data-url="{{ path('invoices.edit.apartment.position', {'invoiceId': 'new', 'id': key}) }}"/>
                <twig:IconButton icon="trash-alt" :label="'button.delete'|trans" class="text-danger" data-action="click->invoices#removeApartmentPositionAction" data-url="{{ path('invoices.delete.appartment.invoice.position') }}" data-index="{{ key }}"/>
            {% endif %}
        </li>
    {% endfor %}
</ul>
