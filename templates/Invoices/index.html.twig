{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - {{ 'invoice.title'|trans }}{% endblock %}

{% block description %}{{ parent() }} - {{ 'invoice.description'|trans }}{% endblock %}

{% block page_title %}{{ 'nav.short.invoices'|trans }}{% endblock %}

{% block content %}
    <div class="container fab-add-clearance" data-controller="invoices swipe-nav">
        <twig:PageHeader :title="'nav.short.invoices'|trans">
            <twig:AddButton :label="'nav.invoice.add'|trans"
                            data-action="click->invoices#openModalAction"
                            data-url="{{ path('invoices.new.invoice') }}" data-create-new="true"
                            data-title="{{ 'invoice.select.open.reservation'|trans }}"
                            data-bs-toggle="modal" data-bs-target="#modalCenter"/>
        </twig:PageHeader>

        <twig:DataCard>
            <twig:block name="toolbar">
                <twig:SearchField :placeholder="'invoice.search.placeholder'|trans" :value="search"
                                  id="invoices-search-form"
                                  data-search-url="{{ path('invoices.search') }}"
                                  data-action="submit->invoices#doSearchAction"
                                  novalidate
                                  input:id="search"
                                  input:data-action="input->invoices#searchInputAction"/>
                <twig:IconButton icon="cog" :label="'invoice.settings.text'|trans"
                                 data-action="click->invoices#openModalAction"
                                 data-url="{{ path('invoices.settings.get') }}"
                                 data-title="{{ 'invoice.settings.text'|trans }}"
                                 data-bs-toggle="modal" data-bs-target="#modalCenter"/>
            </twig:block>
            <div id="invoice-table">
                {% include 'Invoices/invoice_table.html.twig' %}
            </div>
        </twig:DataCard>
    </div>
{% endblock %}
