<form id="invoice-number-form" class="form-horizontal" role="form" method="POST"
      action="{{ path('invoices.edit.invoice.number.save') }}"
      data-action="submit->invoices#submitFormAction" data-controller="invoices" data-payment-due-scope="">
    <div class="modal-body px-lg-5">
        <div class="row">
            <div class="col-md-7">
                <p>
                <div class="row">
                    <label for="salutation" class="col-sm-4 col-form-label">{{ 'invoice.number.short'|trans }} *</label>
                    <div class="col-sm">
                        <input type="text" class="form-control" id="salutatinumberon" name="number" value="{{ invoice.number }}" required>
                    </div>
                </div>
                <div class="row">
                    <label for="firstname" class="col-sm-4 col-form-label">{{ 'invoice.date2'|trans }} *</label>
                    <div class="col-sm">
                        <input type="date" class="form-control" style="width: 7rem" id="date" name="date" value="{{ invoice.date|date("Y-m-d") }}" required
                               data-payment-invoice-date="" data-action="change->invoices#paymentInvoiceDateChangedAction">
                    </div>
                </div>
                <div class="row">
                    <label for="payment_due_date" class="col-sm-4 col-form-label text-nowrap">{{ 'invoice.payment_due.date'|trans }}{% if dueDateRequired %} *{% endif %}</label>
                    <div class="col-sm">
                        {% set dueDateWidget %}
                            <input type="date" class="form-control" style="width: 7rem" id="payment_due_date" name="payment_due_date"
                                   value="{{ invoice.paymentDueDate ? invoice.paymentDueDate|date('Y-m-d') }}"{% if dueDateRequired %} required{% endif %}
                                   data-payment-due-date="">
                        {% endset %}
                        {% include 'Invoices/_payment_due_input.html.twig' with {
                            'dateWidget': dueDateWidget,
                            'invoiceDate': invoice.date|date('Y-m-d'),
                            'settingsDays': settingsDueDays,
                            'firstArrival': firstArrival ? firstArrival|date('Y-m-d') : null,
                            'lastDeparture': lastDeparture ? lastDeparture|date('Y-m-d') : null,
                        } %}
                    </div>
                </div>
                </p>
            </div>
            <div class="col-md-5 order-first order-md-last mb-4 mb-md-0">
                {% include 'Invoices/invoice_form_reservation_list_fields.html.twig' %}
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <a href="#" class="btn btn-link px-0 me-auto text-decoration-none"
                {% if invoiceId == 'new' %}
                    data-action="click->invoices#openModalAction" data-url="{{ path('invoices.create.invoice.positions') }}"
                {% else %}
                    data-action="click->invoices#showInvoiceAction" data-url="{{ path('invoices.get.invoice', {'id': invoiceId}) }}" data-edit="true"
                {% endif %}>&larr; {{ 'button.back'|trans }}</a>
        <input type="submit" value="{{ 'button.save'|trans }}" class="btn btn-primary" />
    </div>
    <input type="hidden" name="invoice-id" value="{{ invoiceId }}" />
    <input name="_csrf_token" value="{{ token }}" type="hidden">
</form>
