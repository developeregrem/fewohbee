<div class="modal-body" data-controller="invoices">
	<div class="ps-3 pe-3">
        <div id="flash-message-overlay">
            <div class="col">
                {% include 'feedback.html.twig' %}
            </div>
        </div>
		{% set einvoiceTabActive = (activeTab is defined and activeTab == 'einvoice') %}
		<nav>
			<div class="nav nav-tabs" id="nav-tab" role="tablist">
				<button class="nav-link{{ einvoiceTabActive ? '' : ' active' }}" id="nav-template-tab" data-bs-toggle="tab" data-bs-target="#nav-template" type="button" role="tab" aria-controls="nav-template" aria-selected="{{ einvoiceTabActive ? 'false' : 'true' }}">{{ 'invoice.settings.title.template'|trans }}</button>
				<button class="nav-link{{ einvoiceTabActive ? ' active' : '' }}" id="nav-einvoice-tab" data-bs-toggle="tab" data-bs-target="#nav-einvoice" type="button" role="tab" aria-controls="nav-einvoice" aria-selected="{{ einvoiceTabActive ? 'true' : 'false' }}">{{ 'invoice.settings.title.einvoice'|trans }}</button>
			</div>
		</nav>
		<div class="tab-content p-4" id="nav-tabContent">
			<div class="tab-pane fade{{ einvoiceTabActive ? '' : ' show active' }}" id="nav-template" role="tabpanel" aria-labelledby="nav-template-tab" tabindex="0">
				<div class="row">
					<label for="object" class="col-sm-4 col-form-label text-end">{{ 'invoice.template'|trans }}</label>
					<div class="col-sm">
						<select id="template" name="template" class="form-select" data-action="change->invoices#persistTemplateSelectionAction">
							{% for template in templates %}
								<option value="{{ template.id }}" {% if template.id==templateId %} selected {% endif %}>{{
                        template.name }}</option>
							{% endfor %}
						</select>
					</div>
				</div>
			</div>
			<div class="tab-pane fade{{ einvoiceTabActive ? ' show active' : '' }}" id="nav-einvoice" role="tabpanel" aria-labelledby="nav-einvoice-tab" tabindex="0">
				{# Without a default record every branch that has none of its own is left without
				   issuer data — better said here than at export time. #}
				{% if settings|length > 0 and not hasDefaultSetting %}
					<div class="alert alert-warning py-2 mt-3">{{ 'invoice.settings.no_default.hint'|trans }}</div>
				{% endif %}
				<div class="row">
					<div class="accordion" id="accordionSettings">
						{% for form in forms %}
							{% include 'Invoices/_settings_form.html.twig' with {'form': form, 'idx': loop.index, 'setting': settings[loop.index0]}%}
						{% else %}
							<div class="row mt-4 mb-4">
								<div class="col-md-12 text-center">
									<p class="text-muted">{{ 'invoice.settings.no_settings'|trans }}</p>
								</div>
							</div>
						{% endfor %}
					</div>

				</div>
				<div class="text-center pt-4">
					<button type="button" class="btn btn-secondary" data-action="click->invoices#openModalAction" data-bs-target="#modalCenter" 
                        data-url="{{ path('invoices.settings.new') }}" title="{{ 'invoice.settings.add'|trans }}">
						<i class="fas fa-plus"></i>
						{{ 'invoice.settings.add'|trans }}</button>
				</div>
			</div>
		</div>
	</div>
</div>
