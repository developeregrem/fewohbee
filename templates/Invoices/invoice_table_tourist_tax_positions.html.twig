{% import 'Invoices/_position_macros.html.twig' as positionMacros %}
{% set touristTaxPositions = positionsMiscellaneous|filter(p => p.positionGroup == 'tourist_tax') %}
{% if touristTaxPositions|length > 0 %}
    <ul class="list-group">
        {% for key, position in touristTaxPositions %}
            {{ positionMacros.misc_item(key, position) }}
        {% endfor %}
    </ul>
{% endif %}
