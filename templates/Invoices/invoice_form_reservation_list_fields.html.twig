{# The booked stays as a reference while filling in a position: on top on phones, beside the form on wider screens #}
<h2 class="small text-uppercase fw-semibold text-body-secondary mb-2">{{ 'reservation.selected.reservations'|trans }}</h2>
<ul class="list-group">
    {% for reservation in reservations %}
        <li class="list-group-item">
            <div class="fw-semibold">{{ reservation.appartment.number }} · {{ reservation.appartment.roomCategory ? reservation.appartment.roomCategory.name : reservation.appartment.description }}</div>
            <div class="small text-body-secondary">
                {{ reservation.startdate|date('d.m.Y') }} – {{ reservation.enddate|date('d.m.Y') }}
                · {{ 'reservation.summary.nights'|trans({'%count%': get_date_diff_amount(reservation.startdate, reservation.enddate)}) }}
                · {{ 'reservation.summary.persons'|trans({'%count%': reservation.persons}) }}
            </div>
        </li>
    {% endfor %}
</ul>
