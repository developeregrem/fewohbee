<div class="row">
    <label for="recommendation"
           class="col-sm-4 col-form-label text-end">{{ 'invoice.customer.recommendation'|trans }}</label>
    <div class="col-sm">
        <select id="recommendation" name="recommendation" class="form-select" data-action="change->invoices#fillCustomerRecommendationAction">>
            <option value="0"></option>
            {% for customer in customers %}
                {% for address in customer.customerAddresses %}
                    <option
                            value="{{ customer.salutation }}|{{ customer.firstname }}|{{ customer.lastname }}|{{ address.company }}|{{ address.address }}|{{ address.zip }}|{{ address.city }}|{{ address.country }}|{{ address.phone }}|{{ address.email }}|{{ address.buyerVatId }}|{{ address.buyerReference }}|{{ address.customerIBAN }}">
                        {{ customer.salutation }} {{ customer.firstname }} {{ customer.lastname }}{% if address.company %} | {{ 'customer.company'|trans }}: {{ address.company }}{% endif %}
                    </option>
                {% endfor %}
            {% endfor %}
        </select>
    </div>
</div>

{% if readiness is defined and readiness is not null and readiness.configured and not readiness.ready %}
    {% set invoiceViolations = readiness.result.violationsByLocation(constant('App\\Service\\EInvoice\\Validation\\EInvoiceFixLocation::INVOICE')) %}
    {% if invoiceViolations|length > 0 %}
        <details class="einvoice-readiness d-inline-block small mt-2">
            <summary class="text-warning">
                <i class="fa-solid fa-circle-info"></i> {{ 'invoice.einvoice.notready.short'|trans }}
            </summary>
            <div class="mt-1 ps-3 border-start text-muted">
                <div class="fw-semibold">{{ 'invoice.einvoice.status.missing'|trans }}:</div>
                <ul class="mb-0">
                    {% for violation in invoiceViolations %}
                        <li>{{ violation.messageKey|trans }}</li>
                    {% endfor %}
                </ul>
            </div>
        </details>
    {% endif %}
{% endif %}

<h5 class="mt-3">{{ 'invoice.customer.section.contact'|trans }}</h5>
{{ form_row(form.salutation) }}
{{ form_row(form.firstname) }}
{{ form_row(form.lastname) }}
{{ form_row(form.company) }}

<h5 class="mt-4">{{ 'invoice.customer.section.address'|trans }}</h5>
{{ form_row(form.address) }}
{{ form_row(form.zip) }}
{{ form_row(form.city) }}
{{ form_row(form.country) }}

<h5 class="mt-4">{{ 'invoice.customer.section.communication'|trans }}</h5>
{{ form_row(form.phone) }}
{{ form_row(form.email) }}

<h5 class="mt-4">{{ 'invoice.customer.section.einvoice'|trans }}</h5>
<p class="text-muted small mb-2">{{ 'invoice.customer.einvoice.hint'|trans }}</p>
{{ form_row(form.buyerReference) }}
{{ form_row(form.buyerVatId) }}

<details class="mt-4"{% if not form.vars.valid %} open{% endif %}>
    <summary class="fw-bold mb-2">{{ 'invoice.customer.section.payment'|trans }}</summary>
    <p class="text-muted small mb-2">{{ 'invoice.customer.payment.hint'|trans }}</p>
    {{ form_row(form.cardHolder) }}
    {{ form_row(form.cardNumber) }}
    {{ form_row(form.customerIBAN) }}
    {{ form_row(form.mandateReference) }}
</details>
