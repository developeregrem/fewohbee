{% import 'Invoices/_position_macros.html.twig' as positionMacros %}
{% set miscPositions = positionsMiscellaneous|filter(p => p.positionGroup != 'tourist_tax' and p.positionGroup != 'apartment_modifier') %}
{% if miscPositions|length > 0 %}
    <ul class="list-group">
        {% for key, position in miscPositions %}
            {{ positionMacros.misc_item(key, position) }}
        {% endfor %}
    </ul>
{% endif %}
