{# Fields of InvoicePaymentRemarkType, shared by the edit modal and the new-invoice preview. #}
{{ form_row(form.paymentMeans) }}
{# Same grid as form_row in the horizontal theme, with the helpers next to and under the date. #}
<div class="mb-3 row">
    {{ form_label(form.paymentDueDate) }}
    <div class="col-sm">
        <div class="d-flex flex-wrap align-items-center gap-2">
            {{ form_widget(form.paymentDueDate, {'attr': {'class': 'w-auto', 'data-action': 'change->invoices#paymentDueDateChangedAction', 'data-payment-due-date': ''}}) }}
            {# Helpers only: no name, so they are never submitted and cannot block saving. #}
            {% if form.vars.payment_due_invoice_date %}
                <div class="input-group w-auto">
                    <input type="number" class="form-control" style="width: 5rem" min="0" max="365" step="1"
                           id="{{ form.paymentDueDate.vars.id }}_days"
                           aria-label="{{ 'invoice.payment_due.days'|trans }}"
                           value="{{ form.vars.payment_due_days }}"
                           data-invoice-date="{{ form.vars.payment_due_invoice_date }}"
                           data-action="input->invoices#paymentDueDaysChangedAction"
                           data-payment-due-days="">
                    <span class="input-group-text">{{ 'invoice.payment_due.days'|trans }}</span>
                </div>
            {% endif %}
        </div>
        {% if form.vars.payment_due_last_departure %}
            {# A link, not a .btn: the theme sets buttons in capitals. It only fills in the date. #}
            <div class="mt-1">
                <a href="#" role="button" class="small"
                   data-departure="{{ form.vars.payment_due_last_departure }}"
                   data-action="click->invoices#paymentDueToDepartureAction">{{ 'invoice.payment_due.last_departure'|trans }} ({{ form.vars.payment_due_last_departure|date('d.m.Y') }})</a>
            </div>
        {% endif %}
        {{ form_errors(form.paymentDueDate) }}
    </div>
</div>
{{ form_rest(form) }}
