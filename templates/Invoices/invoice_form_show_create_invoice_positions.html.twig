<div data-controller="invoices reservations">
<div class="modal-body">
    <div class="px-lg-5">
        <div id="flash-message-overlay">{% include 'feedback.html.twig' %}</div>
        {# Number left, invoice date right, due date between them: space-between keeps both gaps equal. #}
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3" data-invoices-meta-url="{{ path('invoices.create.invoice.meta') }}" id="invoice-meta" data-payment-due-scope="">
            <div style="width: 14rem">
                <label for="invoiceidInput" class="form-label">{{ 'invoice.id'|trans }}</label>
                <input type="text" name="invoiceid" class="form-control"
                    placeholder="{{ 'invoice.id'|trans }}"
                    value="{{ invoiceid }}"
                    id="invoiceidInput"
                    data-action="input->invoices#updateInvoiceMetaAction">
                {% if numberRangeConfigured %}
                    {# Shows which number range produced the suggestion, so a wrong branch is spotted before saving. #}
                    <small class="form-text text-muted">
                        {{ 'invoice.number.range.hint'|trans({'%range%': numberRangeSubsidiary ? numberRangeSubsidiary.name : 'invoice.number.range.global'|trans}) }}
                    </small>
                {% elseif lastinvoiceid is not empty %}
                    <small class="form-text text-muted">{{ 'invoice.id.last'|trans }} {{ lastinvoiceid }}</small>
                {% endif %}
            </div>
            <div>
                <label for="paymentDueDate" class="form-label">{{ 'invoice.payment_due.date'|trans }}</label>
                {% set dueDateWidget %}
                    <input type="date" name="paymentDueDate" class="form-control" style="width: 7rem" id="paymentDueDate"
                           value="{{ invoice.paymentDueDate ? invoice.paymentDueDate|date('Y-m-d') }}"{% if dueDateRequired %} required{% endif %}
                           data-payment-due-date=""
                           data-action="change->invoices#updateInvoiceMetaAction">
                {% endset %}
                {% include 'Invoices/_payment_due_input.html.twig' with {
                    'dateWidget': dueDateWidget,
                    'invoiceDate': invoiceDate|date('Y-m-d'),
                    'settingsDays': settingsDueDays,
                    'firstArrival': firstArrival ? firstArrival|date('Y-m-d') : null,
                    'lastDeparture': lastDeparture ? lastDeparture|date('Y-m-d') : null,
                } %}
            </div>
            <div>
                <label for="invoiceDate" class="form-label">{{ 'invoice.date'|trans }}</label>
                <input type="date" name="invoiceDate" class="form-control" style="width: 7rem" id="invoiceDate"
                       value="{{ invoiceDate|date("Y-m-d") }}"
                       data-payment-invoice-date=""
                       data-action="change->invoices#paymentInvoiceDateChangedAction change->invoices#updateInvoiceMetaAction">
            </div>
        </div>
        <div class="row mt-3">
            <div class="col">
                {% include 'Invoices/_einvoice_readiness.html.twig' %}
            </div>
        </div>
        <section class="mt-4">
            <div class="d-flex align-items-center mb-2">
                <h2 class="small text-uppercase fw-semibold text-body-secondary mb-0 me-auto">{{ 'invoice.guest'|trans }}</h2>
                <button type="button" class="btn btn-sm btn-outline-primary text-nowrap"
                        data-action="click->invoices#openModalAction" data-url="{{ path('invoices.show.change.customer') }}">
                    <i class="fas fa-edit me-1"></i> {{ 'button.edit'|trans }}</button>
            </div>
            <div class="fw-semibold">{{ invoice.salutation }} {{ invoice.firstname }} {{ invoice.lastname }}</div>
            {% if invoice.company is not empty %}<div>{{ invoice.company }}</div>{% endif %}
            <div>{{ invoice.address }}, {% if invoice.country is not empty %}{{ invoice.country }}-{% endif %}{{ invoice.zip }} {{ invoice.city }}</div>
            {% if invoice.phone is not empty or invoice.email is not empty %}
                <div class="d-flex flex-wrap column-gap-3 text-body-secondary">
                    {% if invoice.phone is not empty %}<span><i class="fa-solid fa-phone fa-sm me-1"></i>{{ invoice.phone }}</span>{% endif %}
                    {% if invoice.email is not empty %}<span class="text-break"><i class="fa-solid fa-envelope fa-sm me-1"></i>{{ invoice.email }}</span>{% endif %}
                </div>
            {% endif %}
        </section>

        <section class="mt-4">
            <div class="d-flex align-items-center mb-2">
                <h2 class="small text-uppercase fw-semibold text-body-secondary mb-0 me-auto">{{ 'invoice.appartment'|trans }}</h2>
                <button type="button" class="btn btn-sm btn-outline-primary text-nowrap"
                        data-action="click->invoices#openModalAction" data-url="{{ path('invoices.new.apartment.position', {'invoiceId': 'new'}) }}">
                    <i class="fas fa-plus me-1"></i> {{ 'button.add'|trans }}</button>
            </div>
            {% include 'Invoices/invoice_table_apartment_positions.html.twig' with {'mode': 'edit'} %}
        </section>

        {% if positionsMiscellaneous|filter(p => p.positionGroup == 'apartment_modifier')|length > 0 %}
        <section class="mt-4">
            <div class="d-flex align-items-center mb-2">
                <h2 class="small text-uppercase fw-semibold text-body-secondary mb-0 me-auto">{{ 'invoice.apartment_modifier.heading'|trans }}</h2>
            </div>
            {% include 'Invoices/invoice_table_apartment_modifier_positions.html.twig' with {'mode': 'edit'} %}
        </section>
        {% endif %}

        {% if positionsMiscellaneous|filter(p => p.positionGroup == 'tourist_tax')|length > 0 %}
        <section class="mt-4">
            <div class="d-flex align-items-center mb-2">
                <h2 class="small text-uppercase fw-semibold text-body-secondary mb-0 me-auto">{{ 'invoice.tourist_tax.heading'|trans }}</h2>
            </div>
            {% include 'Invoices/invoice_table_tourist_tax_positions.html.twig' with {'mode': 'edit'} %}
        </section>
        {% endif %}

        <section class="mt-4">
            <div class="d-flex align-items-center mb-2">
                <h2 class="small text-uppercase fw-semibold text-body-secondary mb-0 me-auto">{{ 'invoice.miscellaneous'|trans }}</h2>
                <button type="button" class="btn btn-sm btn-outline-primary text-nowrap"
                        data-action="click->invoices#openModalAction" data-url="{{ path('invoices.new.miscellaneous.position', {'invoiceId': 'new'}) }}">
                    <i class="fas fa-plus me-1"></i> {{ 'button.add'|trans }}</button>
            </div>
            {% include 'Invoices/invoice_table_misc_positions.html.twig' with {'mode': 'edit'} %}
        </section>
    </div>
</div>
<div class="modal-footer">
    <a href="#" class="btn btn-link px-0 me-auto text-decoration-none"
       data-action="click->reservations#selectReservationAction"
       data-url="{{ path('invoices.select.reservation') }}">&larr; {{ 'button.back'|trans }}</a>
    {% if canContinue %}
        <button type="button" class="btn btn-primary"
                data-action="click->invoices#showNewInvoicePreviewAction"
                data-url="{{ path('invoices.show.new.invoice.preview') }}">{{ 'button.continue'|trans }} &rarr;</button>
    {% endif %}
</div>
</div>
