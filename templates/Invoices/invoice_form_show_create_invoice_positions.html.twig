<div data-controller="invoices reservations">
<div class="modal-body">
    <div class="ps-5 pe-5">
        <div id="flash-message-overlay">{% include 'feedback.html.twig' %}</div>
        <div class="row" data-invoices-meta-url="{{ path('invoices.create.invoice.meta') }}" id="invoice-meta">
            <div class="col">
                <label for="invoiceidInput" class="form-label">{{ 'invoice.id'|trans }}</label>
                <input type="text" name="invoiceid" class="form-control"
                    placeholder="{{ 'invoice.id'|trans }}"
                    value="{{ invoiceid }}"
                    id="invoiceidInput"
                    data-action="input->invoices#updateInvoiceMetaAction">
                {% if numberRangeConfigured %}
                    {# Shows which number range produced the suggestion, so a wrong branch is spotted before saving. #}
                    <small class="form-text text-muted">
                        {{ 'invoice.number.range.hint'|trans({'%range%': numberRangeSubsidiary ? numberRangeSubsidiary.name : 'invoice.number.range.global'|trans}) }}
                    </small>
                {% elseif lastinvoiceid is not empty %}
                    <small class="form-text text-muted">{{ 'invoice.id.last'|trans }} {{ lastinvoiceid }}</small>
                {% endif %}
            </div>
            <div class="col">
                <label for="invoiceDate" class="form-label">{{ 'invoice.date'|trans }}</label>
                <input type="date" name="invoiceDate" class="form-control" id="invoiceDate"
                       value="{{ invoiceDate|date("Y-m-d") }}"
                       data-action="change->invoices#updateInvoiceMetaAction">
            </div>
        </div>
        <div class="row mt-3">
            <div class="col">
                {% include 'Invoices/_einvoice_readiness.html.twig' %}
            </div>
        </div>
        <div class="row">
            <div class="col">
                <h4 class="mt-4">{{ 'invoice.guest'|trans }}&nbsp;
                    <small>
                    <a href="#" data-action="click->invoices#openModalAction" data-url="{{ path('invoices.show.change.customer') }}"
                       title="{{ 'button.edit'|trans }}" class="text-secondary">
                        <i class="fas fa-edit"></i></a>
                    </small>
                </h4>
                {{ invoice.salutation }} <br />
                {{ invoice.firstname }} {{ invoice.lastname }}<br />
                {% if invoice.company is not empty %}
                    {{ invoice.company }}<br/>
                {% endif %}
                {{ invoice.address }}<br />
                {% if invoice.country is not empty %}{{ invoice.country }}-{% endif %}{{ invoice.zip }} {{ invoice.city }}
                {% if invoice.phone is not empty %}
                <br /><i class="fa-solid fa-phone"></i> {{ invoice.phone }}
                {% endif %}
                {% if invoice.email is not empty %}
                <br /><i class="fa-solid fa-envelope"></i> {{ invoice.email }}
                {% endif %}
            </div>
        </div>
        <div class="row mt-4">
            <div class="col">
                <h4>{{ 'invoice.appartment'|trans }}</h4>
                {% include 'Invoices/invoice_table_apartment_positions.html.twig' with {'mode': 'edit'} %}
                <button type="button" class="btn btn-secondary" data-action="click->invoices#openModalAction" data-url="{{ path('invoices.new.apartment.position', {'invoiceId': 'new'}) }}">
                    <i class="fas fa-plus"></i> {{ 'invoice.position.add.appartment'|trans }}</button>
            </div>
        </div>

        {% if positionsMiscellaneous|filter(p => p.positionGroup == 'apartment_modifier')|length > 0 %}
        <div class="row mt-4">
            <div class="col">
                <h4>{{ 'invoice.apartment_modifier.heading'|trans }}</h4>
                {% include 'Invoices/invoice_table_apartment_modifier_positions.html.twig' with {'mode': 'edit'} %}
            </div>
        </div>
        {% endif %}

        {% if positionsMiscellaneous|filter(p => p.positionGroup == 'tourist_tax')|length > 0 %}
        <div class="row mt-4">
            <div class="col">
                <h4>{{ 'invoice.tourist_tax.heading'|trans }}</h4>
                {% include 'Invoices/invoice_table_tourist_tax_positions.html.twig' with {'mode': 'edit'} %}
            </div>
        </div>
        {% endif %}

        <div class="row mt-4">
            <div class="col">
                <p>
                <h4>{{ 'invoice.miscellaneous'|trans }}</h4>
                {% include 'Invoices/invoice_table_misc_positions.html.twig' with {'mode': 'edit'} %}
                <button type="button" class="btn btn-secondary" data-action="click->invoices#openModalAction" data-url="{{ path('invoices.new.miscellaneous.position', {'invoiceId': 'new'}) }}">
                    <i class="fas fa-plus"></i> {{ 'invoice.position.add.miscellaneous'|trans }}</button>
                </p>
            </div>
        </div>
    </div>
</div>
<div class="modal-footer">
    <ul class="pagination me-auto">
        <li class="page-item " data-action="click->reservations#selectReservationAction" data-url="{{ path('invoices.select.reservation') }}">
            <a class="page-link" href="#">&larr; {{ 'button.back'|trans }}</a></li>
    </ul>
    {% if canContinue %}
    <ul class="pagination">
        <li class="page-item" data-action="click->invoices#showNewInvoicePreviewAction" data-url="{{ path('invoices.show.new.invoice.preview') }}">
            <a class="page-link" href="#">{{ 'button.continue'|trans }}&rarr;</a>
        </li>
    </ul>
    {% endif %}
</div>
</div>
