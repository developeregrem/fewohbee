<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-bs-theme="light" data-theme-preference="{{ app.user ? app.user.themePreference : 'auto' }}" data-controller="theme"
      data-base-path="{{ app.request.basepath }}"
      {#- The collapsed sidebar is remembered in a cookie (app_shell_controller.js) and rendered here, so nothing jumps on load #}
      {%- if app.request.cookies.get('feb_nav') == 'rail' %} class="app-nav-rail"{% endif %}>
<head>
    <meta charset="UTF-8"/>
    <title>{% block title %}FewohBee{% endblock %}</title>
    <meta name="description" content="{% block description %}Welcome!{% endblock %}">
    <meta name="keywords" content="{% block keywords %}{% endblock %}">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    {# First, so that Bootstrap and the theme (stylesheets imported by assets/app.js) come before a page's own stylesheets #}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ app.request.basepath }}/resources/fas/7.3.1/css/fontawesome.min.css">
        <link rel="stylesheet" href="{{ app.request.basepath }}/resources/fas/7.3.1/css/solid.min.css">
        <link rel="stylesheet" href="{{ app.request.basepath }}/resources/fas/7.3.1/css/regular.min.css">
        <link rel="stylesheet" href="{{ app.request.basepath }}/resources/css/autocompletejs/autoComplete.custom.css">
    {% endblock %}
    {% block javascripts %}
    {% endblock %}
    <link rel="icon" type="image/png" href="{{ app.request.basepath }}/img/favicon.png" />
</head>
<body>
{% block body %}
    {% block menu %}
        {# A page names itself with the page_title block; without it the frame uses the label of the current navigation entry #}
        {% set pageTitle %}{% block page_title %}{% endblock %}{% endset %}
        {% include 'layout/_app_nav.html.twig' with { pageTitle: pageTitle } %}
    {% endblock %}
    {% block modal %}
        <!-- Modal -->
        <div class="modal fade" id="modalCenter" tabindex="-1" role="dialog" aria-labelledby="modalCenterTitle" aria-hidden="true"
             data-controller="modal-history">
          {# Covers the screen like a page on phones and tablets (see "Dialogs on phones and tablets"
             in styles/components/dialogs.css); a page may override the classes with the block. #}
          <div class="modal-dialog {% block modal_dialog_class %}modal-lg modal-fullscreen-xl-down{% endblock %}" role="document">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="modalCenterTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
                <div id="modal-content-ajax">
                     <div class="modal-body py-5 text-center">
                        <div class="spinner-border text-secondary" role="status" aria-live="polite"></div>
                    </div>
                </div>
            </div>
          </div>
        </div>
    {% endblock %}
    <div class="app-main">
    {% block flashMessage %}
        <div class="container mt-3">            
            {% for type, flashMessages in app.flashes %}
                {% for flashMessage in flashMessages %}
                <div class="row" id="flash-message-container">
                    <div class="col">
                        <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            {{ flashMessage|trans }}
                        </div>
                    </div>
                </div>
                {% endfor %}
            {% endfor %}            
        </div>
    {% endblock %}

    {% block content %}{% endblock %}

    {% block firstSteps %}
        {% if showFirstSteps is defined and showFirstSteps %}
            {% include 'common/first_steps.html.twig' %}
        {% endif %}
    {% endblock %}
    </div>

    {% block bodyjs %}
        
    {% endblock %}

{% endblock %}
</body>
</html>
