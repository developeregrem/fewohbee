{#
 # Form theme of the application: Bootstrap's horizontal layout, labels on the left from sm and
 # above the field below it - the same grid as the forms written by hand
 # (col-sm-4 col-form-label text-sm-end). Look and spacing come from styles/components/forms.css;
 # required fields get their star there.
 #}
{% use "bootstrap_5_horizontal_layout.html.twig" %}

{% block form_label_class -%}
col-sm-4 text-sm-end
{%- endblock form_label_class %}

{% block form_group_class -%}
col-sm
{%- endblock form_group_class %}
