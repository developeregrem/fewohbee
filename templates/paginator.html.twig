{# swipe_nav: true makes the arrows the previous/next targets of a surrounding swipe-nav
   controller, so a sideways swipe pages the list; only where there is a page to go to.
   On phones only the arrows and the position ("3 / 15") show, so the row never wraps
   (pagination-compact in controls.css). #}
{% if pages > 1 %}
    {% set dataAction = pagination_action|default('') %}
    {% set swipeNav = swipe_nav|default(false) %}
    {% set extraClass = pagination_class|default('') %}
    {% set querySeparator = '?' in url ? '&' : '?' %}
    {# the left and right key should not become 0 or higher than allowed #}
    {% if page == 1 %}{% set leftpage = 1 %}{% else %}{% set leftpage = page - 1 %}{% endif %}
    {% if page == pages %}{% set rightpage = pages %}{% else %}{% set rightpage = page + 1 %}{% endif %}

    {# the number of first and last pages to be displayed #}
    {% set extremePagesLimit = 3 %}

    {# the number of pages that are displayed around the active page #}
    {% set nearbyPagesLimit = 2 %}

    <ul id="pagination" class="pagination pagination-compact{% if extraClass %} {{ extraClass }}{% endif %}">
        <li class="page-item{% if page == 1 %} disabled{% endif %}">
            <a class="page-link" data-page="{{ leftpage }}" {% if dataAction %}data-action="{{ dataAction }}"{% endif %}
               {% if swipeNav and page > 1 %}data-swipe-nav-target="previous"{% endif %}
               href="{{ url }}{{ querySeparator }}{{ {'page': leftpage, 'search': search}|url_encode }}" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
            </a>
        </li>
        <li class="page-item page-item-position">
            <span class="page-link">
                <span aria-hidden="true">{{ page }} / {{ pages }}</span>
                <span class="visually-hidden">{{ 'pagination.position'|trans({'%page%': page, '%pages%': pages}) }}</span>
            </span>
        </li>
        {# before #}
        {% if page > 1 %}
            {% for i in range(1, extremePagesLimit) %}
                {% if i < page - nearbyPagesLimit %}
                <li class="page-item">
                    <a class="page-link" data-page="{{ i }}" {% if dataAction %}data-action="{{ dataAction }}"{% endif %} href="{{ url }}{{ querySeparator }}{{ {'page': i, 'search': search}|url_encode }}">{{ i }}</a>
                </li>
                {% endif %}
            {% endfor %}
            {% if extremePagesLimit + 1 < page - nearbyPagesLimit %}
                <li class="page-item">
                    <a class="page-link" data-page="{{ page }}" {% if dataAction %}data-action="{{ dataAction }}"{% endif %} href="{{ url }}{{ querySeparator }}{{ {'page': page, 'search': search}|url_encode }}">...</a>
                </li>
            {% endif %}
            {% for i in range(page-nearbyPagesLimit, page-1) %}
                {% if i > 0 %}
                <li class="page-item">
                    <a class="page-link" data-page="{{ i }}" {% if dataAction %}data-action="{{ dataAction }}"{% endif %} href="{{ url }}{{ querySeparator }}{{ {'page': i, 'search': search}|url_encode }}">{{ i }} </a>
                </li>
                {% endif %}
            {% endfor %}
        {% endif %}

        {# current #}
        <li class="page-item active">
            <a class="page-link" data-page="{{ page }}" {% if dataAction %}data-action="{{ dataAction }}"{% endif %} href="{{ url }}{{ querySeparator }}{{ {'page': page, 'search': search}|url_encode }}">{{ page }}</a>
        </li>

        {# after #}
        {% if page < pages %}
            {% for i in range(page+1, page + nearbyPagesLimit) %}
                {% if i <= pages %}
                <li class="page-item">
                    <a class="page-link" data-page="{{ i }}" {% if dataAction %}data-action="{{ dataAction }}"{% endif %} href="{{ url }}{{ querySeparator }}{{ {'page': i, 'search': search}|url_encode }}">{{ i }}</a>
                </li>
                {% endif %}
            {% endfor %}
            {% if (pages - extremePagesLimit) > (page + nearbyPagesLimit) %}
                <li class="page-item">
                    <a class="page-link" data-page="{{ page }}" {% if dataAction %}data-action="{{ dataAction }}"{% endif %} href="{{ url }}{{ querySeparator }}{{ {'page': page, 'search': search}|url_encode }}">...</a>
                </li>
            {% endif %}
            {% for i in range(pages - extremePagesLimit+1, pages) %}
                {% if i > page + nearbyPagesLimit %}
                <li class="page-item">
                    <a class="page-link" data-page="{{ i }}" {% if dataAction %}data-action="{{ dataAction }}"{% endif %} href="{{ url }}{{ querySeparator }}{{ {'page': i, 'search': search}|url_encode }}">{{ i }}</a>
                </li>
                {% endif %}
            {% endfor %}
        {% endif %}


        <li class="page-item{% if page == pages %} disabled{% endif %}">
            <a class="page-link" data-page="{{ rightpage }}" {% if dataAction %}data-action="{{ dataAction }}"{% endif %}
               {% if swipeNav and page < pages %}data-swipe-nav-target="next"{% endif %}
               href="{{ url }}{{ querySeparator }}{{ {'page': rightpage, 'search': search}|url_encode }}" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
            </a>
        </li>
    </ul>
{% endif %}
