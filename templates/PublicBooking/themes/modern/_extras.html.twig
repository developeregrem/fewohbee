{% if extras is not empty %}
    <div class="fhb-section">
        <h2 class="fhb-section-title">{{ 'online_booking.public.extras_title'|trans }}</h2>
        <div class="fhb-extras">
            {% for extra in extras %}
                {% set extraFieldName = 'extra_' ~ extra.id %}
                {% set isMandatoryExtra = extra.isMandatory|default(false) %}
                {% set isAutoQuantity = extra.autoQuantity|default(false) %}
                {% set selectedQtyVal = selectedExtras[extra.id]|default(isMandatoryExtra ? 1 : 0) %}
                {% set needsQuantity = not isAutoQuantity and extra.calculationType != 'per_person_night' and extra.maxQuantity > 1 %}
                <div class="fhb-extra-row">
                    <div class="fhb-extra-info">
                        <div class="fhb-extra-name">
                            {{ extra.description }}
                            {% if isAutoQuantity and extra.categoryName %}
                                <span class="fhb-extra-badge">{{ extra.categoryName }}</span>
                            {% endif %}
                        </div>
                        <div class="fhb-extra-price">
                            {{ extra.unitPriceFormatted }}&nbsp;{{ currency_symbol }}
                            {% if extra.calculationType == 'per_person_night' %}
                                {{ 'online_booking.public.per_person_night'|trans }}
                            {% elseif extra.calculationType == 'per_room_night' %}
                                {{ 'online_booking.public.per_room_night'|trans }}
                            {% else %}
                                {{ 'online_booking.public.flat_price'|trans }}{% if isAutoQuantity %} {{ 'online_booking.public.per_room_suffix'|trans }}{% endif %}
                            {% endif %}
                            {% if not isAutoQuantity %}
                                <span>(= {{ extra.pricePerUnitFormatted }}&nbsp;{{ currency_symbol }})</span>
                            {% endif %}
                        </div>
                    </div>
                    {% if isMandatoryExtra %}
                        {# Hidden input carries the value even though the visible control is disabled. #}
                        <input type="hidden" name="{{ extraFieldName }}" value="{{ needsQuantity ? selectedQtyVal : 1 }}">
                    {% endif %}
                    {% if needsQuantity %}
                        <div class="fhb-qty">
                            <select class="form-select"
                                    {% if not isMandatoryExtra %}name="{{ extraFieldName }}"{% endif %}
                                    {% if isMandatoryExtra %}disabled{% endif %}
                                    aria-label="{{ extra.description }}"
                                    onwheel="this.blur()">
                                {% if not isMandatoryExtra %}
                                    <option value="0" {% if selectedQtyVal == 0 %}selected{% endif %}>–</option>
                                {% endif %}
                                {% for q in 1..extra.maxQuantity %}
                                    <option value="{{ q }}" {% if selectedQtyVal == q %}selected{% endif %}>{{ q }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% else %}
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="{{ extraFieldName }}"
                                   {% if not isMandatoryExtra %}name="{{ extraFieldName }}"{% endif %}
                                   value="1"
                                   aria-label="{{ extra.description }}"
                                   {% if selectedQtyVal > 0 or isMandatoryExtra %}checked{% endif %}
                                   {% if isMandatoryExtra %}disabled{% endif %}>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
