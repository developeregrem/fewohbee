<h2 class="fhb-section-title">{{ 'online_booking.public.booker_details'|trans }}</h2>

<div class="row g-3">
    <div class="col-12 col-md-3">
        <label class="fhb-label" for="salutation">{{ 'customer.salutation'|trans }}</label>
        <select class="form-select" id="salutation" name="salutation" required>
            <option value="">--</option>
            {# Guests read the salutation in their language; the stored wording is what is sent. #}
            {% for label, salutation in salutation_choices() %}
                <option value="{{ salutation }}" {% if booker.salutation == salutation %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-6 col-md">
        <label class="fhb-label" for="firstname">{{ 'customer.firstname'|trans }}</label>
        <input class="form-control" type="text" id="firstname" name="firstname" autocomplete="given-name" required value="{{ booker.firstname }}">
    </div>
    <div class="col-6 col-md">
        <label class="fhb-label" for="lastname">{{ 'customer.lastname'|trans }}</label>
        <input class="form-control" type="text" id="lastname" name="lastname" autocomplete="family-name" required value="{{ booker.lastname }}">
    </div>

    <div class="col-12 col-md-4">
        <label class="fhb-label" for="email">{{ 'online_booking.public.email'|trans }}</label>
        <input class="form-control" type="email" id="email" name="email" autocomplete="email" required value="{{ booker.email }}">
    </div>
    <div class="col-6 col-md-4">
        <label class="fhb-label" for="phone">{{ 'online_booking.public.phone'|trans }}</label>
        <input class="form-control" type="tel" id="phone" name="phone" autocomplete="tel" value="{{ booker.phone }}">
    </div>
    <div class="col-6 col-md-4">
        <label class="fhb-label" for="company">{{ 'online_booking.public.company'|trans }}</label>
        <input class="form-control" type="text" id="company" name="company" autocomplete="organization" value="{{ booker.company }}">
    </div>

    <div class="col-12 col-md-5">
        <label class="fhb-label" for="address">{{ 'customer.address'|trans }}</label>
        <input class="form-control" type="text" id="address" name="address" autocomplete="street-address" required value="{{ booker.address }}">
    </div>
    <div class="col-4 col-md-2">
        <label class="fhb-label" for="zip">{{ 'customer.zip'|trans }}</label>
        <input class="form-control" type="text" id="zip" name="zip" autocomplete="postal-code" required value="{{ booker.zip }}">
    </div>
    <div class="col-8 col-md-3">
        <label class="fhb-label" for="city">{{ 'customer.city'|trans }}</label>
        <input class="form-control" type="text" id="city" name="city" autocomplete="address-level2" required value="{{ booker.city }}">
    </div>
    <div class="col-12 col-md-2">
        <label class="fhb-label" for="country">{{ 'customer.country'|trans }}</label>
        <select class="form-select" id="country" name="country" autocomplete="country" required>
            {% for key, country in countries %}
                <option value="{{ key }}" {% if booker.country == key %}selected{% endif %}>{{ country }}</option>
            {% endfor %}
        </select>
    </div>

    <div class="col-12">
        <label class="fhb-label" for="comment">{{ 'online_booking.public.comment'|trans }}</label>
        <textarea class="form-control" id="comment" name="comment" rows="3"{% set commentPlaceholder = config|localized('commentPlaceholder') %}{% if commentPlaceholder %} placeholder="{{ commentPlaceholder }}"{% endif %}>{{ booker.comment }}</textarea>
    </div>
</div>
