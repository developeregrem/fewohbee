{% extends 'base.html.twig' %}
{% use "common/delete_popover.html.twig" %}

{% block title %}{{ parent() }} - {{ 'accounting.bank_import.title'|trans }}{% endblock %}

{% block page_title %}{{ 'accounting.bank_import.title'|trans }}{% endblock %}

{% block flashMessage %}
    {% include 'BookingJournal/_flash_messages.html.twig' %}
{% endblock %}

{% block content %}
<div class="container" data-controller="bank-import">
    <twig:PageHeader :title="'accounting.bank_import.title'|trans" :subtitle="'accounting.bank_import.subtitle'|trans"
                     :back="path('journal.overview')" :backLabel="'nav.journal'|trans">
        <twig:IconButton icon="cog" :label="'accounting.bank_import.settings.title'|trans" :href="path('bank_import.settings')"/>
    </twig:PageHeader>

    {% include 'feedback.html.twig' %}

    {# ── Open drafts ─────────────────────────────────────────────── #}
    {% if drafts is not empty %}
    <div class="card data-card mb-4">
        <div class="data-toolbar d-block">
            <h2 class="h6 mb-0">{{ 'accounting.bank_import.drafts.title'|trans }}</h2>
            <p class="text-body-secondary small mb-0 mt-1">{{ 'accounting.bank_import.drafts.retention'|trans({'%days%': constant('App\\Entity\\BankImportDraft::RETENTION_DAYS')}) }}</p>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle data-table data-table-stack">
                <thead>
                    <tr>
                        <th>{{ 'accounting.bank_import.drafts.file'|trans }}</th>
                        <th>{{ 'accounting.bank_import.drafts.account'|trans }}</th>
                        <th>{{ 'accounting.bank_import.drafts.period'|trans }}</th>
                        <th class="text-end">{{ 'accounting.bank_import.drafts.lines'|trans }}</th>
                        <th>{{ 'accounting.bank_import.drafts.created'|trans }}</th>
                        <th class="data-table-actions"><span class="visually-hidden">{{ 'accounting.journal.entry.actions'|trans }}</span></th>
                    </tr>
                </thead>
                <tbody>
                {% for draft in drafts %}
                    {% set state = draft.state %}
                    {% set id = draft.id %}
                    {% set targetUrl = path('bank_import.discard', {'sessionImportId': draft.id}) %}
                    {% set acc = accountsById[state.bankAccountId] ?? null %}
                    <tr>
                        <td>
                            <a href="{{ path('bank_import.preview', {'sessionImportId': draft.id}) }}" class="data-table-link">
                                <i class="fas fa-file-csv text-body-secondary" aria-hidden="true"></i>
                                <span class="data-table-link-text">{{ state.originalFilename }}</span>
                            </a>
                        </td>
                        <td class="cell-meta">
                            {% if acc %}{{ acc.label }}{% else %}<span class="text-danger">{{ 'accounting.bank_import.drafts.account_missing'|trans }}</span>{% endif %}
                        </td>
                        <td class="cell-meta text-nowrap">
                            {%- if state.periodFrom and state.periodTo -%}
                                {{ state.periodFrom|date('d.m.Y') }} – {{ state.periodTo|date('d.m.Y') }}
                            {%- else -%}
                                <span class="cell-wide">—</span>
                            {%- endif -%}
                            <span class="cell-narrow"> · {{ 'accounting.bank_import.drafts.lines'|trans }}: {{ state.lines|length }}</span>
                        </td>
                        <td class="cell-wide text-end">{{ state.lines|length }}</td>
                        <td class="cell-meta text-body-secondary">{{ draft.createdAt|date('d.m.Y H:i') }}</td>
                        <td class="cell-actions data-table-actions text-end">
                            <a href="{{ path('bank_import.preview', {'sessionImportId': draft.id}) }}" class="btn btn-sm btn-secondary">
                                {{ 'accounting.bank_import.drafts.open'|trans }}
                            </a>
                            <button type="button" class="btn btn-icon text-danger"
                                    title="{{ 'accounting.bank_import.drafts.discard'|trans }}"
                                    aria-label="{{ 'accounting.bank_import.drafts.discard'|trans }}"
                                    data-popover="delete"
                                    data-bs-content='{{ block('deletePopoverContent') }}'>
                                <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {# ── Upload form ─────────────────────────────────────────────── #}
    <div class="card">
        <div class="card-header">
            <h2 class="h6 mb-0"><i class="fas fa-upload me-1" aria-hidden="true"></i> {{ 'accounting.bank_import.upload.title'|trans }}</h2>
        </div>
        <div class="card-body">
            {{ form_start(uploadForm, {'attr': {'enctype': 'multipart/form-data'}}) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(uploadForm.bankAccount) }}</div>
                    <div class="col-md-6">{{ form_row(uploadForm.format) }}</div>
                </div>
                {{ form_row(uploadForm.file) }}
                <div class="d-grid d-sm-flex justify-content-sm-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-upload me-1" aria-hidden="true"></i> {{ 'accounting.bank_import.upload.submit'|trans }}
                    </button>
                </div>
            {{ form_end(uploadForm) }}
        </div>
    </div>
</div>
{% endblock %}
