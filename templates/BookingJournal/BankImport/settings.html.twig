{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }} - {{ 'accounting.bank_import.settings.title'|trans }}
{% endblock %}

{% block flashMessage %}
    {% include 'BookingJournal/_flash_messages.html.twig' %}
{% endblock %}

{% block content %}
{% set activeTab = activeTab|default('tab-rules') %}
<div class="container"
     data-controller="bank-import-profiles bank-import tab-persistence"
     data-bank-import-profiles-form-load-failed-value="{{ 'accounting.bank_import.profile.form_load_failed'|trans|e('html_attr') }}">
    <div class="row mb-2">
        <div class="col">
            <ul class="pagination me-auto">
                <li class="page-item">
                    <a class="page-link" href="{{ path('bank_import.index') }}">&larr; {{ 'button.back'|trans }}</a>
                </li>
            </ul>
        </div>
    </div>

    <div class="row justify-content-between align-items-center mb-3">
        <div class="col">
            <h4 class="mb-0">{{ 'accounting.bank_import.settings.title'|trans }}</h4>
            <p class="text-muted small mb-0">{{ 'accounting.bank_import.settings.subtitle'|trans }}</p>
        </div>
    </div>

    {% include 'feedback.html.twig' %}

    {# ── Tab navigation ────────────────────────────────────────── #}
    <ul class="nav nav-tabs mb-3" role="tablist">
        {% for tab in [
            {'id': 'tab-rules', 'label': 'accounting.bank_import.rules.title'},
            {'id': 'tab-profiles', 'label': 'accounting.bank_import.profile.title'},
            {'id': 'tab-invoice-matching', 'label': 'accounting.settings.invoice_number_patterns.title'},
        ] %}
            <li class="nav-item" role="presentation">
                <button class="nav-link{% if activeTab == tab.id %} active{% endif %}" type="button" role="tab"
                        data-bs-toggle="tab" data-bs-target="#{{ tab.id }}">
                    {{ tab.label|trans }}
                </button>
            </li>
        {% endfor %}
    </ul>

    <div class="tab-content">
        {# ── Tab: Regeln ──────────────────────────────────────── #}
        <div class="tab-pane fade{% if activeTab == 'tab-rules' %} show active{% endif %}" id="tab-rules" role="tabpanel">
            {% include 'BookingJournal/BankImport/_rules_table.html.twig' %}
        </div>

        {# ── Tab: CSV-Profile ─────────────────────────────────── #}
        <div class="tab-pane fade{% if activeTab == 'tab-profiles' %} show active{% endif %}" id="tab-profiles" role="tabpanel">
            {% include 'BookingJournal/BankImport/_profiles_table.html.twig' %}
        </div>

        {# ── Tab: Rechnungsnummern erkennen ───────────────────── #}
        <div class="tab-pane fade{% if activeTab == 'tab-invoice-matching' %} show active{% endif %}" id="tab-invoice-matching" role="tabpanel">
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center">
                    <h5 class="mb-0">{{ 'accounting.settings.invoice_number_patterns.title'|trans }}</h5>
                    <span class="ms-2 text-muted" data-bs-toggle="tooltip" data-bs-html="true"
                          title="{{ 'accounting.settings.invoice_number_patterns.help'|trans }}">
                        <i class="fas fa-circle-question"></i>
                    </span>
                </div>
                <div class="card-body">
                    <p class="form-text mb-3">{{ 'accounting.settings.invoice_number_patterns.intro'|trans }}</p>

                    {% if invoiceNumberRanges is empty %}
                        <div class="alert alert-warning mb-0">
                            {{ 'accounting.settings.invoice_number_patterns.none'|trans }}
                            {% if recentInvoiceNumbers is not empty %}
                                {# The numbers issued so far show the format in use better than
                                   any generic example — helpful when writing the pattern. #}
                                <div class="mt-2">
                                    {{ 'accounting.settings.invoice_number_patterns.recent'|trans }}
                                    {% for number in recentInvoiceNumbers %}
                                        <code>{{ number }}</code>{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>{{ 'accounting.settings.invoice_number_patterns.scope'|trans }}</th>
                                        <th>{{ 'accounting.settings.invoice_number_patterns.pattern'|trans }}</th>
                                        <th>{{ 'accounting.settings.invoice_number_patterns.example'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for range in invoiceNumberRanges %}
                                        <tr>
                                            <td>
                                                {% if range.isGlobal %}
                                                    <span class="badge bg-secondary">{{ 'accounting.settings.invoice_number_patterns.global'|trans }}</span>
                                                {% else %}
                                                    {{ range.scope }}
                                                {% endif %}
                                            </td>
                                            <td><code>{{ range.pattern }}</code></td>
                                            <td><code>{{ range.example }}</code></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    <div class="mt-3">
                        <a href="{{ path('settings.general.index') }}" class="btn btn-outline-secondary btn-sm">
                            {{ 'accounting.settings.invoice_number_patterns.link_global'|trans }}
                        </a>
                        <a href="{{ path('objects.overview') }}" class="btn btn-outline-secondary btn-sm">
                            {{ 'accounting.settings.invoice_number_patterns.link_branch'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
