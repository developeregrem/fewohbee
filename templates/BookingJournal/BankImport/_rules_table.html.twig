{% import 'BookingJournal/BankImport/_rule_summary.html.twig' as ruleUi %}
{% use "common/delete_popover.html.twig" %}

<div class="card data-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle data-table">
            <thead>
                <tr>
                    <th style="width: 4rem">{{ 'accounting.bank_import.rules.col.priority'|trans }}</th>
                    <th>{{ 'accounting.bank_import.rules.col.name'|trans }}</th>
                    <th>{{ 'accounting.bank_import.rules.col.scope'|trans }}</th>
                    <th>{{ 'accounting.bank_import.rules.col.conditions'|trans }}</th>
                    <th>{{ 'accounting.bank_import.rules.col.action'|trans }}</th>
                    <th class="text-end" style="width: 11rem">{{ 'accounting.bank_import.rules.col.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% for rule in rules %}
                {% set id = rule.id %}
                {% set targetUrl = path('bank_import.rules.delete', {'id': rule.id}) %}
                <tr class="{% if not rule.isEnabled %}text-muted{% endif %}">
                    <td class="text-center"><span class="badge text-secondary-emphasis bg-secondary-subtle">{{ rule.priority }}</span></td>
                    <td>
                        <strong>{{ rule.name }}</strong>
                        {% if rule.description %}
                            <div class="text-muted small">{{ rule.description }}</div>
                        {% endif %}
                    </td>
                    <td class="small">
                        {% if rule.bankAccount %}
                            <code>{{ rule.bankAccount.label }}</code>
                        {% else %}
                            <span class="text-muted fst-italic">{{ 'accounting.bank_import.rules.scope.global'|trans }}</span>
                        {% endif %}
                    </td>
                    <td>{{ ruleUi.conditionsList(rule.conditions) }}</td>
                    <td>{{ ruleUi.actionSummary(rule.action, accountsById, taxRatesById) }}</td>
                    <td class="data-table-actions text-end">
                        <form method="post" action="{{ path('bank_import.rules.toggle', {'id': rule.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ rule.id) }}">
                            {% set toggleLabel = (rule.isEnabled ? 'accounting.bank_import.rules.action.disable' : 'accounting.bank_import.rules.action.enable')|trans %}
                            <button type="submit"
                                    class="btn btn-icon{% if rule.isEnabled %} text-success-emphasis{% endif %}"
                                    title="{{ toggleLabel }}" aria-label="{{ toggleLabel }}" aria-pressed="{{ rule.isEnabled ? 'true' : 'false' }}">
                                <i class="fas fa-lg {% if rule.isEnabled %}fa-toggle-on{% else %}fa-toggle-off{% endif %}" aria-hidden="true"></i>
                            </button>
                        </form>
                        <twig:IconButton icon="pen" :label="'button.edit'|trans" :href="path('bank_import.rules.edit', {'id': rule.id})"/>
                        <button type="button" class="btn btn-icon text-danger"
                                title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}"
                                data-popover="delete"
                                data-bs-content='{{ block('deletePopoverContent') }}'>
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                        </button>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        {{ 'accounting.bank_import.rules.empty'|trans }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<p class="text-muted small mt-3 mb-0">
    <i class="fas fa-info-circle me-1"></i>
    {{ 'accounting.bank_import.rules.create_hint'|trans }}
</p>
