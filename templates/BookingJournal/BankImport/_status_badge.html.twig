{# Renders the leading status badge for one statement line. bank_import_preview_controller.js
   (_refreshStatusBadge) sets the same classes when the status changes; the filter chips count in
   these colours. #}
{% if line.isDuplicate and line.forceImportDuplicate|default(false) %}
    <span class="badge text-warning-emphasis bg-warning-subtle" data-bs-toggle="tooltip"
          title="{{ 'accounting.bank_import.preview.duplicate_forced.help'|trans }}">
        <i class="fas fa-clone"></i>
    </span>
{% elseif line.isDuplicate %}
    <span class="badge text-info-emphasis bg-info-subtle" data-bs-toggle="tooltip"
          title="{{ 'accounting.bank_import.preview.duplicate.help'|trans }}">
        <i class="fas fa-clone"></i>
    </span>
{% elseif line.isIgnored %}
    <span class="badge text-secondary-emphasis bg-secondary-subtle" data-bs-toggle="tooltip"
          title="{{ 'accounting.bank_import.preview.ignored.help'|trans }}">
        <i class="fas fa-eye-slash"></i>
    </span>
{% elseif line.status == 'ready' %}
    <span class="badge text-success-emphasis bg-success-subtle" data-bs-toggle="tooltip"
          title="{{ 'accounting.bank_import.preview.ready.help'|trans }}">
        <i class="fas fa-check"></i>
    </span>
{% else %}
    <span class="badge text-warning-emphasis bg-warning-subtle" data-bs-toggle="tooltip"
          title="{{ 'accounting.bank_import.preview.pending.help'|trans }}">
        <i class="fas fa-circle-notch"></i>
    </span>
{% endif %}
