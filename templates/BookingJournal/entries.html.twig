{% extends 'base.html.twig' %}
{% use "common/delete_popover.html.twig" %}

{% block title %}
    {{ parent() }} - {{ 'nav.journal'|trans }} - {{ getLocalizedMonth(batch.month, 'MMMM', app.request.locale) }} {{ batch.year }}
{% endblock %}

{% block flashMessage %}
    {% include 'BookingJournal/_flash_messages.html.twig' %}
{% endblock %}

{% block page_title %}{{ 'nav.journal'|trans }}{% endblock %}

{% block content %}
{% set monthName = getLocalizedMonth(batch.month, 'MMMM', app.request.locale) ~ ' ' ~ batch.year %}
{# The columns follow the view: all entries with debit and credit, or the bank or cash book with
   incomes, expenses and the counter account (the cash book has no tax rate) #}
{% set book = filter in ['bankbook', 'cashbook'] ? filter : null %}
{% set showTax = filter != 'cashbook' %}
<div class="container fab-add-clearance" data-controller="booking-journal swipe-nav">
    <twig:PageHeader :title="'nav.journal'|trans"
                     :back="path('journal.overview', {'year': batch.year})"
                     :backLabel="'accounting.journal.batch.all_months'|trans">
        <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-download me-1" aria-hidden="true"></i>{{ 'accounting.journal.export'|trans }}
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item"
                       href="{{ path('journal.batch.export.datev', {'id': batch.id}) }}"
                       data-turbo="false"
                       data-turbo-prefetch="false">
                        <i class="fas fa-file-csv me-1" aria-hidden="true"></i>{{ 'accounting.journal.export.datev'|trans }}
                    </a>
                </li>
                {% for tmpl in pdfTemplates %}
                    <li>
                        <a class="dropdown-item" href="{{ path('journal.batch.export.pdf', {'id': batch.id, 'templateId': tmpl.id}) }}" target="_blank">
                            <i class="fas fa-file-pdf me-1" aria-hidden="true"></i>{{ tmpl.name }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
        {% if batch.closed and is_granted('ROLE_ADMIN') %}
            <form method="post" action="{{ path('journal.batch.toggle_status', {'id': batch.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('batch_toggle_' ~ batch.id) }}">
                <button type="submit" class="btn btn-secondary" title="{{ 'accounting.journal.batch.reopen'|trans }}">
                    <i class="fas fa-lock-open" aria-hidden="true"></i><span class="d-none d-sm-inline ms-1">{{ 'accounting.journal.batch.reopen'|trans }}</span>
                </button>
            </form>
        {% elseif not batch.closed %}
            <form method="post" action="{{ path('journal.batch.toggle_status', {'id': batch.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('batch_toggle_' ~ batch.id) }}">
                <button type="submit" class="btn btn-secondary" title="{{ 'accounting.journal.batch.close'|trans }}">
                    <i class="fas fa-lock" aria-hidden="true"></i><span class="d-none d-sm-inline ms-1">{{ 'accounting.journal.batch.close'|trans }}</span>
                </button>
            </form>
            <twig:AddButton :label="'accounting.journal.entry.add'|trans"
                            data-action="click->booking-journal#openOffcanvas"
                            data-url="{{ path('journal.entry.new', {'id': batch.id, 'filter': filter, 'page': page}) }}"
                            data-offcanvas-title="{{ 'accounting.journal.entry.add'|trans }}"/>
        {% endif %}
        <twig:IconButton icon="cog" :label="'accounting.settings.title'|trans" :href="path('journal.settings.index')"/>
    </twig:PageHeader>

    {# Arrows and swipes page through the entries first and only then change the month; back
       from the first page lands on the last page of the previous month, so the entries read on
       without a gap #}
    {% if page < pages %}
        {% set nextUrl = path('journal.batch.entries', {'id': batch.id, 'filter': filter, 'page': page + 1, 'search': search}) %}
        {% set nextLabel = 'accounting.journal.batch.next_page'|trans({'%page%': page + 1, '%pages%': pages}) %}
    {% elseif nextBatch %}
        {% set nextUrl = path('journal.batch.entries', {'id': nextBatch.id, 'filter': filter}) %}
        {% set nextLabel = 'accounting.journal.batch.next_month'|trans({'%month%': getLocalizedMonth(nextBatch.month, 'MMMM', app.request.locale) ~ ' ' ~ nextBatch.year}) %}
    {% endif %}
    {% if page > 1 %}
        {% set previousUrl = path('journal.batch.entries', {'id': batch.id, 'filter': filter, 'page': page - 1, 'search': search}) %}
        {% set previousLabel = 'accounting.journal.batch.previous_page'|trans({'%page%': page - 1, '%pages%': pages}) %}
    {% elseif previousBatch %}
        {% set previousUrl = path('journal.batch.entries', {'id': previousBatch.id, 'filter': filter, 'page': previousBatchLastPage}) %}
        {% set previousLabel = 'accounting.journal.batch.previous_month'|trans({'%month%': getLocalizedMonth(previousBatch.month, 'MMMM', app.request.locale) ~ ' ' ~ previousBatch.year}) %}
    {% endif %}
    <div class="page-toolbar mb-3">
        <twig:Pager links
                    :previousHref="previousUrl|default(null)" :previousLabel="previousLabel|default('')"
                    :nextHref="nextUrl|default(null)" :nextLabel="nextLabel|default('')">
            <span class="input-group-text">
                {{- monthName }}{% if pages > 1 %}<span class="fw-normal text-body-secondary ms-1">· {{ page }}/{{ pages }}</span>{% endif -%}
            </span>
        </twig:Pager>
        {% if batch.closed %}
            <span class="badge text-secondary-emphasis bg-secondary-subtle"><i class="fas fa-lock me-1" aria-hidden="true"></i>{{ 'accounting.journal.batch.closed'|trans }}</span>
        {% endif %}
    </div>

    {# Card markup written out: block() and the imported macros are not reachable inside a component #}
    <div class="card data-card">
        {# Which entries the list shows; for the bank or cash book also its opening and closing balance #}
        <div class="data-toolbar">
            <select class="form-select journal-view" aria-label="{{ 'accounting.journal.filter.label'|trans }}"
                    data-action="change->booking-journal#navigateToFilter"
                    data-url="{{ path('journal.batch.entries', {'id': batch.id}) }}">
                <option value="all"{% if filter == 'all' %} selected{% endif %}>{{ 'accounting.journal.filter.all'|trans }}</option>
                <option value="cashbook"{% if filter == 'cashbook' %} selected{% endif %}>{{ 'accounting.journal.filter.cashbook'|trans }}</option>
                <option value="bankbook"{% if filter == 'bankbook' %} selected{% endif %}>{{ 'accounting.journal.filter.bankbook'|trans }}</option>
            </select>
            {% if book %}
                <div class="journal-balances">
                    {% if book == 'bankbook' %}
                        <span>{{ 'accounting.journal.bankbook.start'|trans }}: <strong>{{ bankOpeningBalance|number_format(2, ',', '.') }} &euro;</strong></span>
                        <span>{{ 'accounting.journal.bankbook.end'|trans }}: <strong>{{ bankClosingBalance|number_format(2, ',', '.') }} &euro;</strong></span>
                    {% else %}
                        <span>{{ 'accounting.journal.cashbook.start'|trans }}: <strong>{{ batch.cashStart|number_format(2, ',', '.') }} &euro;</strong></span>
                        <span>{{ 'accounting.journal.cashbook.end'|trans }}: <strong>{{ batch.cashEnd|number_format(2, ',', '.') }} &euro;</strong></span>
                    {% endif %}
                </div>
            {% endif %}
        </div>
        {% if entries|length == 0 %}
            <twig:EmptyState icon="book-open" :title="'accounting.journal.entry.empty'|trans"/>
        {% else %}
        <div class="table-responsive">
            {# The whole row opens the entry (row-link), like the other lists; in a closed month there is
               nothing to edit and no row opens #}
            {# Five columns rather than nine, so the table fits from a tablet held upright: the document
               number beneath the date, debit and credit in one cell, invoice, tax rate and remark as
               details. Phones stack the rows like every list (data-table-stack). #}
            <table class="table table-hover data-table data-table-stack journal-entries" data-controller="row-link" data-action="click->row-link#open">
                <thead>
                <tr>
                    <th>{{ 'accounting.journal.entry.date'|trans }}</th>
                    {% if book %}
                        <th class="text-end">{{ ('accounting.journal.' ~ book ~ '.incomes')|trans }}</th>
                        <th class="text-end">{{ ('accounting.journal.' ~ book ~ '.expenses')|trans }}</th>
                        <th class="journal-account">{{ ('accounting.journal.' ~ book ~ '.counter_account')|trans }}</th>
                    {% else %}
                        <th class="text-end">{{ 'accounting.journal.entry.amount'|trans }}</th>
                        <th class="journal-account">{{ 'accounting.journal.entry.accounts'|trans }}</th>
                    {% endif %}
                    <th>{{ 'accounting.journal.entry.details'|trans }}</th>
                    <th class="data-table-actions"><span class="visually-hidden">{{ 'accounting.journal.entry.actions'|trans }}</span></th>
                </tr>
                </thead>
                <tbody>
                {% for entry in entries %}
                    <tr>
                        <td class="cell-meta text-nowrap">
                            {%- if batch.closed -%}
                                {{ entry.date|date('d.m.Y') }}
                            {%- else -%}
                                <a href="#" class="data-table-link" data-row-link-target="link"
                                   data-action="click->booking-journal#openOffcanvas"
                                   data-url="{{ path('journal.entry.edit', {'id': entry.id, 'filter': filter, 'page': page}) }}"
                                   data-offcanvas-title="{{ 'accounting.journal.entry.edit'|trans }}"
                                   title="{{ 'button.edit'|trans }}">{{ entry.date|date('d.m.Y') }}</a>
                            {%- endif -%}
                            <span class="journal-doc">{{ 'accounting.journal.entry.doc_number'|trans }} {{ '%04d'|format(entry.documentNumber) }}</span>
                        </td>
                        {% if book %}
                            {% set bookAccount = book == 'bankbook' ? 'bankAccount' : 'cashAccount' %}
                            {% set isIncome = entry.debitAccount and attribute(entry.debitAccount, bookAccount) %}
                            {% set isExpense = entry.creditAccount and attribute(entry.creditAccount, bookAccount) %}
                            <td class="text-end text-nowrap journal-amount">{% if isIncome %}<span class="cell-narrow">+ </span>{{ entry.amountFloat|abs|number_format(2, ',', '.') }}{% endif %}</td>
                            <td class="text-end text-nowrap journal-amount">{% if isExpense %}<span class="cell-narrow">− </span>{{ entry.amountFloat|abs|number_format(2, ',', '.') }}{% endif %}</td>
                            <td class="cell-meta journal-account">
                                <span class="cell-narrow">{{ ('accounting.journal.' ~ book ~ '.counter_account')|trans }} </span>
                                {%- if isIncome and entry.creditAccount -%}
                                    {{ entry.creditAccount.label }}
                                {%- elseif isExpense and entry.debitAccount -%}
                                    {{ entry.debitAccount.label }}
                                {%- else -%}
                                    {{ entry.counterAccountLegacy ?? '-' }}
                                {%- endif -%}
                            </td>
                        {% else %}
                            <td class="text-end text-nowrap journal-amount">{{ entry.amount|number_format(2, ',', '.') }}</td>
                            <td class="cell-meta journal-account">
                                <div><span class="journal-account-side">{{ 'accounting.journal.entry.debit'|trans }}</span> {{ entry.debitAccount ? entry.debitAccount.label : (entry.counterAccountLegacy ?? '-') }}</div>
                                <div><span class="journal-account-side">{{ 'accounting.journal.entry.credit'|trans }}</span> {{ entry.creditAccount ? entry.creditAccount.label : '-' }}</div>
                            </td>
                        {% endif %}
                        {# Invoice and tax rate on one line, the remark beneath; nothing to show leaves the
                           cell empty, so a phone leaves it out. Numbers stay whole, the label may wrap. #}
                        {% set showInvoice = entry.invoiceNumber and not entry.missingDocumentNumber %}
                        {% set showRate = showTax and entry.taxRate %}
                        <td class="cell-meta journal-details">
                            {%- if entry.missingDocumentNumber -%}
                                <span class="badge text-warning-emphasis bg-warning-subtle" title="{{ 'accounting.journal.entry.missing_document_hint'|trans }}">{{ 'accounting.journal.entry.missing_document'|trans }}</span>
                            {%- endif -%}
                            {%- if showInvoice or showRate -%}
                                <div class="journal-facts">
                                    {%- if showInvoice %}{{ 'accounting.journal.entry.invoice'|trans }} <span class="text-nowrap">{{ entry.invoiceNumber }}</span>{% endif -%}
                                    {%- if showInvoice and showRate %} · {% endif -%}
                                    {%- if showRate %}<span class="text-nowrap">{{ entry.taxRate.name }}</span>{% endif -%}
                                </div>
                            {%- endif -%}
                            {%- if entry.remark is not empty %}<div class="journal-remark">{{ entry.remark }}</div>{% endif -%}
                        </td>
                        <td class="cell-actions data-table-actions text-end">
                            {% if not batch.closed %}
                                <twig:IconButton icon="copy" :label="'accounting.journal.entry.duplicate'|trans"
                                                 data-action="click->booking-journal#openOffcanvas"
                                                 data-url="{{ path('journal.entry.duplicate', {'id': entry.id, 'filter': filter, 'page': page}) }}"
                                                 data-offcanvas-title="{{ 'accounting.journal.entry.duplicate'|trans }}"/>
                                {% set id = entry.id %}
                                {% set targetUrl = path('journal.entry.delete', {'id': entry.id}) %}
                                <button type="button" class="btn btn-icon text-danger"
                                        title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}"
                                        data-popover="delete"
                                        data-title="{{ 'accounting.journal.entry.delete_ask'|trans }}"
                                        data-bs-content='{{ block('deletePopoverContent') }}'>
                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
        {# The count of the whole month (within the chosen book and search), as in the other lists #}
        <div class="data-footer">
            <span>{{ 'accounting.journal.batch.entries.count'|trans({'%count%': entries|length}) }}</span>
            {% include 'paginator.html.twig' with { 'url': path('journal.batch.entries', {'id': batch.id, 'filter': filter}), 'search': search } %}
        </div>
    </div>

    {# ── Offcanvas ─────────────────────────────────────── #}
    <div class="offcanvas offcanvas-end offcanvas-form-columns" tabindex="-1" id="journalOffcanvas"
         data-booking-journal-target="offcanvas">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" data-booking-journal-target="offcanvasTitle"></h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body" data-booking-journal-target="offcanvasBody">
        </div>
    </div>
</div>
{% endblock %}
