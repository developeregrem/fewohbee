{# The months of a year in the journal overview; reloaded by booking_journal_controller.js when
   the year or the page changes. On phones a month is a block: name, cash balance, status. #}
{% if batches|length > 0 %}
    <div class="table-responsive">
        <table class="table table-hover align-middle data-table data-table-stack" data-controller="row-link" data-action="click->row-link#open">
            <thead>
            <tr>
                <th>{{ 'accounting.journal.batch.month'|trans }}</th>
                <th class="text-end">{{ 'accounting.journal.cashbook.start'|trans }}</th>
                <th class="text-end">{{ 'accounting.journal.cashbook.end'|trans }}</th>
                <th>{{ 'accounting.journal.batch.status'|trans }}</th>
                <th class="text-end">{{ 'accounting.journal.batch.entries_count'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for batch in batches %}
                {% set count = batch.entries|length %}
                <tr>
                    <td>
                        <a href="{{ path('journal.batch.entries', {'id': batch.id}) }}" class="data-table-link" data-row-link-target="link">
                            <span class="data-table-link-text">{{ getLocalizedMonth(batch.month, 'MMMM', app.request.locale) }} {{ batch.year }}</span>
                        </a>
                    </td>
                    <td class="cell-meta text-end text-nowrap">
                        <span class="cell-narrow">{{ 'accounting.journal.batch.cash'|trans }} </span>
                        {{- batch.cashStart|number_format(2, ',', '.') -}}
                        <span class="cell-narrow"> → {{ batch.cashEnd|number_format(2, ',', '.') }}</span>
                    </td>
                    <td class="cell-wide text-end text-nowrap">{{ batch.cashEnd|number_format(2, ',', '.') }}</td>
                    <td class="cell-meta">
                        <span class="d-inline-flex flex-wrap align-items-center gap-1">
                            {% if batch.closed %}
                                <span class="badge text-secondary-emphasis bg-secondary-subtle"><i class="fas fa-lock me-1" aria-hidden="true"></i>{{ 'accounting.journal.batch.closed'|trans }}</span>
                            {% endif %}
                            {% if batch.exported %}
                                <span class="badge text-success-emphasis bg-success-subtle"><i class="fas fa-check me-1" aria-hidden="true"></i>{{ 'accounting.journal.batch.exported'|trans }}</span>
                            {% endif %}
                            {% if not batch.closed and not batch.exported %}
                                <span class="badge text-primary-emphasis bg-primary-subtle">{{ 'accounting.journal.batch.open'|trans }}</span>
                            {% endif %}
                            <span class="cell-narrow">· {{ 'accounting.journal.batch.entries.count'|trans({'%count%': count}) }}</span>
                        </span>
                    </td>
                    <td class="cell-wide text-end">{{ count }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if pages > 1 %}
        <div class="data-footer">
            <span></span>
            {% include 'paginator.html.twig' with { 'url': path('journal.batches', {'year': year}), 'search': '', 'pagination_action': 'click->booking-journal#paginateBatchesAction' } %}
        </div>
    {% endif %}
{% else %}
    <twig:EmptyState icon="book" :title="'accounting.journal.batch.empty'|trans">
        {{- 'accounting.journal.batch.empty.hint'|trans -}}
    </twig:EmptyState>
{% endif %}
