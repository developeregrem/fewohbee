{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }} - {{ 'accounting.receipt_proposal.title'|trans }}
{% endblock %}

{% block content %}
<div class="container">
    <div class="row mb-2">
        <div class="col">
            <ul class="pagination me-auto">
                <li class="page-item">
                    <a class="page-link" href="{{ path('journal.receipts.index') }}">&larr; {{ 'button.back'|trans }}</a>
                </li>
            </ul>
        </div>
    </div>

    <h4>{{ proposal.supplier }}, {{ proposal.receiptDate|date('d.m.Y') }}, {{ proposal.total|number_format(2, ',', '.') }}</h4>
    <p class="text-muted">
        {{ proposal.status.labelKey|trans }}
        {% if proposal.decidedAt %}– {{ proposal.decidedAt|date('d.m.Y H:i') }}{% endif %}
        {% if proposal.decidedBy %}– {{ proposal.decidedBy.firstname }} {{ proposal.decidedBy.lastname }}{% endif %}
    </p>

    {% if entries is not empty %}
    <div class="card">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>{{ 'accounting.journal.entry.date'|trans }}</th>
                        <th>{{ 'accounting.journal.entry.debit'|trans }}</th>
                        <th>{{ 'accounting.journal.entry.credit'|trans }}</th>
                        <th class="text-end">{{ 'accounting.journal.entry.amount'|trans }}</th>
                        <th>{{ 'accounting.journal.entry.tax_rate'|trans }}</th>
                        <th>{{ 'accounting.journal.entry.invoice'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for entry in entries %}
                    <tr>
                        <td>{{ entry.date|date('d.m.Y') }}</td>
                        <td>{{ entry.debitAccount ? entry.debitAccount.label }}</td>
                        <td>{{ entry.creditAccount ? entry.creditAccount.label }}</td>
                        <td class="text-end">{{ entry.amount|number_format(2, ',', '.') }}</td>
                        <td>{{ entry.taxRate ? entry.taxRate.label }}</td>
                        <td>{{ entry.invoiceNumber }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
