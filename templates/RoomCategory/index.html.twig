{% extends 'base.html.twig' %}
{% use "common/delete_popover.html.twig" %}

{% block title %}
    {{ parent() }} -  {{ 'category.title'|trans }}
{% endblock %}

{% block description %}
    {{ parent() }} -  {{ 'category.description'|trans }}
{% endblock %}

{% block page_title %}{{ 'nav.category'|trans }}{% endblock %}

{% block content %}
<div class="container fab-add-clearance" data-controller="settings">
    <twig:PageHeader :title="'nav.category'|trans" :back="path('settings.overview')" :backLabel="'nav.settings'|trans">
        <twig:AddButton :label="'nav.category.add'|trans"
                        data-action="click->settings#openModalAction"
                        data-url="{{ path('room_category_new') }}"
                        data-title="{{ 'nav.category.add'|trans }}"
                        data-modal-size="lg"
                        data-bs-toggle="modal" data-bs-target="#modalCenter"/>
    </twig:PageHeader>

    {# Card markup written out: the delete popover's block is not reachable inside a component #}
    <div class="card data-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle data-table data-table-stack" data-controller="row-link" data-action="click->row-link#open">
                <thead>
                <tr>
                    <th>{{ 'category.name'|trans }}</th>
                    <th>{{ 'category.acronym'|trans }}</th>
                    <th class="text-end">{{ 'nav.appartment'|trans }}</th>
                    <th class="data-table-actions"><span class="visually-hidden">{{ 'category.action'|trans }}</span></th>
                </tr>
                </thead>
                <tbody>
                {% for category in room_categories %}
                    {% set rooms = category.apartments|length %}
                    <tr>
                        <td>
                            <a href="#" class="data-table-link" data-row-link-target="link"
                               data-action="click->settings#openModalAction"
                               data-url="{{ path('room_category_edit', {'id': category.id}) }}"
                               data-title="{{ 'category.edit'|trans }}"
                               data-modal-size="lg"
                               data-bs-toggle="modal" data-bs-target="#modalCenter">
                                <span class="data-table-link-text">{{ category.name }}</span>
                            </a>
                            {% if category.isEventSpace %}
                                <span class="badge text-secondary-emphasis bg-secondary-subtle ms-1 align-middle">
                                    <i class="fa-solid fa-people-roof" aria-hidden="true"></i> {{ 'category.kind.event_space'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="cell-meta">{{ category.acronym }}</td>
                        <td class="cell-meta text-end">
                            <span class="cell-wide">{{ rooms }}</span>
                            <span class="cell-narrow">{{ 'category.rooms'|trans({'%count%': rooms}) }}</span>
                        </td>
                        <td class="cell-actions data-table-actions text-end">
                            {% set id = category.id %}
                            {% set targetUrl = path('room_category_delete', {'id': category.id}) %}
                            <button type="button" class="btn btn-icon text-danger"
                                    title="{{ 'button.delete'|trans }}" aria-label="{{ 'button.delete'|trans }}"
                                    data-popover="delete"
                                    data-title="{{ 'category.delete.ask'|trans }}"
                                    data-bs-content='{{ block('deletePopoverContent') }}'>
                                <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="data-footer">
            <span>{{ 'category.list.count'|trans({'%count%': room_categories|length}) }}</span>
        </div>
    </div>
</div>
{% endblock %}
