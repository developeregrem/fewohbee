<fieldset id="entry-form-fieldset-{{ origin.id }}" {% if origin.id != "new" %} disabled {% endif %}>
    <div class="row">
        <label for="name-{{ origin.id }}" class="col-sm-4 col-form-label">{{ 'reservationorigin.name'|trans }}
            *</label>

        <div class="col-sm-8">
            <input type="text" class="form-control" name="name-{{ origin.id }}"
                   value="{{ origin.name }}" required>
        </div>
    </div>
    <div class="row mt-3">
        <label for="color-{{ origin.id }}" class="col-sm-4 col-form-label">{{ 'reservationorigin.color'|trans }}</label>

        <div class="col-sm-8">
            <input type="color" class="form-control form-control-color" name="color-{{ origin.id }}"
                   id="color-{{ origin.id }}" value="{{ origin.color ?? '#6c757d' }}"
                   aria-describedby="color-help-{{ origin.id }}">
            <div class="form-check mt-2">
                <input type="checkbox" class="form-check-input" name="color-enabled-{{ origin.id }}"
                       id="color-enabled-{{ origin.id }}" value="1"{{ origin.color ? ' checked' : '' }}>
                <label class="form-check-label" for="color-enabled-{{ origin.id }}">
                    {{ 'reservationorigin.color.enable'|trans }}
                </label>
            </div>
            <div class="form-text" id="color-help-{{ origin.id }}">{{ 'reservationorigin.color.help'|trans }}</div>
        </div>
    </div>
    {% set hasSurcharge = origin.commissionPercent is not null or origin.paymentFeePercent is not null %}
    <div class="row mt-3">
        <div class="col-sm-8 offset-sm-4">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="surcharge-enabled-{{ origin.id }}"
                       name="surcharge-enabled-{{ origin.id }}" value="1"{% if hasSurcharge %} checked{% endif %}
                       data-action="change->settings#toggleFieldsAction"
                       data-target-selector="#surcharge-fields-{{ origin.id }}">
                <label class="form-check-label" for="surcharge-enabled-{{ origin.id }}">
                    {{ 'reservationorigin.guest_surcharge_enabled'|trans }}
                </label>
            </div>
        </div>
    </div>
    <div id="surcharge-fields-{{ origin.id }}"{% if not hasSurcharge %} class="d-none"{% endif %}>
        <div class="row mt-2">
            <label for="commission-{{ origin.id }}" class="col-sm-4 col-form-label">{{ 'reservationorigin.commission_percent'|trans }}</label>

            <div class="col-sm-8">
                <div class="input-group">
                    <input type="number" step="0.01" min="0" max="100" class="form-control" id="commission-{{ origin.id }}"
                           name="commission-{{ origin.id }}" value="{{ origin.commissionPercent }}">
                    <span class="input-group-text">%</span>
                </div>
            </div>
        </div>
        <div class="row mt-2">
            <label for="payment-fee-{{ origin.id }}" class="col-sm-4 col-form-label">{{ 'reservationorigin.payment_fee_percent'|trans }}</label>

            <div class="col-sm-8">
                <div class="input-group">
                    <input type="number" step="0.01" min="0" max="100" class="form-control" id="payment-fee-{{ origin.id }}"
                           name="payment-fee-{{ origin.id }}" value="{{ origin.paymentFeePercent }}">
                    <span class="input-group-text">%</span>
                </div>
            </div>
        </div>
    </div>
</fieldset>

<input name="_csrf_token" value="{{ token }}" type="hidden">