{# The guest list of the overview; reloaded on its own by customers_controller.js when searching or paging #}
{% set total = customers.count %}
{% if total == 0 %}
    <twig:EmptyState icon="users" :title="'customer.list.empty'|trans">
        {{- 'customer.list.empty.hint'|trans -}}
    </twig:EmptyState>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover align-middle data-table data-table-stack">
            <thead>
            <tr>
                <th class="data-table-id">ID</th>
                <th>{{ 'customer.list.name'|trans }}</th>
                <th>{{ 'customer.company'|trans }}</th>
                <th>{{ 'customer.city'|trans }}</th>
                <th class="text-end">{{ 'customer.list.bookings.header'|trans }}</th>
                <th class="data-table-actions"><span class="visually-hidden">{{ 'customer.action'|trans }}</span></th>
            </tr>
            </thead>
            <tbody>
            {% for customer in customers %}
                {% if customer.id != 0 %}
                    {% set companies = customer.customerAddresses|map(address => address.company)|filter(value => value is not empty) %}
                    {% set cities = customer.customerAddresses|map(address => address.city)|filter(value => value is not empty) %}
                    {% set bookings = customer.bookedReservations|length %}
                    <tr>
                        <td class="cell-meta data-table-id"><span class="cell-narrow">ID </span>{{ customer.id }}</td>
                        <td>
                            <a href="#" class="data-table-link"
                               data-action="click->customers#openModalAction"
                               data-url="{{ path('customers.get.customer', {'id': customer.id }) }}"
                               data-title="{{ 'customer.details'|trans }}"
                               data-bs-toggle="modal" data-bs-target="#modalCenter"
                               title="{{ 'button.details'|trans }}">
                                <twig:Avatar :initials="customer.firstname|first ~ customer.lastname|first"/>
                                <span class="data-table-link-text">
                                    {{- customer.lastname }}{% if customer.firstname is not empty %}, {{ customer.firstname }}{% endif -%}
                                </span>
                            </a>
                        </td>
                        <td class="cell-meta">{{- companies|join(', ') -}}</td>
                        <td class="cell-meta">{{- cities|join(', ') -}}</td>
                        <td class="cell-meta text-end">
                            <span class="cell-wide">{{ bookings }}</span>
                            <span class="cell-narrow">{{ 'customer.list.bookings'|trans({'%count%': bookings}) }}</span>
                        </td>
                        <td class="cell-actions data-table-actions text-end">
                            <twig:IconButton icon="pen" :label="'button.edit'|trans"
                                             data-action="click->customers#openModalAction"
                                             data-url="{{ path('customers.edit.customer.show', {'id': customer.id}) }}"
                                             data-title="{{ 'customer.details'|trans }}"
                                             data-bs-toggle="modal" data-bs-target="#modalCenter"/>
                            <twig:IconButton icon="balance-scale-left" :label="'button.gdpr'|trans"
                                             :href="path('customers.gdpr.customer', {'id': customer.id})"/>
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
<div class="data-footer">
    <span>{{ 'customer.list.count'|trans({'%count%': total}) }}</span>
    <input id="page" type="hidden" name="page" value="{{ page }}" data-customers-target="page" />
    {% include 'paginator.html.twig' with { 'url' : path('customers.overview'), 'pagination_action': 'click->customers#paginateAction', 'swipe_nav': true } %}
</div>
