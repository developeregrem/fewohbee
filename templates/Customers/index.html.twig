{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - {{ 'nav.customers'|trans }}{% endblock %}

{% block description %}{{ parent() }} - {{ 'nav.customers'|trans }}{% endblock %}

{% block page_title %}{{ 'nav.customers'|trans }}{% endblock %}

{% block content %}
    <div class="container fab-add-clearance"
         data-controller="customers"
         data-customers-search-url-value="{{ path('customers.search') }}">
        <header class="page-header">
            <div class="page-header-text">
                <h1 class="page-title">{{ 'nav.customers'|trans }}</h1>
            </div>
            <div class="page-actions fab-add-inline">
                <button type="button" class="btn btn-primary"
                        data-action="click->customers#openModalAction"
                        data-url="{{ path('customers.new.customer') }}"
                        data-title="{{ 'nav.customer.add'|trans }}"
                        data-bs-toggle="modal" data-bs-target="#modalCenter">
                    <i class="fas fa-plus me-1"></i> {{ 'nav.customer.add'|trans }}
                </button>
            </div>
        </header>

        <div class="card data-card">
            <div class="data-toolbar">
                <form class="search-field" id="customers-search-form" role="search"
                      data-customers-target="searchForm"
                      data-action="submit->customers#searchAction">
                    <span class="search-field-icon"><i class="fas fa-search"></i></span>
                    <input type="search" class="form-control" id="search" name="search"
                           data-customers-target="searchInput"
                           data-action="input->customers#searchInputAction"
                           placeholder="{{ 'customer.search.placeholder'|trans }}"
                           aria-label="{{ 'customer.search.placeholder'|trans }}" value="{{ search }}"/>
                </form>
            </div>
            <div id="customers-table" data-customers-target="table">
                {% include 'Customers/customer_table.html.twig' %}
            </div>
        </div>

        {# Touch screens: the add button floats above the list, see "Add button on touch screens" in app.css #}
        <button type="button" class="btn fab-add"
                data-action="click->customers#openModalAction"
                data-url="{{ path('customers.new.customer') }}"
                data-title="{{ 'nav.customer.add'|trans }}"
                data-bs-toggle="modal" data-bs-target="#modalCenter"
                title="{{ 'nav.customer.add'|trans }}" aria-label="{{ 'nav.customer.add'|trans }}">
            <i class="fas fa-plus"></i>
        </button>
    </div>
{% endblock %}
