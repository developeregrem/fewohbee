{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - {{ 'nav.customers'|trans }}{% endblock %}

{% block description %}{{ parent() }} - {{ 'nav.customers'|trans }}{% endblock %}

{% block page_title %}{{ 'nav.customers'|trans }}{% endblock %}

{% block content %}
    <div class="container fab-add-clearance"
         data-controller="customers"
         data-customers-search-url-value="{{ path('customers.search') }}">
        <twig:PageHeader :title="'nav.customers'|trans">
            <twig:AddButton :label="'nav.customer.add'|trans"
                            data-action="click->customers#openModalAction"
                            data-url="{{ path('customers.new.customer') }}"
                            data-title="{{ 'nav.customer.add'|trans }}"
                            data-bs-toggle="modal" data-bs-target="#modalCenter"/>
        </twig:PageHeader>

        <twig:DataCard>
            <twig:block name="toolbar">
                <twig:SearchField :placeholder="'customer.search.placeholder'|trans" :value="search"
                                  id="customers-search-form"
                                  data-customers-target="searchForm"
                                  data-action="submit->customers#searchAction"
                                  input:id="search"
                                  input:data-customers-target="searchInput"
                                  input:data-action="input->customers#searchInputAction"/>
            </twig:block>
            <div id="customers-table" data-customers-target="table">
                {% include 'Customers/customer_table.html.twig' %}
            </div>
        </twig:DataCard>
    </div>
{% endblock %}
