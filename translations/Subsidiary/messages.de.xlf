<?xml version="1.0" encoding="UTF-8" ?>
<xliff xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 http://docs.oasis-open.org/xliff/v1.2/os/xliff-core-1.2-strict.xsd" xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file original="file.ext" datatype="plaintext" source-language="de" target-language="de">
        <body>
            <trans-unit id="object.title">
                <source>object.title</source>
                <target>Niederlassungsverwaltung</target>
            </trans-unit>
            <trans-unit id="object.description">
                <source>object.description</source>
                <target>Beschreibung</target>
            </trans-unit>
            <trans-unit id="object.name">
                <source>object.name</source>
                <target>Niederlassung</target>
            </trans-unit>
            <trans-unit id="object.action">
                <source>object.action</source>
                <target>Aktionen</target>
            </trans-unit>
            <trans-unit id="object.delete.ask">
                <source>object.delete.ask</source>
                <target>Diese Niederlassung wirklich löschen?</target>
            </trans-unit>
            <trans-unit id="object.flash.delete.success">
                <source>object.flash.delete.success</source>
                <target>Niederlassung wurde erfolgreich gelöscht.</target>
            </trans-unit>
            <trans-unit id="object.flash.create.success">
                <source>object.flash.create.success</source>
                <target>Niederlassung wurde erfolgreich angelegt.</target>
            </trans-unit>
            <trans-unit id="object.flash.edit.success">
                <source>object.flash.edit.success</source>
                <target>Niederlassung wurde erfolgreich bearbeitet.</target>
            </trans-unit>
            <trans-unit id="object.flash.delete.error.still.in.use">
                <source>object.flash.delete.error.still.in.use</source>
                <target>Niederlassung kann nicht gelöscht werden, da ihr noch Zimmer zugeordnet sind.</target>
            </trans-unit>
            <trans-unit id="object.invoice_number_pattern">
                <source>object.invoice_number_pattern</source>
                <target>Eigener Rechnungsnummern-Kreis</target>
            </trans-unit>
            <trans-unit id="object.invoice_number_pattern.placeholder">
                <source>object.invoice_number_pattern.placeholder</source>
                <target>z.B. RE-&lt;year&gt;-&lt;number:4&gt;</target>
            </trans-unit>
            <trans-unit id="object.invoice_number_pattern.help">
                <source>object.invoice_number_pattern.help</source>
                <target>Leer lassen, um den Standard-Nummernkreis aus den Einstellungen zu verwenden. Platzhalter: &lt;code&gt;&amp;lt;year&amp;gt;&lt;/code&gt;, &lt;code&gt;&amp;lt;year2&amp;gt;&lt;/code&gt;, &lt;code&gt;&amp;lt;month&amp;gt;&lt;/code&gt;, &lt;code&gt;&amp;lt;day&amp;gt;&lt;/code&gt;, &lt;code&gt;&amp;lt;number:4&amp;gt;&lt;/code&gt;. Rechnungen zu Zimmern dieser Niederlassung bekommen dann eine eigene, fortlaufende Nummer.</target>
            </trans-unit>
            <trans-unit id="object.flash.invoice_number_pattern.invalid">
                <source>object.flash.invoice_number_pattern.invalid</source>
                <target>Der Rechnungsnummern-Kreis ist ungültig. Er braucht genau einen &lt;number&gt;-Platzhalter und darf nur bekannte Platzhalter verwenden.</target>
            </trans-unit>
            <trans-unit id="object.opening_hours">
                <source>object.opening_hours</source>
                <target>Öffnungszeiten</target>
            </trans-unit>
            <trans-unit id="object.opening_hours.help">
                <source>object.opening_hours.help</source>
                <target>Leer lassen bedeutet geschlossen. Die Zeiten lassen sich in Vorlagen für Briefe und E-Mails über den Baustein „Öffnungszeiten der Niederlassung" einfügen und über die REST-API abrufen.</target>
            </trans-unit>
            <trans-unit id="object.weekday.1">
                <source>object.weekday.1</source>
                <target>Montag</target>
            </trans-unit>
            <trans-unit id="object.weekday.2">
                <source>object.weekday.2</source>
                <target>Dienstag</target>
            </trans-unit>
            <trans-unit id="object.weekday.3">
                <source>object.weekday.3</source>
                <target>Mittwoch</target>
            </trans-unit>
            <trans-unit id="object.weekday.4">
                <source>object.weekday.4</source>
                <target>Donnerstag</target>
            </trans-unit>
            <trans-unit id="object.weekday.5">
                <source>object.weekday.5</source>
                <target>Freitag</target>
            </trans-unit>
            <trans-unit id="object.weekday.6">
                <source>object.weekday.6</source>
                <target>Samstag</target>
            </trans-unit>
            <trans-unit id="object.weekday.7">
                <source>object.weekday.7</source>
                <target>Sonntag</target>
            </trans-unit>
            <trans-unit id="object.opening_hours.period.1">
                <source>object.opening_hours.period.1</source>
                <target>Zeitraum 1</target>
            </trans-unit>
            <trans-unit id="object.opening_hours.period.2">
                <source>object.opening_hours.period.2</source>
                <target>Zeitraum 2</target>
            </trans-unit>
            <trans-unit id="object.opening_hours.from">
                <source>object.opening_hours.from</source>
                <target>von</target>
            </trans-unit>
            <trans-unit id="object.opening_hours.to">
                <source>object.opening_hours.to</source>
                <target>bis</target>
            </trans-unit>
            <trans-unit id="object.flash.opening_hours.incomplete">
                <source>object.flash.opening_hours.incomplete</source>
                <target>Bei den Öffnungszeiten ist ein Zeitfenster nur halb ausgefüllt. Bitte „von" und „bis" angeben oder beide Felder leeren.</target>
            </trans-unit>
            <trans-unit id="object.opening_hours_note">
                <source>object.opening_hours_note</source>
                <target>Hinweis zu den Öffnungszeiten</target>
            </trans-unit>
            <trans-unit id="object.opening_hours_note.placeholder">
                <source>object.opening_hours_note.placeholder</source>
                <target>z. B. Außerhalb dieser Zeiten nach Vereinbarung, Tel. 0123 456</target>
            </trans-unit>
            <trans-unit id="object.opening_hours_note.help">
                <source>object.opening_hours_note.help</source>
                <target>Freier Text, der zusammen mit den Zeiten ausgegeben wird — für alles, was ein Wochenraster nicht abbildet.</target>
            </trans-unit>
            <trans-unit id="object.check_in">
                <source>object.check_in</source>
                <target>Check-in und Check-out</target>
            </trans-unit>
            <trans-unit id="object.check_in.help">
                <source>object.check_in.help</source>
                <target>Hausregeln für An- und Abreise. Sie können mit dem Baustein „Check-in-Zeiten des Betriebs“ in Brief- und E-Mail-Vorlagen eingefügt und über die REST-API abgerufen werden. Leer lassen, wenn nichts veröffentlicht wird.</target>
            </trans-unit>
            <trans-unit id="object.check_in.window">
                <source>object.check_in.window</source>
                <target>Check-in</target>
            </trans-unit>
            <trans-unit id="object.check_in.window.help">
                <source>object.check_in.window.help</source>
                <target>Das zweite Feld ist die Obergrenze. Leer lassen, wenn die Anreise auch später möglich ist.</target>
            </trans-unit>
            <trans-unit id="object.check_in.from">
                <source>object.check_in.from</source>
                <target>Check-in ab</target>
            </trans-unit>
            <trans-unit id="object.check_in.until">
                <source>object.check_in.until</source>
                <target>Check-in bis</target>
            </trans-unit>
            <trans-unit id="object.check_out.until">
                <source>object.check_out.until</source>
                <target>Check-out bis</target>
            </trans-unit>
            <trans-unit id="object.check_in_note">
                <source>object.check_in_note</source>
                <target>Hinweis zum Check-in</target>
            </trans-unit>
            <trans-unit id="object.check_in_note.help">
                <source>object.check_in_note.help</source>
                <target>Freier Text, der zusammen mit den Zeiten ausgegeben wird — für alles, was zwei Uhrzeiten nicht abbilden.</target>
            </trans-unit>
            <trans-unit id="object.check_in_note.placeholder">
                <source>object.check_in_note.placeholder</source>
                <target>z. B. Spätere Anreise nach telefonischer Absprache</target>
            </trans-unit>
            <trans-unit id="object.check_in.value.from">
                <source>object.check_in.value.from</source>
                <target>Check-in ab %from% Uhr</target>
            </trans-unit>
            <trans-unit id="object.check_in.value.window">
                <source>object.check_in.value.window</source>
                <target>Check-in %from%–%until% Uhr</target>
            </trans-unit>
            <trans-unit id="object.check_out.value">
                <source>object.check_out.value</source>
                <target>Check-out bis %until% Uhr</target>
            </trans-unit>
            <trans-unit id="object.flash.check_in_window.invalid">
                <source>object.flash.check_in_window.invalid</source>
                <target>Das Check-in-Fenster ist ungültig. Bitte eine Startzeit angeben, die vor der Endzeit liegt — oder das zweite Feld leer lassen.</target>
            </trans-unit>
        </body>
    </file>
</xliff>